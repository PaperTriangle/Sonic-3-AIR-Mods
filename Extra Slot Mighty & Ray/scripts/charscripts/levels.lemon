function bool ExtraChar.LevelManager.EnableCustomLevels(u8 extrachar)
{
	if (extrachar == 4)
		extrachar = 1
	return base.ExtraChar.LevelManager.EnableCustomLevels(extrachar)
}

// Here so that the chunks load in properly when you first go from act 1 to act 2 of LRZ
//# address-hook(0x078ae6) end(0x078afa)
function void fn078ae6()
{
	if (global.xtrachar != 0x04)
	{
		base.fn078ae6()
		return
	}
	Mighty_Partner = 1
	Ray_Partner = 3
	global.xtrachar = 1
	base.fn078ae6()
	Mighty_Partner = 0
	Ray_Partner = 0
	global.xtrachar = 4
}

function void ExtraChar.LevelManager.LoadCustomChunks(u8 extrachar, u16 zoneAndAct)
{
	if (extrachar == 4)
		extrachar = 1
	base.ExtraChar.LevelManager.LoadCustomChunks(extrachar, zoneAndAct)
}

function u32 ExtraChar.LevelManager.loadRawLevelData(string format, u16 zoneAndAct, u32 targetAddress)
{
	if (global.xtrachar != 0x04)
	{
		return base.ExtraChar.LevelManager.loadRawLevelData(format, zoneAndAct, targetAddress)
	}
	Mighty_Partner = 1
	Ray_Partner = 3
	global.xtrachar = 1
	u64 returnVal = base.ExtraChar.LevelManager.loadRawLevelData(format, zoneAndAct, targetAddress)
	Mighty_Partner = 0
	Ray_Partner = 0
	global.xtrachar = 4
	
	return returnVal
}

function u32 Game.getSetting(u32 settingId)
