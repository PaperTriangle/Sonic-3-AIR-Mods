//Palette selection for Mighty
//SET THE PALETTE -- REGULAR GAME HAS ITS OWN ENTRY
function string getCharacterPaletteKey(u8 character)
{
	if (global.xtrachar != 0x04)
	{
		return base.getCharacterPaletteKey(character)
	}
	Mighty_Partner = 1
	Ray_Partner = 3
	global.xtrachar = 1
	u64 returnVal = base.getCharacterPaletteKey(character)
	Mighty_Partner = 0
	Ray_Partner = 0
	global.xtrachar = 4
	
	return returnVal
}

