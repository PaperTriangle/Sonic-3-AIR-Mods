// I don't know where to put this, so it goes here
// whens global.xtrachar for p2? /j
// ~ Lemons
function bool isRayPartner()
{
	// going for readability here, sorry readability haters!
	if (global.xtrachar == 4) || (global.xtrachar == 1)
		return true
	
	return base.isRayPartner()
}

global bool esmr.fangfight
global u8 esmr.fangmusic

function bool FangBoss.FightFangTheSniper()
{
	if esmr.fangfight
		return (global.xtrachar == 4) || (global.xtrachar == 1) || (global.xtrachar == 2)
			
	return FangBoss.FightFangTheSniper()
}

function u64 Standalone.getModdedSoundKey(u64 soundKey, u8 sfxId, u8 soundRegType)
{
	if (esmr.fangmusic)
	{
		bool elfangonscreen = false
		for (u32 address = 0xffffb094; address < 0xffffcfcb; address += 0x4a)
		{
			if (u32[address] == 0x32ac40)
			{
				elfangonscreen = true
				break
			}
		}
		
		if sfxId == MUSIC_MINIBOSS_2 && (elfangonscreen)
		{
			return esmr.fangmusic == 2 ? "fangbossthemesong_s" : "fangbossthemesong_l"
		}
	}
	return base.Standalone.getModdedSoundKey(soundKey, sfxId, soundRegType)
}

// Fixes due to slot 4.
function bool SDMD.canSmash(u32 AX)
{
	return (global.xtrachar == 4 && u8[AX + 0x0d] & 0x02) || base.SDMD.canSmash(AX)
}

function void ExtraChar.startup_char4()
{
	Mighty_Partner = 1
	Ray_Partner = 3
	global.xtrachar = 1
	ExtraChar.startup_char1()
	Mighty_Partner = 0
	Ray_Partner = 0
	global.xtrachar = 4
	
}

function u64 getCharacterBonusTextIcon(u8 character)
{
	if (global.xtrachar != 0x04)
	{
		return base.getCharacterBonusTextIcon(character)
	}
	Mighty_Partner = 1
	Ray_Partner = 3
	global.xtrachar = 1
	u64 returnVal = base.getCharacterBonusTextIcon(character)
	Mighty_Partner = 0
	Ray_Partner = 0
	global.xtrachar = 4
	
	return returnVal
}

function u64 ExtraChar.getIconSpriteKey_char4(u8 type)
{
	return ExtraChar.getIconSpriteKey_char1(type)
}

