function string getESCharacterFallSpriteKey(u8 character, u8 extrachar)
{
	if (global.xtrachar != 0x04)
	{
		return base.getESCharacterFallSpriteKey(character, extrachar)
	}
	Mighty_Partner = 1
	Ray_Partner = 3
	global.xtrachar = 1
	u64 returnVal = base.getESCharacterFallSpriteKey(character, 1)
	Mighty_Partner = 0
	Ray_Partner = 0
	global.xtrachar = 4
	
	return returnVal
}