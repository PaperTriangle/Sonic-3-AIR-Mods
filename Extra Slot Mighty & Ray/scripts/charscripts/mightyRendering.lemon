
function void ExtraChar.drawCharacterSprite_char4()
{
	ExtraChar.drawCharacterSprite_char1()
}

function bool Character_ESU_Err(u64 key, s16 px, s16 py, u8 flag, u16 renderQueue, u8 id)
{
	if (global.xtrachar != 0x04)
	{
		return base.Character_ESU_Err(key, px, py, flag, renderQueue, id)
	}
	Mighty_Partner = 1
	Ray_Partner = 3
	global.xtrachar = 1
	u64 returnVal = base.Character_ESU_Err(key, px, py, flag, renderQueue, id)
	Mighty_Partner = 0
	Ray_Partner = 0
	global.xtrachar = 4
	
	return returnVal
}

function void loadCharacterPalette(u8 character, u32 targetAddress, u8 paletteVariant)
{
	if (global.xtrachar != 0x04)
	{
		base.loadCharacterPalette(character, targetAddress, paletteVariant)
		return
	}
	Mighty_Partner = 1
	Ray_Partner = 3
	global.xtrachar = 1
	base.loadCharacterPalette(character, targetAddress, paletteVariant)
	Mighty_Partner = 0
	Ray_Partner = 0
	global.xtrachar = 4
}

