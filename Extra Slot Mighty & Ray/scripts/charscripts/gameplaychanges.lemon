
function void ExtraChar.Menu.actselect.updateControl()
{
	if (global.xtrachar != 0x04)
	{
		base.ExtraChar.Menu.actselect.updateControl()
		return
	}
	Mighty_Partner = 1
	Ray_Partner = 3
	global.xtrachar = 1
	base.ExtraChar.Menu.actselect.updateControl()
	Mighty_Partner = 0
	Ray_Partner = 0
	global.xtrachar = 4
}

