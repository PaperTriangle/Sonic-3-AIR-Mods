global bool sff.green_eyes
global bool sff.behind_tiles
global bool sff.super_sonic_palette
global bool sff.super_stars

// Render the new sprites
function bool Standalone.onWriteToSpriteTable(s16 px, s16 py, u16 renderQueue)
{
	bool prioFlag = sff.behind_tiles ? (u16[0xffffb000 + 0x0a] & sprite_attribute.PRIORITY) == sprite_attribute.PRIORITY : true
	
    if(objA0.update_address == 0x01a1f4 && global.characters == CHARS_TAILS_ALONE) 
    {
        u64 key = stringformat(sff.green_eyes ? "green_super_flicky_%d" : "super_flicky_%d", objA0.animation.sprite)
       	u8 atex = 0x40 + 0x20 * CHARACTER_SONIC
        if(Renderer.hasCustomSprite(key))
        {
            Renderer.drawCustomSprite(key, px, py, atex, objA0.render_flags | (prioFlag ? SPRITE_FLAG_PRIO : 0), renderQueue)
            return true
        }
    }
	else if(objA0.update_address == 0x01a276 && global.characters == CHARS_TAILS_ALONE) 
    {
        u64 key = stringformat("super_flicky_%d", objA0.animation.sprite)
       	u8 atex = 0x40 + 0x20 * CHARACTER_SONIC
        if(Renderer.hasCustomSprite(key))
        {
            Renderer.drawCustomSprite(key, px, py, atex, objA0.render_flags | (prioFlag ? SPRITE_FLAG_PRIO : 0), renderQueue)
            return true
        }
    }
 
    return base.Standalone.onWriteToSpriteTable(px, py, renderQueue)
}

global s8 superflicky.palettefx.timer
global u16 superflicky.palettefx.frame
global u8 superflicky.palettefx.state

// Use Sonic's extended palette to blend (incase someone is using more pixels in Tails' palette)
function void UpdatePaletteEffects.SuperForm.blendFlicky(u32 source1, u32 source2, u16 blendFactor, bool underwater)
{
	if (sff.super_sonic_palette)
	{
		bool isSuperPaletteModded = System.hasExternalPaletteData(getCharacterPaletteKey(CHARACTER_SONIC), 5)		// Check line index 5, for Super/Hyper form palette
		
		if (super.palettefx.state == 2 && superflicky.palettefx.state != 2)
		{
			superflicky.palettefx.state = 2
			superflicky.palettefx.frame = 30
		}
		
		if (isSuperPaletteModded)
		{
			moddedFlickyPalette()			
		}
		else
		{
			u16 offset = CHARACTER_SONIC * 0x40 + (underwater ? 0x300 : 0)
			for (u8 k = 0; k < 6; k += 2)
			{
				u16[0x802004 + offset + k] = blendColorsPacked(u16[source1 + k], u16[source2 + k], blendFactor)
			}
		}
		
	}
	else
	{
		u16 offset = CHARACTER_SONIC * 0x40 + (underwater ? 0x300 : 0)
		for (u8 k = 0; k < 6; k += 2)
		{
			u16[0x802004 + offset + k] = blendColorsPacked(u16[source1 + k], u16[source2 + k], blendFactor)
		}
	}
}

function void moddedFlickyPalette()
{
	if (superflicky.palettefx.state & 0x80)
	{
		// Update ongoing palette effect
		u16 nextFrame = (superflicky.palettefx.frame + 6) % 18
		u16 blendFactor = superflicky.palettefx.timer * 0x100 / 0x0f
		if (nextFrame % 18 == 0)
			blendFactor = 0x100 - blendFactor
		else if (nextFrame % 18 == 12)
			blendFactor = 0

		for (u8 underwater = 0; underwater < (level.water_present ? 2 : 1); ++underwater)
		{
			u32 offset = CHARACTER_SONIC * 0x40 + (underwater ? 0x300 : 0)
			u32 source = 0x802180 + offset
			u32 dest   = 0x802000 + offset

			// Load modded Super palette
			u8 line = getModdedPaletteLine(CHARACTER_SONIC, false, underwater)

			zeroMemory(dest, 0x40)
			u16 numColors = System.loadExternalPaletteData(getCharacterPaletteKey(CHARACTER_SONIC), line, 0x800000, 0x20)
			for (u16 i = 0; i < numColors; ++i)
			{
				u32 rgba = u32[0x800000 + i * 4]
				u16[dest + i * 2] = (rgba & 0xff000000) ? packColorExt(rgba) : 0
			}

			for (u8 k = 0; k < 0x40; k += 2)
			{
				if (u16[dest + k] == 0)
				{
					// Use original color as fallback
					u16[dest + k] = u16[source + k]
				}
				else
				{
					// Apply flash effect
					u16[dest + k] = blendColorsPacked(u16[dest + k], 0x0eee, blendFactor)
				}
			}
		}

		--superflicky.palettefx.timer
		if (superflicky.palettefx.timer < 0)
		{
			superflicky.palettefx.timer = 0x0f
			superflicky.palettefx.frame = nextFrame
		}
	}
	else if (superflicky.palettefx.state == 1)
	{
		// Sonic
		//  -> Fading #contributed by iCloudius
		// Fade in effect
		superflicky.palettefx.frame += 6
		superflicky.palettefx.timer = 1

		for (u8 underwater = 0; underwater < (level.water_present ? 2 : 1); ++underwater)
		{
			u16 blendFactor = clamp((superflicky.palettefx.frame + (1 - superflicky.palettefx.timer) * 6 / 2) * 0x100 / 0x24, 0, 0x100)
		
			u32 offset = CHARACTER_SONIC * 0x40 + (underwater ? 0x300 : 0)
			u32 source = 0x802180 + offset
			u32 dest   = 0x802000 + offset
		
			// Load modded Super palette
			u8 line = getModdedPaletteLine(CHARACTER_SONIC, false, underwater)
		
			zeroMemory(dest, 0x40)
			u16 numColors = System.loadExternalPaletteData(getCharacterPaletteKey(CHARACTER_SONIC), line, 0x800000, 0x20)
			for (u16 i = 0; i < numColors; ++i)
			{
				u32 rgba = u32[0x800000 + i * 4]
				u16[dest + i * 2] = (rgba & 0xff000000) ? packColorExt(rgba) : 0
			}
		
			for (u8 k = 0; k < 0x40; k += 2)
			{
				if (u16[dest + k] == 0)
				{
					// Use original color as fallback
					u16[dest + k] = u16[source + k]
				}
				else
				{
					// Apply flash effect
					u16[dest + k] = blendColorsPacked(u16[source + k], u16[dest + k], blendFactor)
				}
			}
		}


		if (superflicky.palettefx.frame < 36)
			return

		// Fully faded in
		superflicky.palettefx.state = 0xff
		//u8[0xffffb000 + 0x2e] = 0		// Reset "char.control_flags"
	}
	else
	{
		// Fade out
		if (superflicky.palettefx.frame >= 30)
		{
			// This is the first frame, set everything so that only the timer is used
			superflicky.palettefx.frame = 0
			superflicky.palettefx.timer = 0x11
		}

		u16 blendFactor = clamp(u16(superflicky.palettefx.timer) * 0x100 / 0x12, 0, 0x100)
		for (u8 underwater = 0; underwater < (level.water_present ? 2 : 1); ++underwater)
		{
			u32 offset = CHARACTER_SONIC * 0x40 + (underwater ? 0x300 : 0)
			u32 source = 0x802180 + offset
			u32 dest   = 0x802000 + offset

			for (u8 k = 0; k < 0x40; k += 2)
			{
				if (u16[dest + k] == 0)
				{
					// Use original color as fallback
					u16[dest + k] = u16[source + k]
				}
				else
				{
					// Apply flash effect
					u16[dest + k] = blendColorsPacked(u16[source + k], u16[dest + k], blendFactor)
				}
			}
		}
		
		if (superflicky.palettefx.timer == 0)
		{
			// Fully faded out
			superflicky.palettefx.state = 0
		}
		else
		{
			--superflicky.palettefx.timer
		}
	}
}

function void UpdatePaletteEffects.SuperForm.applyGeneral(u8 characterVersion, u32 source)
{
	if (characterVersion == 0xff)
		characterVersion = 1
		
	base.UpdatePaletteEffects.SuperForm.applyGeneral(characterVersion, source)
}


// Make Palette rotation slower for OG Super Tails with Classic Hyper Trails compat
//# address-hook(0x003750) end(0x00398c)
function void UpdatePaletteEffects.SuperForm()
{
	u8 backupSuper = super.active.tails
	if (sff.super_stars && Mods.isModActive("Classic Hyper Trails"))
	{
		if (super.active.tails == 0xff && !Game.getSetting(SETTING_HYPER_TAILS))
		{
			super.active.tails = 0x01
		}
	}
	
	base.UpdatePaletteEffects.SuperForm()

	if (backupSuper != super.active.tails)
	{
		super.active.tails = backupSuper		
	}
}

// Make Super Flicky Palette still work with Classic Hyper Trails compat
function void UpdatePaletteEffects.SuperForm.moddingVersion(u8 characterVersion)
{
	base.UpdatePaletteEffects.SuperForm.moddingVersion(characterVersion)
	
	if (sff.super_stars && Mods.isModActive("Classic Hyper Trails") && super.active.tails == 0x01 && !Game.getSetting(SETTING_HYPER_TAILS))
		if (super.palettefx.state & 0x80)
			if (characterVersion == 2)
			{
				UpdatePaletteEffects.UpdateSuperSonic.Smoothed(0xff)
				return
			}
}

// Super Tails Stars

function bool Character.performSuperTransformation()
{
	bool transformResult = base.Character.performSuperTransformation()
	
	if (sff.super_stars && super.active.tails == 1)
		u32[0xffffcbc0] = 0x019156

	return transformResult
}

//# address-hook(0x0191a4) end(0x019230)
function void fn0191a4()
{
	if (!isMainCharacter(CHARACTER_TAILS))
	{
		base.fn0191a4()
		return
	}
	
	if (super.active.tails == 0 || (super.active.tails == 0xff && Game.getSetting(SETTING_HYPER_TAILS)))
	{
		UnloadObject()
		return
	}
	
	u8 backupSuper = super.active
	super.active = super.active.tails

	base.fn0191a4()

	super.active = backupSuper
}

// Hyper Tails Stars

// Used to prevent duplicate stars from debug monitors
global bool alreadyHasStars

//# address-hook(0x01a170) end(0x01a198)
function void fn01a170()
{
	superflicky.palettefx.state = 1
	superflicky.palettefx.timer = 0
	superflicky.palettefx.frame = 0
	
	if (sff.super_stars && !alreadyHasStars && global.zone_act != 0x0d01)
	{
		if (Mods.isModActive("Classic Hyper Trails") && !Game.getSetting(SETTING_HYPER_TAILS))
		{
			u32[0xffffcbc0] = 0x019156
		}
		else
		{
			Kosinski.addToDMAQueue(0x14c652, Shield.targetInVRAM)
			
			if (allocHyperStarObject())
			{
				for (u8 i = 0; i < 4; ++i)
				{
					objA1.update_address = 0x01937c
					u8[A1 + 0x26] = i * 0x40
					u8[A1 + 0x24] = i + 1
					A1 += 0x4a
				}
				
				alreadyHasStars = true
				fn01937c()
			}
		}
	}
	else
	{
		Kosinski.addToDMAQueue(0x14c7d4, Char.Player1.targetInVRAM)
	}

	A1 = 0xffffcd7c
	for (u16 k = 0; k < 4; ++k)
	{
		objA1.update_address = 0x01a19c
		u8[A1 + 0x34] = k * 0x40
		A1 += 0x4a
	}

	fn01a19c()
}

// Function checks for four blank object spots in a row. Prevents spawning less that four stars if capacity is hit.
// This could be done smarter probably... But I am lazy and it is pretty unlikely this situation would happen in normal gameplay.
function bool allocHyperStarObject()
{
	A1 = 0xffffb0de
	D0.s16 = 0x59 - 0x03 // Smaller object pool since we are writing four objects.
	while (D0.s16 >= 0)
	{
		A1 += 0x4a
		if (u32[A1] == 0 && u32[A1 + 0x4a] == 0 && u32[A1 + 0x4a*2] == 0 && u32[A1 + 0x4a*3] == 0)
		{
			// Found a free place
			_setZeroFlagByValue(0)
			return true
		}
		--D0.s16
	}

	// Failed
	_setZeroFlagByValue(1)
	return false
}

//# address-hook(0x0193ec) end(0x019486)
function void fn0193ec()
{
	if (!isMainCharacter(CHARACTER_TAILS))
	{
		base.fn0193ec()
		return
	}
	
	if (super.active.tails)
	{
		--objA0.animation.timer
		if (s8(objA0.animation.timer) < 0)
		{
			objA0.animation.timer = 1
			++objA0.animation.sprite
			if (objA0.animation.sprite >= 3)
			{
				objA0.animation.sprite = 0
				u16[A0 + 0x30] = 0
				u16[A0 + 0x34] = 0
			}
		}

		D0.u8 = objA0.value26
		objA0.value26 -= 0x10
		LookupSinCos()
		D0.s16 <<= 3
		D1.s16 <<= 3
		objA0.velocity.x = D0.u16
		objA0.velocity.y = D1.u16
		u16[A0 + 0x30] += objA0.velocity.x
		u16[A0 + 0x34] += objA0.velocity.y

		D2.s16 = s8[A0 + 0x30]
		if (u8[0xffffb000 + 0x2a] & char.flag.FACING_LEFT)
			D2.s16 = -D2.s16
		objA0.position.x.u16 = u16[0xffffb000 + 0x10] + D2.s16
		objA0.position.y.u16 = u16[0xffffb000 + 0x14] + s8[A0 + 0x34]
		objA0.sprite_attributes = (objA0.sprite_attributes & ~sprite_attribute.PRIORITY) | (u16[0xffffb000 + 0x0a] & sprite_attribute.PRIORITY)

	#if STANDALONE
		// Do not render stars if Sonic is outside the screen (e.g. MGZ 2 boss)
		if (u8[0xffffb000 + 0x04] & render_flag.VISIBLE)
	#endif
		{
			//System.writeDisplayLine(stringformat("Values: 0x%08x", A0))
			DrawObject()
		}
	}
	else
	{
		alreadyHasStars = false
		UnloadObject()
	}
}

function void yieldExecution()
{
	base.yieldExecution()

	if (sff.super_stars && alreadyHasStars && isMainCharacter(CHARACTER_TAILS) && super.active.tails != 0xff)
		alreadyHasStars = false
}
