// HCZ Act Transition
//# address-hook(0x06a270) end(0x06a298)
function void fn06a270()
{
	if ac.hcz && (level.results_done)
	{
		ac.no_pause = 1
		ac.no_hud = 1
	}

	base.fn06a270()
}

//# address-hook(0x06a872) end(0x06a8c0)
function void fn06a872()
{
	if (!ac.prevent || !ac.hcz)
	{
		base.fn06a872()
		return
	}

	fn06a916()
	UpdateMovementStraightSimple()

	A1 = 0xffff0000 + u16[A0 + 0x44]
	objA1.position.x.u16 = objA0.position.x.u16
	D0.u16 = objA0.position.y.u16
	objA1.position.y.u16 = D0.u16
	if (D0.u16 < 0x0828)
		return

#if STANDALONE
	Game.endSkippableCutscene()
#endif

	ac.no_pause = 0

	if (objA0.subtype2c != 0)
	{
		A1 = 0xffffb04a
		if (u32[A1] != 0)
		{
			StopCharacterWinPose()
		}
	}
	else
	{
		stopCharacterWinPose(0xffffb000)
		screenmover_target.top = 0
		fn085de0()
	}
	UnloadObject()
}

// HCZ Knuckles
