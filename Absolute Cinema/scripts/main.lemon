function void fn062194()
{
	if (u16[0xffffb000 + 0x10] >= 0x3990 && u8[0xffffb000 + 0x2e] == 0 && u8[0xffffb000 + 0x2a] & char.flag.ON_OBJECT)
	{
		ac.no_pause = 1
		ac.no_hud = 1
	}

	base.fn062194()
}

