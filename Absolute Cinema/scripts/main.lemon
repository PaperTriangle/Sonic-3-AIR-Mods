global bool ac.no_pause
global bool ac.no_hud
global u8 ac.check_act
global bool ac.fullhide

// Prevent fast forward skipping
function void Game.startSkippableCutscene()
{
	if (!ac.skip)
		return
		
	base.Game.startSkippableCutscene()
}

// Prevent Knuckles' Intro Skip
//# address-hook(0x063682) end(0x063692)
function void fn063682()
{
	if !ac.skip && ((control.pad1.pressed & CONTROL_START) || (control.pad2.pressed & CONTROL_START))
		return
		
	base.fn063682()
}

function bool GamePause.BeginPause()
{
	if !ac.skip && (global.game_mode == 0x0c && isSonicIntro() && global.level_started == 0)
		return true

	// Enter game pause
	return base.GamePause.BeginPause()
}

// Actually stop the Pause function.
//# address-hook(0x0013e4) end(0x0014e4)
function void UpdateGamePause()
{
	if ac.prevent && (ac.no_pause || (u8[0xffffb000 + 0x20] == char.state.DIED || u8[0xffffb000 + 0x20] == char.state.DROWNED || u8[0xffffb000 + 0x20] == char.state.DIED_GREY) || global.zone == 0x0d) && !(ac.skip && isSonicIntro())
	{
		global.game.paused = false
		return
	}

	base.UpdateGamePause()
}

// Remove on Game/Time Over
//# address-hook(0x02d5c6) end(0x02d60c)
function void fn02d5c6()
{
	ac.no_pause = 1

	if (ac.hidehud == 2)
		ac.no_hud = 1

	
	base.fn02d5c6()
}

// Results Screen stops pausing.
//# address-hook(0x02dae6) end(0x02dbc8)
function void fn02dae6()
{
	if (!(global.zone_act == 0x1600 || global.zone_act == 0x0800 || global.zone_act == 0x0b00 || global.zone_act == 0x0a00) && global.act.apparent == 0)
	{
		// Any Act 1
		ac.check_act = 1
	}
	else
	{
		// Any Act 2, incl. Lava Reef Boss Act and Sky Sanctuary Zone
		ac.check_act = 2
	}
	
	ac.no_pause = 1

	if (ac.hidehud == 2)
		ac.no_hud = 1

	
	base.fn02dae6()
}

// Restore at title screen.
//# address-hook(0x003af0) end(0x003b12)
function void Menu.FadeInAfterInit()
{
	if (global.game_mode != 0x14)
	{
		ac.no_pause = 0
		ac.no_hud = 0
		ac.check_act = 0
	}
	base.Menu.FadeInAfterInit()
}

// Restore Pause ability at start of level.
function void Standalone.onLevelStart()
{
	ac.no_pause = 0
	
	base.Standalone.onLevelStart()
}

// In case the player dies in the cutscene...
function void Standalone.onDeath()
{
	ac.no_pause = 0
	
	base.Standalone.onDeath()
}

// Restart from Pause Menu.
function void Standalone.onRestartAtCheckpoint()
{
	ac.no_pause = 0
	
	base.Standalone.onRestartAtCheckpoint()
}

// Special logic if Act 2 to prevent pause longer.
//# address-hook(0x02dcca)
function void LevelResults.AdvanceToNextAct()
{
	// I need to do this for Knux's CNZ2 for some reason...
	if (objA0.countdown_value > 0)
		level.wait_for_results = 0xff

	if ac.check_act == 2
		ac.check_act = 3
		
	base.LevelResults.AdvanceToNextAct()
}

// Adjust pause state based on Act and remove HUD
//# post-update-hook
function void PostFrameUpdate()
{
	if (!ac.no_pause)
	{
		ac.no_hud = 0
		ac.fullhide = 0
		ac.check_act = 0
	}
		
	if (ac.check_act == 3 && ac.no_pause && !level.wait_for_results)
	{
		ac.no_hud = 1
		ac.check_act = 0
	}
	else if (ac.check_act == 1 && ac.no_pause && !level.wait_for_results)
	{
		ac.no_pause = 0
		ac.check_act = 0
	}

	if (ac.hidehud && ac.no_hud && !global.game.paused)
	{
		if (ac.fullhide)
		{
			global.level_started = -0x7f
		}
		else
		{
			if (global.level_started > -0x70)
				global.level_started -= 0x10
				
			if (global.level_started < -0x70)
				ac.fullhide = 1
		}
	}
	
	base.PostFrameUpdate()
}

