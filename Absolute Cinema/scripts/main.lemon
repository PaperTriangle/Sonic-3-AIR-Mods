// HCZ Knuckles
//# address-hook(0x062194) end(0x0621d4)
function void fn062194()
{
	if (u16[0xffffb000 + 0x10] >= 0x3990 && u8[0xffffb000 + 0x2e] == 0 && u8[0xffffb000 + 0x2a] & char.flag.ON_OBJECT)
	{
		ac.no_pause = 1
		ac.no_hud = 1
	}

	base.fn062194()
}

//# address-hook(0x062242) end(0x06227a)
function void fn062242()
{
	if !(objA0.render_flags & render_flag.VISIBLE)
		ac.no_pause = 0
	
	base.fn062242()
}	

