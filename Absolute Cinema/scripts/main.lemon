// AIZ1 Knuckles Intro
//# address-hook(0x0634ca) end(0x063524)
function void fn0634ca()
{
	ac.no_pause = 1
	
	base.fn0634ca()
}

//# address-hook(0x063466) end(0x063480)
function void fn063466()
{
	if !ac.skip && (ac.no_pause == 1)
	{
		// Start button pressed?
		if !ac.prevent && (control.pad1.pressed & CONTROL_START)
		{
			if (!GamePause.BeginPause())
				return

			global.game.paused = true

			GamePause.Menu()

			Standalone.onResumeAfterPause()
			global.game.paused = false
		}
	
		control.pad1.pressed &= ~CONTROL_START
		control.pad2.pressed &= ~CONTROL_START
	}
	
	base.fn063466()
}

