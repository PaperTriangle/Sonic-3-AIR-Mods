define u8 global.xtrachar = u8[0xffffe654]

//-------------------//
// Fix Super Flicky! //
//-------------------//

// Render the new sprites
function bool Standalone.onWriteToSpriteTable(s16 px, s16 py, u16 renderQueue)
{
	bool prioFlag
	
	if (sff.victory_animation && global.xtrachar == 0 && A0 == 0xffffcc0a && u8[0xffff0000 + u16[A0 + 0x30] + 0x22] == 0xa6)
	{
		prioFlag = (u16[0xffffcc0a + 0x0a] & sprite_attribute.PRIORITY) == sprite_attribute.PRIORITY
		
		u64 key = stringformat(Mods.isModActive("Plush's Ariff Tails") ? "ariff_tails_tails_victory_%d" : "tails_tails_victory_%d", objA0.animation.sprite - 0x21)
		u8 atex = 0x40 + 0x20 * CHARACTER_TAILS
		Renderer.drawCustomSprite(key, px, py, atex, objA0.render_flags | (prioFlag ? SPRITE_FLAG_PRIO : 0), renderQueue)
		return true
	}
	
	prioFlag = sff.behind_tiles ? (u16[0xffffb000 + 0x0a] & sprite_attribute.PRIORITY) == sprite_attribute.PRIORITY : true
	
    if(objA0.update_address == 0x01a1f4 && global.characters == CHARS_TAILS_ALONE) 
    {
        u64 key = stringformat(sff.green_eyes ? "green_super_flicky_%d" : "super_flicky_%d", objA0.animation.sprite)
       	u8 atex = 0x40 + 0x20 * CHARACTER_SONIC
        if(Renderer.hasCustomSprite(key))
        {
            Renderer.drawCustomSprite(key, px, py, atex, objA0.render_flags | (prioFlag ? SPRITE_FLAG_PRIO : 0), renderQueue)
            return true
        }
    }
	else if(objA0.update_address == 0x01a276 && global.characters == CHARS_TAILS_ALONE) 
    {
        u64 key = stringformat("super_flicky_%d", objA0.animation.sprite)
       	u8 atex = 0x40 + 0x20 * CHARACTER_SONIC
        if(Renderer.hasCustomSprite(key))
        {
            Renderer.drawCustomSprite(key, px, py, atex, objA0.render_flags | (prioFlag ? SPRITE_FLAG_PRIO : 0), renderQueue)
            return true
        }
    }
 
    return base.Standalone.onWriteToSpriteTable(px, py, renderQueue)
}

global s8 superflicky.palettefx.timer
global u16 superflicky.palettefx.frame
global u8 superflicky.palettefx.state

// Use Sonic's extended palette to blend (incase someone is using more pixels in Tails' palette)
function void UpdatePaletteEffects.SuperForm.blendFlicky(u32 source1, u32 source2, u16 blendFactor, bool underwater)
{
	bool isSuperPaletteModded = System.hasExternalPaletteData(getCharacterPaletteKey(CHARACTER_SONIC), 5)		// Check line index 5, for Super/Hyper form palette

	if (sff.super_sonic_palette && isSuperPaletteModded)
		return
	else
	{
		u16 offset = CHARACTER_SONIC * 0x40 + (underwater ? 0x300 : 0)
		for (u8 k = 0; k < 6; k += 2)
		{
			u16[0x802004 + offset + k] = blendColorsPacked(u16[source1 + k], u16[source2 + k], blendFactor)
		}
	}
}

function void moddedFlickyPalette()
{
	if (super.active.tails == 0 && superflicky.palettefx.state == 0xff)
	{
		superflicky.palettefx.state = 2
		superflicky.palettefx.frame = 0
		superflicky.palettefx.timer = 0x1e
	}

	if (superflicky.palettefx.state & 0x80)
	{
		// Update ongoing palette effect
		u8 cycle = (Mods.isModActive("Underwater Super/Hyper Palettes") && !System.getGlobalVariableValueByName("uh.flash.type")) ? 0x06 : 0x0f
		u16 flashStrength = Mods.isModActive("Underwater Super/Hyper Palettes") && System.getGlobalVariableValueByName("uh.flash") ? 0xc8 : 0x100
		
		u16 nextFrame 
		u16 blendFactor 
		
		if (Mods.isModActive("Underwater Super/Hyper Palettes") && !System.getGlobalVariableValueByName("uh.flash.type"))
		{
			blendFactor = (superflicky.palettefx.frame >= 3 ? 1 : superflicky.palettefx.frame) * flashStrength / 2
			nextFrame = (superflicky.palettefx.frame + 1) % 4
		}
		else
		{
			nextFrame = (superflicky.palettefx.frame + 6) % 18
			blendFactor = clamp(u16(superflicky.palettefx.timer) * flashStrength / cycle, 0, flashStrength)

			if (nextFrame % 18 == 0)
				blendFactor = flashStrength - blendFactor
			else if (nextFrame % 18 == 12)
				blendFactor = 0
		}
		
		if (Mods.isModActive("Underwater Super/Hyper Palettes") && System.getGlobalVariableValueByName("uh.style.tails"))
			blendFactor = flashStrength - blendFactor

		for (u8 underwater = 0; underwater < (level.water_present ? 2 : 1); ++underwater)
		{
			u32 offset = CHARACTER_SONIC * 0x40 + (underwater ? 0x300 : 0)
			u32 source = 0x802180 + offset
			u32 dest   = 0x802000 + offset

			// Load modded Super palette
			u8 line = getModdedPaletteLine(CHARACTER_SONIC, false, underwater)

			zeroMemory(dest, 0x40)
			u16 numColors = System.loadExternalPaletteData(getCharacterPaletteKey(CHARACTER_SONIC), line, 0x800000, 0x20)
			for (u16 i = 0; i < numColors; ++i)
			{
				u32 rgba = u32[0x800000 + i * 4]
				u16[dest + i * 2] = (rgba & 0xff000000) ? packColorExt(rgba) : 0
			}

			for (u8 k = 0; k < 0x40; k += 2)
			{
				if (u16[dest + k] == 0)
				{
					// Use original color as fallback
					u16[dest + k] = u16[source + k]
				}
				else
				{
					// Apply flash effect
					
					u16 flashColour = 0xeee
					
					if (Mods.isModActive("Underwater Super/Hyper Palettes"))
					{
						flashColour = underwater ? System.getGlobalVariableValueByName("uh.tint.sonic") - 0x002 : System.getGlobalVariableValueByName("uh.tint.sonic")
					}
					
					u16[dest + k] = blendColorsPacked(u16[dest + k], flashColour, blendFactor)
				}
			}
		}

		--superflicky.palettefx.timer
		if (superflicky.palettefx.timer < 0)
		{
			superflicky.palettefx.timer = cycle
			superflicky.palettefx.frame = nextFrame
		}
	}
	else if (superflicky.palettefx.state == 1)
	{
		// Sonic
		//  -> Fading #contributed by iCloudius
		// Fade in effect
		superflicky.palettefx.frame += 4
		superflicky.palettefx.timer = 1

		for (u8 underwater = 0; underwater < (level.water_present ? 2 : 1); ++underwater)
		{
			u16 flashStrength = Mods.isModActive("Underwater Super/Hyper Palettes") && System.getGlobalVariableValueByName("uh.flash") ? 0xc8 : 0x100
			u16 blendFactor = clamp((superflicky.palettefx.frame + (1 - u16(superflicky.palettefx.timer)) * 6 / 2) * flashStrength / 0x24, 0, flashStrength)
		
			u32 offset = CHARACTER_SONIC * 0x40 + (underwater ? 0x300 : 0)
			u32 source = 0x802180 + offset
			u32 dest   = 0x802000 + offset
		
			// Load modded Super palette
			u8 line = getModdedPaletteLine(CHARACTER_SONIC, false, underwater)
		
			zeroMemory(dest, 0x40)
			u16 numColors = System.loadExternalPaletteData(getCharacterPaletteKey(CHARACTER_SONIC), line, 0x800000, 0x20)
			for (u16 i = 0; i < numColors; ++i)
			{
				u32 rgba = u32[0x800000 + i * 4]
				u16[dest + i * 2] = (rgba & 0xff000000) ? packColorExt(rgba) : 0
			}
		
			for (u8 k = 0; k < 0x40; k += 2)
			{
				if (u16[dest + k] == 0)
				{
					// Use original color as fallback
					u16[dest + k] = u16[source + k]
				}
				else
				{
					// Apply flash effect
					u16[dest + k] = blendColorsPacked(u16[source + k], 0xeee, blendFactor)
				}
			}
		}


		if (superflicky.palettefx.frame < 36)
			return

		// Fully faded in
		superflicky.palettefx.state = 0xff
		superflicky.palettefx.timer = (Mods.isModActive("Underwater Super/Hyper Palettes") && !System.getGlobalVariableValueByName("uh.flash.type")) ? 0x06 : (Mods.isModActive("Underwater Super/Hyper Palettes") && System.getGlobalVariableValueByName("uh.style.tails")) ? 0 : 0x0f
		superflicky.palettefx.frame = (Mods.isModActive("Underwater Super/Hyper Palettes") && !System.getGlobalVariableValueByName("uh.flash.type")) ? 2 : 0
	}
	else if (superflicky.palettefx.state == 2)
	{
		u16 flashStrength = (Mods.isModActive("Underwater Super/Hyper Palettes") && System.getGlobalVariableValueByName("uh.flash") ? 0xc8 : 0x100)
		u16 blendFactor = clamp(0xff * u16(superflicky.palettefx.timer) / 0x1e, 0, 0xff)
		
		if (level.framecounter % 2 == 0 || superflicky.palettefx.timer == 0)
		{
			for (u8 underwater = 0; underwater < (level.water_present ? 2 : 1); ++underwater)
			{
				u32 offset = CHARACTER_SONIC * 0x40 + (underwater ? 0x300 : 0)
				u32 source = 0x802180 + offset
				u32 dest   = 0x802000 + offset

				for (u8 k = 0; k < 0x40; k += 2)
				{
					if (u16[dest + k] == 0)
					{
						// Use original color as fallback
						u16[dest + k] = u16[source + k]
					}
					else
					{
						// Apply flash effect
						u16[dest + k] = blendColorsPacked(u16[source + k], u16[dest + k], blendFactor)
					}
				}
			}
		}
		
		if (superflicky.palettefx.timer == 0)
		{
			superflicky.palettefx.state = 0
		}
		else
		{
			--superflicky.palettefx.timer
		}
	}
}

function void UpdatePaletteEffects.SuperForm.applyGeneral(u8 characterVersion, u32 source)
{
	if (characterVersion == 0xff)
		characterVersion = 1
		
	base.UpdatePaletteEffects.SuperForm.applyGeneral(characterVersion, source)
}


// Make flicky palette rotate if modded
//# address-hook(0x003750) end(0x00398c)
function void UpdatePaletteEffects.SuperForm()
{	
	base.UpdatePaletteEffects.SuperForm()
	
	bool isSuperPaletteModded = System.hasExternalPaletteData(getCharacterPaletteKey(CHARACTER_SONIC), 5)		// Check line index 5, for Super/Hyper form palette
	
	if (sff.super_sonic_palette && isSuperPaletteModded)
		moddedFlickyPalette()
}

//-------------------//
// Super Tails Stars //
//-------------------//

function bool Character.performSuperTransformation()
{
	bool transformResult = base.Character.performSuperTransformation()
	
	if (sff.super_stars && super.active.tails == 1)
		u32[0xffffcbc0] = 0x019156

	return transformResult
}

//# address-hook(0x0191a4) end(0x019230)
function void fn0191a4()
{
	if (!isMainCharacter(CHARACTER_TAILS) || global.xtrachar > 0)
	{
		base.fn0191a4()
		return
	}
	
	if (super.active.tails == 0 || (super.active.tails == 0xff && Game.getSetting(SETTING_HYPER_TAILS)))
	{
		UnloadObject()
		return
	}
	
	u8 backupSuper = super.active
	super.active = super.active.tails

	base.fn0191a4()

	super.active = backupSuper
}

//-------------------//
// Hyper Tails Stars //
//-------------------//

// Used to prevent duplicate stars from debug monitors
global bool alreadyHasStars

//# address-hook(0x01a170) end(0x01a198)
function void fn01a170()
{
	superflicky.palettefx.state = 1
	superflicky.palettefx.timer = 0
	superflicky.palettefx.frame = 0
	
	if (sff.super_stars && !alreadyHasStars && global.zone_act != 0x0d01)
	{
		if (!Game.getSetting(SETTING_HYPER_TAILS))
		{
			u32[0xffffcbc0] = 0x019156
		}
		else
		{
			if Mods.isModActive("Origins Screen Resolution") && !competition_mode.active
				System.setGlobalVariableValueByName("init_sprite_attributes", 1)
			
			Kosinski.addToDMAQueue(0x14c652, Shield.targetInVRAM)
			
			if (allocHyperStarObject())
			{
				for (u8 i = 0; i < 4; ++i)
				{
					objA1.update_address = 0x01937c
					u8[A1 + 0x26] = i * 0x40
					u8[A1 + 0x24] = i + 1
					A1 += 0x4a
				}
				
				alreadyHasStars = true
				fn01937c()
			}
			
			if Mods.isModActive("Origins Screen Resolution") && !competition_mode.active
				System.setGlobalVariableValueByName("init_sprite_attributes", 0)
		}
	}
	else
	{
		Kosinski.addToDMAQueue(0x14c7d4, Char.Player1.targetInVRAM)
	}

	A1 = 0xffffcd7c
	for (u16 k = 0; k < 4; ++k)
	{
		objA1.update_address = 0x01a19c
		u8[A1 + 0x34] = k * 0x40
		A1 += 0x4a
	}

	fn01a19c()
}

// Function checks for four blank object spots in a row. Prevents spawning less that four stars if capacity is hit.
// This could be done smarter probably... But I am lazy and it is pretty unlikely this situation would happen in normal gameplay.
function bool allocHyperStarObject()
{
	A1 = 0xffffb0de
	D0.s16 = 0x59 - 0x03 // Smaller object pool since we are writing four objects.
	while (D0.s16 >= 0)
	{
		A1 += 0x4a
		if (u32[A1] == 0 && u32[A1 + 0x4a] == 0 && u32[A1 + 0x4a*2] == 0 && u32[A1 + 0x4a*3] == 0)
		{
			// Found a free place
			_setZeroFlagByValue(0)
			return true
		}
		--D0.s16
	}

	// Failed
	_setZeroFlagByValue(1)
	return false
}

//# address-hook(0x0193ec) end(0x019486)
function void fn0193ec()
{
	if (!isMainCharacter(CHARACTER_TAILS) || global.xtrachar > 0)
	{
		base.fn0193ec()
		return
	}

	u8 backupSuper = super.active
	super.active = super.active.tails

	base.fn0193ec()

	super.active = backupSuper
}

function void yieldExecution()
{
	base.yieldExecution()

	if (sff.super_stars && alreadyHasStars && isMainCharacter(CHARACTER_TAILS) && super.active.tails != 0xff)
		alreadyHasStars = false
}

//--------------
// Extra Flight!
//--------------

function bool UpdateTailsFlight_innerA()
{
	// Flight countdown
	if (level.framecounter.low & 0x01)
	{
		if (tails.flight_countdown > 0)
			--tails.flight_countdown
	}

	bool fastFlight = (sff.tails_flight == 1 && super.active.tails) || (sff.tails_flight == 2 && super.active.tails == 0xff && Game.getSetting(SETTING_HYPER_TAILS))
	bool canAscend = (char.velocity.y >= (fastFlight ? -0x200 : -0x100) && tails.flight_countdown > 0 && ((char.flags & char.flag.UNDERWATER) == 0 || !tails.carrying))

#if STANDALONE
	// Allow for holding [up] to gain height
	if !sff.no_up && ((control.tails.state & CONTROL_UP) && canAscend && char.velocity.y >= (fastFlight ? -0x1f8 : -0x0f8))
	{
		char.double_jump_state = 0x1f
	}

	// Cancel flight ("Tails Drop"): Stop flying and roll into a ball again
	else if (Game.getSetting(SETTING_CANCEL_FLIGHT) && (control.tails.state & CONTROL_DOWN) && (control.tails.state & CONTROL_ABC))
	{
		char.double_jump_state = 0
		char.state = char.state.ROLLING
		char.jumping = 0			// Clear this flag to prevent a new flight while falling

		Tails.CheckDropSonic()
		updateTailsInAir_shared()
		return false
	}
#endif

	// For Tails' flight, char.double_jump_state is 1 or higher
	//  -> If you don't do anything, it stays 1
	//  -> Press jump to fly higher, and it starts counting up until 0x20, as a timer for the upwards flight effect
	if (char.double_jump_state != 1)
	{
		if (char.velocity.y >= (fastFlight ? -0x200 : -0x100))
		{
			// Fly up
			char.velocity.y -= 0x20

			++char.double_jump_state
			if (char.double_jump_state == 0x20)
			{
				char.double_jump_state = 1
			}
		}
		else
		{
			char.double_jump_state = 1
		}
	}
	else
	{
		if ((control.tails.pressed & CONTROL_ABC) && canAscend)
		{
			char.double_jump_state = 2
		}

		// Reduced gravity effect during flight (8 instead of 0x38)
		char.velocity.y += 8
	}

	if (s16(char.position.y.u16) <= s16(level.vertical_wrap + 0x10))
	{
		if (char.velocity.y < 0)
			char.velocity.y = 0
	}
	return true
}


//--------------//
// AIZ Vine Fix //
//--------------//

//# address-hook(0x0221ec) end(0x022246)
function void fn0221ec()
{
	if (!sff.vine_tweak)
	{
		base.fn0221ec()
		return
	}
	
	if (u16[A0 + 0x30] != 0)
	{
		fn022258()
		return
	}

	fn02219e()		// Check for cheat
	objA1.position.x.u16 = objA0.position.x.u16
	objA1.position.y.u16 = objA0.position.y.u16 + 0x14

	A3 = 0xffff0000 + u16[A0 + 0x3c]
	D0 = u8[A3 + 0x26]
	if (u8[A1 + 0x2a] & char.flag.FACING_LEFT)
		D0.s8 = -D0.s8

	D0.u16 = u8(D0.u8 + 8) >> 4
	objA1.animation.sprite = u8[0x022248 + D0.u16]		// Player characters' hanging sprites
	objA1.state = char.state.HANGING
	fn022224()
}

// AIZ Vine Tweak
//# address-hook(0x022040) end(0x022072)
//# address-hook(0x02254a) end(0x02257c)
function void fn022040()
{
	if (!sff.vine_tweak)
	{
		base.fn022040()
		return
	}
	
	// Move with parent object
	A1 = 0xffff0000 + u16[A0 + 0x3c]
	u8 angle = u8[A1 + 0x26]
	s16 dx = (8 - lookupSin(angle)) >> 4
	s16 dy = (8 + lookupCos(angle)) >> 4
	objA0.position.x.u16 = objA1.position.x.u16 + dx
	objA0.position.y.u16 = objA1.position.y.u16 + dy
}

// Prevent collapse
//# address-hook(0x020594) end(0x0205b0)
function void CollapsingCliff.Update()
{
	if (sff.vine_tweak)
	{
		if (objA0.flags2a & object.flag.P1_ON_OBJECT) && (u8[0xffffb000 + 0x20] == char.state.HANGING || (u8[0xffffb000 + 0x22] >= 0x78 && u8[0xffffb000 + 0x22] <= 0x7f))
		{
			objA0.flags2a &= ~object.flag.P1_ON_OBJECT
			u8[0xffffb000 + 0x2a] &= ~char.flag.ON_OBJECT
			u8[0xffffb000 + 0x2a] |= char.flag.IN_AIR
		}
		else if (objA0.flags2a & object.flag.P2_ON_OBJECT) && (u8[0xffffb04a + 0x20] == char.state.HANGING || (u8[0xffffb04a + 0x22] >= 0x78 && u8[0xffffb04a + 0x22] <= 0x7f))
		{
			objA0.flags2a &= ~object.flag.P2_ON_OBJECT
			u8[0xffffb04a + 0x2a] &= ~char.flag.ON_OBJECT
			u8[0xffffb04a + 0x2a] |= char.flag.IN_AIR
		}
	}
		
	base.CollapsingCliff.Update()
}

//--------------------//
// Super Tails Drowns //
//--------------------//

//# address-hook(0x018466) end(0x018680)
function void fn018466()
{
	if (!sff.super_drown || !(global.xtrachar == 0 && isMainCharacter(CHARACTER_TAILS)))
	{
		base.fn018466()
		return
	}
	
	A2 = u32[A0 + 0x40]
#if GAMEAPP
	if (A2 == 0xffffb000 && u8[0xffffb000 + 0x05] <= base_state.HURT)
	{
		if (Game.getSetting(SETTING_UNDERWATER_AUDIO))
		{
			s16 diff = s16[0xffffb000 + 0x14] - s16(water.height.current)
			Game.setUnderwaterAudioEffect(clamp(diff - 8, 0, 64) * 0xff / 64)
		}
		else
		{
			Game.setUnderwaterAudioEffect(0)
		}
	}
#endif

	bool doChecks = true
	if (u16[A0 + 0x30] == 0)
	{
		// Character died?
		if (u8[A2 + 0x05] >= base_state.DIED)
			return

		// Protected by bubble shield?
		if (u8[A2 + 0x2b] & char.bonus.SHIELD_BUBBLE)
			return

	#if STANDALONE
		// Hyper form active?
		if (u8[A2 + 0x38] == CHARACTER_TAILS && Game.getSetting(SETTING_HYPER_TAILS))
		{
			if (super.active.tails & 0x80)
				return
		}
		else
	#endif
		{
			if (super.active & 0x80)
				return
		}

		// Left the water?
		if ((u8[A2 + 0x2a] & char.flag.UNDERWATER) == 0)
			return

		// Decrease the drown countdown
		--u16[A0 + 0x3c]
		if (s16[A0 + 0x3c] < 0)
		{
			u16[A0 + 0x3c] = 0x3b
			u16[A0 + 0x3a] = 0x01
			objA0.flags38 = (getRandomNumber() & 0x01)

			D0 = u8[A2 + 0x2c]
			if (D0.u16 != 0x0f && D0.u16 != 0x14 && D0.u16 != 0x19)
			{
				if (D0.u16 <= 0x0c)
				{
					if (D0.u16 == 0x0c && u8[A0 + 0x43] == 0)
					{
						playMusic(MUSIC_DROWNING)
					}

					--u8[A0 + 0x36]
					if (s8[A0 + 0x36] < 0)
					{
						u8[A0 + 0x36] = u8[A0 + 0x37]
						objA0.value3a |= 0x80
					}
				}
			}
			else
			{
				if (u8[A0 + 0x43] == 0)
				{
					playSound(SFX_UNDERWATER_BELL)
				}
			}

			--u8[A2 + 0x2c]
			if (s8[A2 + 0x2c] < 0)
			{
				// Drowned
				u8[A2 + 0x2e] = 0x81
				playSound(SFX_DROWN)

				objA0.flags38 = 0x0a
				u16[A0 + 0x3a] = 0x01
				u16[A0 + 0x30] = 0x78

				A1 = A2
				UpdateMusicOnWaterTransition()
				u32 backupA0 = A0

				A0 = A2
				Character.LandingOnGroundNoSpindash()

				objA0.state = char.state.DROWNED
				objA0.flags2a |= 0x02
				u8[A0 + 0x0a] |= 0x80
				objA0.velocity.y = 0
				objA0.velocity.x = 0
				s16[A0 + 0x1c] = 0
				objA0.base_state = base_state.DROWNED
				A0 = backupA0
				if (A2 == 0xffffb000)
				{
					u8[0xffffee30] = 1
				}
				return
			}
			else
			{
				doChecks = false
			}
		}
	}
	else
	{
		u8[A2 + 0x20] = char.state.DROWNED
		--u16[A0 + 0x30]
		if (u16[A0 + 0x30] == 0)
		{
			u8[A2 + 0x05] = base_state.DIED
			return
		}
	}

	if (doChecks)
	{
		if (u16[A0 + 0x3a] == 0)
			return

		--objA0.value3e
		if (s16[A0 + 0x3e] >= 0)
			return
	}

	objA0.value3e = 8 + (getRandomNumber() & 0x0f)
	if (allocDynamicObjectStd())
	{
		objA1.update_address = objA0.update_address
		objA1.position.x.u16 = u16[A2 + 0x10]
		D0 = 6
		if (u8[A2 + 0x2a] & char.flag.FACING_LEFT)
		{
			D0.s16 = -D0.s16
			u8[A1 + 0x26] = 0x40
		}
		objA1.position.x.u16 += D0.u16
		objA1.position.y.u16 = u16[A2 + 0x14]
	#if STANDALONE
		// Moves Knuckles' respiratory system back into his mouth, #contributed by iCloudius
		if (u8[A2 + 0x38] == CHARACTER_KNUCKLES)
			objA1.position.y.u16 -= 5
	#endif
		u32[A1 + 0x40] = u32[A0 + 0x40]
		u8[A1 + 0x2c] = 6
		if (u16[A0 + 0x30] != 0)
		{
			objA0.value3e &= 0x07
			D0.u16 = u16[A2 + 0x14] - 12
			objA1.position.y.u16 = D0.u16
			u8[A1 + 0x26] = getRandomNumber()
			D0.u16 = level.framecounter & 0x03
			if (D0.u8 == 0)
			{
				u8[A1 + 0x2c] = 0x0e
			}
		}
		else
		{
			if (objA0.value3a & 0x80)
			{
				D2 = u8[A2 + 0x2c]
				if (D2.u8 < 0x0c)
				{
					D2.u16 >>= 1
					D0.u16 = getRandomNumber() & 0x03
					if (D0.u16 == 0)
					{
						if ((objA0.value3a & 0x40) == 0)
						{
							objA0.value3a |= 0x40
							u8[A1 + 0x2c] = D2.u8
							u16[A1 + 0x3c] = 28
						}
					}
					if (objA0.flags38 == 0)
					{
						if ((objA0.value3a & 0x40) == 0)
						{
							objA0.value3a |= 0x40
							u8[A1 + 0x2c] = D2.u8
							u16[A1 + 0x3c] = 28
						}
					}
				}
			}
		}

		--objA0.flags38
		if (s8[A0 + 0x38] < 0)
			u16[A0 + 0x3a] = 0
	}
}

//---------------------------------------------------------------------//
// Tails' tails animation fix while looking up and during Vitory pose. //
//---------------------------------------------------------------------//

//# address-hook(0x0160d2)
function void TailsTails.Update()
{
	if (global.xtrachar != 0 || !(sff.lookup_animation_fix || sff.lookup_animation_fix))
	{
		base.TailsTails.Update()
		return
	}
	
	// Update various properties from Tails main object
	A2 = 0xffff0000 + u16[A0 + 0x30]
	objA0.position.x.u16 = u16[A2 + 0x10]
	objA0.position.y.u16 = u16[A2 + 0x14]
	u8[A0 + 0x26] = u8[A2 + 0x26]			// Rotation
	objA0.flags2a = u8[A2 + 0x2a]			// Flags
	objA0.sprite_priority = u16[A2 + 0x08]
	objA0.sprite_attributes = (objA0.sprite_attributes & ~sprite_attribute.PRIORITY) | (u16[A2 + 0x0a] & sprite_attribute.PRIORITY)
	
	D0 = u8[A2 + 0x20]
	if (sff.lookup_animation_fix && u8[A2 + 0x20] == char.state.LOOKING_UP) || (sff.victory_animation && u8[A2 + 0x20] == char.state.WIN_POSE)
	{
		D0 = 5
	}
	if ((u8[A2 + 0x2a] & char.flag.PUSHING) && level.HCZ_water_current_flags.tails == 0)
	{
		if (u8[A2 + 0x22] >= 0xa9 && u8[A2 + 0x22] <= 0xac)		// Range of Tails' pushing animation frames
		{
			D0 = 4	// Set appropriate tail animation manually, because char.state isn't actually set for character pushing animation
		}
	}
	if (u8[A0 + 0x34] != D0.u8)
	{
		u8[A0 + 0x34] = D0.u8
		objA0.state = u8[0x016164 + D0.s16]
	}
	
	A1 = 0x016196
	UpdateTailsAnimation_inner()
	if (global.inv_gravity && objA0.state != 0x03)
	{
		objA0.render_flags ^= render_flag.FLIP_Y
	}
	
	TailsTails.UpdateSpritePatterns()
	
	DrawObject()
}

// Move the damn tails at act transition...
//# address-hook(0x04f3b0) end(0x04f3d2)
function void fn04f3b0()
{
	if (global.xtrachar == 0) // Need to do this because of ES Ray.
	{
		u16[0xffffcc0a + 0x10] -= D0.u16
		u16[0xffffcc0a + 0x14] -= D1.u16
	}
	
	base.fn04f3b0()
}

// Custom Tails victory pose
function u64 Standalone.getModdedAnimationSpriteKey(u8 character, u16 animationSpriteEx)
{

#if EXTRA_CHARACTER_FRAMEWORK_ACTIVE
	if getECFCharBufferName(A0)
		return base.Standalone.getModdedAnimationSpriteKey(character, animationSpriteEx)
#endif

	if sff.victory_animation && global.xtrachar == 0 && character == 1 && objA0.mapping_offset != 0x344bb8
	{
		if animationSpriteEx == 0xa5
			return Mods.isModActive("Plush's Ariff Tails") ? "ariff_tails_victory_1" : "tails_victory_1"
		else if animationSpriteEx == 0xa6
			return Mods.isModActive("Plush's Ariff Tails") ? "ariff_tails_victory_2" : "tails_victory_2"
	}

	return base.Standalone.getModdedAnimationSpriteKey(character, animationSpriteEx)
}

function u8 lookupAngleByVector(s16 dx, s16 dy)
{
	if sff.spindash_animation_fix && (A0 == 0xffffcc0a && dx == 0 && dy == 0) && !(u8[0xffff0000 + u16[A0 + 0x30] + 0x2a] & char.flag.IN_AIR)
	{
		if u8[0xffff0000 + u16[A0 + 0x30] + 0x2a] & char.flag.FACING_LEFT
			return 0x80
		else
			return 0x00
	}
	
	return base.lookupAngleByVector(dx, dy)
}

//# address-hook(0x001380) end(0x0013c0)
function void PlaySound()
{
	if (sff.disable_return_sounds && tails.ai_routine == 0x04 && D0 == 0xba)
		return
	
	base.PlaySound()
}

//----------------------------------------------------//
// Blue Glasses Eggman Always uses First Palette Line //
//----------------------------------------------------//

function u16 EggmanBlue.getDefaultPal()
{
	return 0x00
}

//---------------------//
// Super breaks stuff! //
//---------------------//

//# address-hook(0x021568) end(0x021690)
function void fn021568()
{
	if !((sff.super_breaks_stuff && super.active.tails && global.xtrachar == 0 && isMainCharacter(CHARACTER_TAILS)) || (sff.super_breaks_stuff && super.active.tails && global.xtrachar == 2 && sff.super_breaks_stuff == 2))
	{
		base.fn021568()
		return
	}
	
	u8 backupSuper = super.active
	super.active = 1
	base.fn021568()
	super.active = backupSuper
}

//# address-hook(0x01fd08) end(0x01ff1a)
function void fn01fd08()
{
	if !((sff.super_breaks_stuff && super.active.tails && global.xtrachar == 0 && isMainCharacter(CHARACTER_TAILS)) || (sff.super_breaks_stuff && super.active.tails && global.xtrachar == 2 && sff.super_breaks_stuff == 2))
	{
		base.fn01fd08()
		return
	}
	
	u8 backupSuper = super.active
	super.active = 1
	base.fn01fd08()
	super.active = backupSuper
}

function bool BTP.canBreak(u8 state.in)
{
	if !((sff.super_breaks_stuff && super.active.tails && global.xtrachar == 0 && isMainCharacter(CHARACTER_TAILS)) || (sff.super_breaks_stuff && super.active.tails && global.xtrachar == 2 && sff.super_breaks_stuff == 2))
		return base.BTP.canBreak(state.in)
		
	return true
}