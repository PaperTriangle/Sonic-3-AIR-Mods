//--------------------------------------------------//
// Had to make this one special to prevent death... //
//--------------------------------------------------//

//# address-hook(0x01dffe)
function void fn01dffe()
{
	if !fbz.magnet || global.zone != 0x04
	{
		base.fn01dffe()
		return
	}

	if (fbz.magnet > 0) && (A1 == 0xffffb000)
	{
		if (objA1.position.x.u16 < objA0.position.x.u16 - 0x17) || (objA1.position.x.u16 > objA0.position.x.u16 + 0x17) || (objA1.position.y.u16 > objA0.position.y.u16)
		{
			base.fn01dffe()
			return
		}
		else if (objA0.update_address == 0x03b3fa) //&& (objA1.position.y + 0x18 < objA0.position.y)
		{
			s16[A1 + 0x1a] = -objA0.velocity.y
			objA1.flags2a |= char.flag.IN_AIR
			objA1.flags2a &= ~char.flag.ON_OBJECT
			if (fbz.magnet.attract > 0)
			{
				if (u8[0xffffb000 + 0x40] == 0 && fbz.magnet.attract == 1) ||  (fbz.magnet.attract > 1)
				{
					u8[0xffffb000 + 0x1e] = char.hitbox.x.ROLLING
					u8[0xffffb000 + 0x1f] = char.hitbox.y.ROLLING
					u8[0xffffb000 + 0x20] = char.state.ROLLING
					u8[0xffffb000 + 0x2a] |= char.flag.ROLLING
					u16[0xffffb000 + 0x14] -= 0x05
				}
						
				if (fbz.magnet.attract > 1)
				{
					u8[0xffffb000 + 0x40] = 0
					u8[0xffffb000 + 0x2f] = 0
				}
			}
		}
		else
		{
			u16[A1 + 0x14] -= 0x01
			s16[A1 + 0x1a] = 0x1
		}
		
		return
	}
	
	base.fn01dffe()
}
