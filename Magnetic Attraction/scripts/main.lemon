//--------------------------------------------------//
// Had to make this one special to prevent death... //
//--------------------------------------------------//

//# address-hook(0x01dffe)
function void fn01dffe()
{
	if !fbz.magnet || global.zone != 0x04
	{
		base.fn01dffe()
		return
	}

	if (fbz.magnet > 0) && (A1 == char.ADDRESS_P1) && !(u8[char.ADDRESS_P1 + 0x20] == char.state.DIED || u8[char.ADDRESS_P1 + 0x20] == char.state.GOT_HURT)
	{
		if u32[0xffff0000 + u16[char.ADDRESS_P1 + 0x42]] == 0x01f6d0 && (objA1.position.x.u16 > objA0.position.x.u16 - 0x18) && (objA1.position.x.u16 < objA0.position.x.u16 + 0x18)
		{
			fbz.killvalue = objA1.position.y.u16 - objA0.position.y.u16
			fbz.killtimer = 0x04
		}
		
		if (objA1.position.x.u16 < objA0.position.x.u16 - 0x17) || (objA1.position.x.u16 > objA0.position.x.u16 + 0x17) || (objA1.position.y.u16 > objA0.position.y.u16)
		{
			base.fn01dffe()
			return
		}
		else if (objA0.update_address == 0x03b3fa)
		{
			s16[A1 + 0x1a] = -objA0.velocity.y
			objA1.flags2a |= char.flag.IN_AIR
			objA1.flags2a &= ~char.flag.ON_OBJECT
			if (fbz.magnet.attract > 0)
			{
				if (u8[A1 + 0x40] == 0 && fbz.magnet.attract == 1) ||  (fbz.magnet.attract > 1)
				{
					//u8[A1 + 0x1e] = char.hitbox.x.ROLLING
					//u8[A1 + 0x1f] = char.hitbox.y.ROLLING
					u8[A1 + 0x20] = char.state.ROLLING
					u8[A1 + 0x2a] |= char.flag.ROLLING
					u8[A1 + 0x3d] = 0
					u8[A1 + 0x3e] = 0	
					u16[A1 + 0x14] -= 0x05
				}
						
				if (fbz.magnet.attract > 1)
				{
					u8[A1 + 0x40] = 0
					u8[A1 + 0x2f] = 0
				}
			}
		}
		else
		{
			u16[A1 + 0x14] -= 0x01
			s16[A1 + 0x1a] = 0x1
		}
		
		return
	}
	
	base.fn01dffe()
}

//----------------------//
// Adjust death objects //
//----------------------//

function void LevelObjectTableBuilder.addObject(u16 px, u16 py, u8 type, u8 subtype, u8 flags)
{

	if global.zone_act == 0x0400
	{
		if py == 0x031c && (px == 0x10c0 || px == 0x12c0)
			py -= 1
	}
	else if global.zone_act == 0x0401
	{
		if py == 0x0b18 && (px == 0x27c0 || px == 0x2840)
			py += 3
		else if py == 0x0718 && (px == 0x1c40 || px == 0x1cc0)
			py += 3
		else if py == 0x0898 && (px == 0x1cc0 || px == 0x1d40)
			py += 3
	}

	base.LevelObjectTableBuilder.addObject(px, py, type, subtype, flags)
}

global s16 fbz.killvalue
global s16 fbz.killtimer

//# address-hook(0x01f6d0) end(0x01f732)
function void fn01f6d0()
{
	if !fbz.magnet || global.zone != 0x04
	{
		base.fn01f6d0()
		return
	}
	
	if (fbz.killvalue < 0 && fbz.killvalue > -30)
		u16[char.ADDRESS_P1 + 0x14] -= 0x03

	D1 = objA0.box_size.x + 11
	D2 = objA0.box_size.y + 2
	D3.u16 = D2.u16 + 1
	D4.u16 = objA0.position.x.u16
	CheckCharacterOnClimbableObject()

	if (fbz.killvalue < 0 && fbz.killvalue > -30)
		u16[char.ADDRESS_P1 + 0x14] += 0x03

	D6 = (D6 << 16) + (D6 >> 16)
	if (objA0.flags2a & object.flag.P1_ON_OBJECT) && (fbz.killvalue < 0 && fbz.killvalue > -30)
	{
		A1 = 0xffffb000
		BlockerElement.KillCharacter()
	}
	if (D6.u8 & 0x08)
	{
		A1 = 0xffffb04a
		BlockerElement.KillCharacter()
	}
	
	BlockerElement.checkForUnloadAndDebugRender(0xffffff80)
}
