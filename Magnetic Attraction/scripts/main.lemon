//# address-hook(0x01e44c)
function void CheckCharacterClimbOnObjectInner()
{
	if !fbz.magnet || global.zone != 0x04
	{
		base.CheckCharacterClimbOnObjectInner()
		return
	}
	
	u8 gravbackup = global.inv_gravity
	if fbz.magnet && (A1 == char.ADDRESS_P1)
	{
		global.inv_gravity = 0x01
	}
	base.CheckCharacterClimbOnObjectInner()
	global.inv_gravity = gravbackup
}

