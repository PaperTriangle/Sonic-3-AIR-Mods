//-------------------------------------------------------------//
// Use the electricity object to check if the player is nearby //
//-------------------------------------------------------------//

//# address-hook(0x03b1fc) end(0x03b232)
function void fn03b1fc()
{
	if (u8[0xfffff7c1] != 0) && !(u8[char.ADDRESS_P1 + 0x20] == char.state.DIED || u8[char.ADDRESS_P1 + 0x20] == char.state.GOT_HURT)
	{
		s32 diffX = abs(u16[char.ADDRESS_P1 + 0x10] - objA0.position.x.u16)
		s32 diffY = u16[char.ADDRESS_P1 + 0x14] - objA0.position.y.u16

		if (diffX < 0x41 && diffY > 0 && diffY < 0xa0) && (u8[char.ADDRESS_P1 + 0x2b] & char.bonus.SHIELD_LIGHTNING)
		{
			if !fbz.magnet
			{
				s16[char.ADDRESS_P1 + 0x1a] = -s16[char.ADDRESS_P1 + 0x1a]
				if (u8[char.ADDRESS_P1 + 0x2a] & char.flag.ON_OBJECT)
				{
					u8[char.ADDRESS_P1 + 0x2a] &= ~char.flag.ON_OBJECT
					u8[char.ADDRESS_P1 + 0x2a] |= char.flag.IN_AIR
					u16[char.ADDRESS_P1 + 0x14] -= 0x08
					u8[0xffff0000 + u16[char.ADDRESS_P1 + 0x42] + 0x2a] &= ~(1 << 3)
				}
				
				if (fbz.magnet.attract > 0)
				{
					if (u8[char.ADDRESS_P1 + 0x40] == 0 && fbz.magnet.attract == 1) || (fbz.magnet.attract > 1)
					{
						//u8[char.ADDRESS_P1 + 0x1e] = char.hitbox.x.ROLLING
						//u8[char.ADDRESS_P1 + 0x1f] = char.hitbox.y.ROLLING
						u8[char.ADDRESS_P1 + 0x20] = char.state.ROLLING
						u8[char.ADDRESS_P1 + 0x2a] |= char.flag.ROLLING
						u8[char.ADDRESS_P1 + 0x3d] = 0
						u8[char.ADDRESS_P1 + 0x3e] = 0	
						if (u8[char.ADDRESS_P1 + 0x2a] & char.flag.IN_AIR) == 0
						{
							u16[char.ADDRESS_P1 + 0x14] -= 0x05
							u8[char.ADDRESS_P1 + 0x2a] |= char.flag.IN_AIR
						}
						
						if (fbz.magnet.attract > 1)
						{
							u8[char.ADDRESS_P1 + 0x40] = 0
							u8[char.ADDRESS_P1 + 0x2f] = 0
						}
					}
				}
			}
			
			fbz.magnet = 2
		}
	}
	
	base.fn03b1fc()
}

//--------------------------------------------------//
// Load rawdata chunks and decrease the magnet flag //
//--------------------------------------------------//

function void yieldExecution()
{
	base.yieldExecution()
	
	if (global.zone == 0x04)
	{
		if Mods.isModActive("FBZ's outside borders")
			System.loadExternalRawData("fbz_chunks_outside", 0x001974a2)
		else
			System.loadExternalRawData("fbz_chunks", 0x001974a2)
	}
}

//# post-update-hook
function void PostFrameUpdate()
{
	base.PostFrameUpdate()
	
	if !global.game.paused
	{
		if (fbz.magnet > 0)
		{
			if !(u8[char.ADDRESS_P1 + 0x20] == char.state.DIED || u8[char.ADDRESS_P1 + 0x20] == char.state.GOT_HURT)
			{
				fbz.magnet--
				if (fbz.magnet == 0)
				{
					s16[char.ADDRESS_P1 + 0x1a] = -s16[char.ADDRESS_P1 + 0x1a]
					
					if (fbz.magnet.attract > 0)
					{
						if (u8[char.ADDRESS_P1 + 0x40] == 0 && fbz.magnet.attract == 1) ||  (fbz.magnet.attract > 1)
						{
							//u8[char.ADDRESS_P1 + 0x1e] = char.hitbox.x.ROLLING
							//u8[char.ADDRESS_P1 + 0x1f] = char.hitbox.y.ROLLING
							u8[char.ADDRESS_P1 + 0x20] = char.state.ROLLING
							u8[char.ADDRESS_P1 + 0x2a] |= char.flag.ROLLING
							u8[char.ADDRESS_P1 + 0x3d] = 0
							u8[char.ADDRESS_P1 + 0x3e] = 0	
							if (u8[char.ADDRESS_P1 + 0x2a] & char.flag.IN_AIR) == 0
							{
									u16[char.ADDRESS_P1 + 0x14] += 0x05
									u8[char.ADDRESS_P1 + 0x2a] |= char.flag.IN_AIR
							}
								
							if (fbz.magnet.attract > 1)
							{
								u8[char.ADDRESS_P1 + 0x40] = 0
								u8[char.ADDRESS_P1 + 0x2f] = 0
							}
						}
					}
				}
			}
			else
				fbz.magnet = 0
		}

		if (fbz.killtimer > 0)
		{
			fbz.killtimer--
			
			if (fbz.killtimer == 0)
				fbz.killvalue = 0
		}
		
		//System.writeDisplayLine(stringformat("value: %d, %06x",  fbz.killvalue, u32[0xffff0000 + u16[char.ADDRESS_P1 + 0x42]]))
	}
}

