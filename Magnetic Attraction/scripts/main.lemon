//-------------------------------------------------------------//
// Use the electricity object to check if the player is nearby //
//-------------------------------------------------------------//

//# address-hook(0x03b1fc) end(0x03b232)
function void fn03b1fc()
{
	if (u8[0xfffff7c1] != 0)
	{
		s32 diffX = abs(u16[0xffffb000 + 0x10] - objA0.position.x.u16)
		s32 diffY = u16[0xffffb000 + 0x14] - objA0.position.y.u16

		if (diffX < 0x41 && diffY > 0 && diffY < 0xa0) && (u8[0xffffb000 + 0x2b] & char.bonus.SHIELD_LIGHTNING)
		{
			if !fbz.magnet
			{
				s16[0xffffb000 + 0x1a] = -s16[0xffffb000 + 0x1a]
				if (u8[0xffffb000 + 0x2a] & char.flag.ON_OBJECT)
				{
					u8[0xffffb000 + 0x2a] &= ~char.flag.ON_OBJECT
					u8[0xffffb000 + 0x2a] |= char.flag.IN_AIR
					u16[0xffffb000 + 0x14] -= 0x08
					u8[0xffff0000 + u16[0xffffb000 + 0x42] + 0x2a] &= ~(1 << 3)
				}
			}
			fbz.magnet = 2
		}
	}
	
	base.fn03b1fc()
}

//--------------------------------------------------//
// Load rawdata chunks and decrease the magnet flag //
//--------------------------------------------------//

function void yieldExecution()
{
	if (global.zone == 0x04)
	{
		if Mods.isModActive("FBZ's outside borders")
			System.loadExternalRawData("fbz_chunks_outside", 0x001974a2)
		else
			System.loadExternalRawData("fbz_chunks", 0x001974a2)
	}
	
	if (fbz.magnet > 0)
	{
		fbz.magnet--
		if (fbz.magnet == 0)
			s16[0xffffb000 + 0x1a] = -s16[0xffffb000 + 0x1a]
	}
	
	base.yieldExecution()
}

