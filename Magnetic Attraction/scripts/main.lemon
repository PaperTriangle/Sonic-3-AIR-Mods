//--------------------------------------------------//
// Had to make this one special to prevent death... //
//--------------------------------------------------//

//# address-hook(0x01dffe)
function void fn01dffe()
{
	if !fbz.magnet || global.zone != 0x04
	{
		base.fn01dffe()
		return
	}

	if (fbz.magnet > 0) && (A1 == 0xffffb000)
	{
		if (objA0.update_address == 0x03b3fa)
		{
			s16[A1 + 0x1a] = -objA0.velocity.y
		}
		else
		{
			u16[A1 + 0x14] -= 0x01
			s16[A1 + 0x1a] = 0
		}
		
		objA1.flags2a |= char.flag.IN_AIR
		objA1.flags2a &= ~char.flag.ON_OBJECT

		return
	}
	
	base.fn01dffe()
}