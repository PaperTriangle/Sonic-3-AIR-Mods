global u8 fbz.magnet
global u8 fbz.magnet.attract

define u32 char.ADDRESS_P1 = 0xffffb000
define u8 global.xtrachar = u8[0xffffe654]

//------------------------------------------------------------//
// Hooks for each character to flip gravity then flip it back //
//------------------------------------------------------------//

//# address-hook(0x010a94) end(0x010ae8)
function void Character.BaseUpdate.Sonic()
{
	if !fbz.magnet || global.zone != 0x04
	{
		base.Character.BaseUpdate.Sonic()
		return
	}
	
	u8 gravbackup = global.inv_gravity
	if fbz.magnet && (A0 == char.ADDRESS_P1)
	{
		global.inv_gravity = 0x01
	}
	base.Character.BaseUpdate.Sonic()
	global.inv_gravity = gravbackup
}

