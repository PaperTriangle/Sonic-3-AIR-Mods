//------------------------------------------------------------//
// Allow or prevent jump moves based on character and setting //
//------------------------------------------------------------//

function void Character.updateJumpMoves()
{
	if (fbz.magnet.attract > 1) && global.zone == 0x04 && fbz.magnet && (A0 == char.ADDRESS_P1)
	{
		if (fbz.magnet.attract == 2)
		{
			bool charCheck = global.xtrachar == 0 && (global.characters == CHARS_SONIC_AND_TAILS || global.characters == CHARS_SONIC_ALONE)	&& (!(char.bonus_effect & char.bonus.INVINCIBLE) || (super.active == 0x01 && Game.getSetting(SETTING_SUPER_SONIC_ABILITY) == 1))
		#if EXTRA_CHARACTER_FRAMEWORK_ACTIVE
			charCheck = isECFCharP1("") ? charCheck : 0
		#endif
		
			if charCheck
			{
				base.Character.updateJumpMoves()
				return
			}
		}
		
		if (control.pad1.pressed & CONTROL_ABC)
			return
	}
	
	base.Character.updateJumpMoves()
}

//# address-hook(0x0118bc) end(0x011afc)
function void UpdateSonicJumpMoves()
{
	if (fbz.magnet.attract > 1) && global.zone == 0x04 && fbz.magnet && (A0 == char.ADDRESS_P1)
	{
		if (fbz.magnet.attract == 2)
		{
			bool charCheck = global.xtrachar == 0 && (global.characters == CHARS_SONIC_AND_TAILS || global.characters == CHARS_SONIC_ALONE)	&& (!(char.bonus_effect & char.bonus.INVINCIBLE) || (super.active == 0x01 && Game.getSetting(SETTING_SUPER_SONIC_ABILITY) == 1))
		#if EXTRA_CHARACTER_FRAMEWORK_ACTIVE
			charCheck = isECFCharP1("") ? charCheck : 0
		#endif
		
			if charCheck
			{
				base.UpdateSonicJumpMoves()
				return
			}

		}
		
		if (control.pad1.pressed & CONTROL_ABC)
			return
	}
	
	base.UpdateSonicJumpMoves()
}

//# address-hook(0x0150da) end(0x0151f6)
function void UpdateTailsJumpMoves()
{
	if (fbz.magnet.attract > 1) && global.zone == 0x04 && fbz.magnet && (A0 == char.ADDRESS_P1) && (control.pad1.pressed & CONTROL_ABC)
		return
	
	base.UpdateTailsJumpMoves()
}

//# address-hook(0x0177ea) end(0x017938)
function void UpdateKnucklesJumpMoves()
{
	if (fbz.magnet.attract > 1) && global.zone == 0x04 && fbz.magnet && (A0 == char.ADDRESS_P1) && (control.pad1.pressed & CONTROL_ABC)
		return
	
	base.UpdateKnucklesJumpMoves()
}

//-------------------------------------------------------//
// Only player 1 had shields, flip their drawing as well //
//-------------------------------------------------------//

function bool Standalone.onWriteToSpriteTable(s16 px, s16 py, u16 renderQueue)
{
	u8 gravbackup = global.inv_gravity
	if fbz.magnet && ( (A0 == char.ADDRESS_P1) || (isMainCharacter(CHARACTER_TAILS) && A0 == 0xffffcc0a) || (objA0.update_address == 0x018b3e && objA0.dustcloud.character_address == 0xb000))
	{
		py++
		global.inv_gravity = 0x01
	}
	
	bool returnVal = base.Standalone.onWriteToSpriteTable(px, py, renderQueue)
	global.inv_gravity = gravbackup
	
	return returnVal
}

