function void Fireworm.BaseUpdate()
{
	// Targets:
	//  - 0x08f7ea	-> objA0.base_state = 0x00
	//  - 0x08f812	-> objA0.base_state = 0x04
	//  - 0x08f862	-> objA0.base_state = 0x06
	//  - 0x08f89a	-> objA0.base_state = 0x08
	call tableLookupAddress(0x08f7e0, objA0.base_state)

	Object.loadSpritePatterns(0x08fa38)

	D0.u16 = (objA0.position.x.u16 & 0xff80) - level.despawn_position.x
	if (D0.u16 <= (0x0280 + (ort.spawnfix ? 0x80 : 0)))
	{
		AddAsDynamicObject()
		DrawObject()
	}
	else
	{
		fn0851d8()
	}
}

// LRZ Largedriller
//# address-hook(0x09026e) end(0x0902e6)
function void fn09026e()
{
	playSoundRepeatedly(0xcc)

	D0 = 1
	if (objA0.flags38 & 0x01)
		D0.s16 = -D0.s16
	objA0.flags38 ^= 0x01
	objA0.position.y.u16 += D0.u16

	CheckGroundCollision()
	if (D1.s16 < 0)
	{
		u16 dx = (objA0.position.x.u16 & 0xff80) - level.despawn_position.x
		u16 dy = objA0.position.y.u16 - camera.position.y.u16 + 0x80
		if (dx <= (0x0280 + (ort.spawnfix ? 0x80 : 0)) && dy <= 0x0200)
			return

		camera.screenshake.state.hi = 0
		fn090368()
	}
	else
	{
		objA0.base_state = 0x04
		objA0.flags38 |= 0x28
		objA0.countdown_value = 0x27
		u16[A0 + 0x3a] = u16[0x0902ec + objA0.subtype2c]
		move_area.bottom.target = screenmover_target.bottom

		A2 = 0x090660
		fn084258()
	}
}

// LRZ Iwamodoki
//# address-hook(0x08faec) end(0x08fb36)
//# alias(fn08faec) deprecated
function void Iwamodoki.BaseUpdate()
{
	// Targets:
	//  - 0x08fb42	-> objA0.base_state = 0x00
	//  - 0x08fb4c	-> objA0.base_state = 0x02
	//  - 0x08fb70	-> objA0.base_state = 0x04
	call tableLookupAddress(0x08fb3c, objA0.base_state)

	D0.u16 = (objA0.position.x.u16 & 0xff80) - level.despawn_position.x
	if (D0.u16 <= (0x0280 + (ort.spawnfix ? 0x80 : 0)))
	{
		if (objA0.flags2a & 0x80)
		{
			fn08594e()
			return
		}

		D1 = 0x17
		D2 = 0x0c
		D3 = 0x0b
		D4.u16 = objA0.position.x.u16
		fn01dc56()

		DrawObject()
	}
	else
	{
		fn08594e()
		Enemy.UnloadDelayed()
	}
}

//-----//
// SSZ //
