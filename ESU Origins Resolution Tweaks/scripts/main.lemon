	PlatformCheckClimbOn()

	D0.u16 = (u16[A0 + 0x44] & 0xff80) - level.despawn_position.x
	if (D0.u16 <= (0x0280 + (ort.spawnfix ? 0x80 : 0)))
	{
		DrawObject()
	}
	else
	{
