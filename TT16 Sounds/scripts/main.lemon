global bool tt16s.monitor_sounds
global u8 tt16s.hcz_slide
global u8 tt16s.icz_slide
global u8 tt16s.soz_slide
global bool tt16s.soz_jump
global bool tt16s.dez2_elevator_sounds
global bool tt16s.dez2_button_sounds


global bool tt16s.monitorSoundTT16

// DEZ2 Elevator
//# address-hook(0x048d2c) end(0x048d60)
function void fn048d2c()
{
	if (!tt16s.dez2_elevator_sounds)
	{
		base.fn048d2c()
		return
	}

	if u16[A4 + 0x04] == 0
		Audio.playAudio("elevator_start")

	u16[A4 + 0x04] += 16
	
	if (u16[A4 + 0x04] == 0x0300)
	{
		D0.u16 = objA0.subtype2c & 0x7f
		u16[A4 + 0x06] = D0.u16
		u16[A4 + 0x08] = D0.u16 >> 1
		objA1.velocity.y = (objA0.flags2a & 0x02) ? 0x1000 : -0x1000
		u8[A4] += 2
		
		Audio.playAudio(objA0.flags2a & 0x02 ? "elevator_down" : "elevator_up")
	}

	fn048d66()
}

// DEZ2 Intro Cutscene
//# address-hook(0x07e3ca) end(0x07e3e8)
function void fn07e3ca()
{
	if (!tt16s.dez2_elevator_sounds)
	{
		base.fn07e3ca()
		return
	}
	
	if (objA0.groundspeed == 0)
		Audio.playAudio("elevator_start")
	
	objA0.groundspeed += 8
	if (objA0.groundspeed == 0x0300)
	{
		Audio.playAudio("elevator_up")
		objA0.update_address = 0x07e3ec
		objA0.countdown_value = 0x24
		u8[0xffffb000 + 0x0a] &= ~0x80
	}

	fn07eeee()
}

//# address-hook(0x07e3ec) end(0x07e41c)
function void fn07e3ec()
{
	if (!tt16s.dez2_elevator_sounds)
	{
		base.fn07e3ec()
		return
	}
	
	--objA0.countdown_value
	if (objA0.countdown_value < 0)
	{
		objA0.update_address = 0x07e420
		objA0.velocity.y = -0x1000

		A1 = 0xffffb000
		objA0.position.x.u16 = objA1.position.x.u16
		objA0.position.y.u16 = objA1.position.y.u16

		
	}

	u16[0xffffb000 + 0x14] -= 0x10
	fn07eeee()
}

// DEZ2 Gravity Buttons
//# address-hook(0x048ad6) end(0x048b3a)
function void fn048ad6()
{
	if (!tt16s.dez2_button_sounds)
	{
		base.fn048ad6()
		return
	}
	
	D1.u16 = 0x1b
	D2.u16 = 0x08
	D3.u16 = 0x09
	D4.u16 = objA0.position.x.u16
	fn01dc56()

	D6 = (D6 << 16) + (D6 >> 16)
	if (D6.u16 & 0x14)
	{
		objA0.animation.sprite = 1
		objA0.update_address = 0x048b7e
		u16[A0 + 0x30] = 3

		D0 = (objA0.render_flags & render_flag.FLIP_Y) ? -8 : 8		// D0 is used inside "fn048b40()"
		objA0.position.y.u16 += D0

		A1 = 0xffffb000
		D2.u16 = D6.u16
		D3.u16 = 0x14
		fn048b40()

		A1 = 0xffffb04a
		D2.u16 = D6.u16
		D3.u16 = 0x28
		fn048b40()

		Audio.playAudio(global.inv_gravity & 0x01 ? "gravity_switch_down" : "gravity_switch_up") 
	}

	DrawOrUnloadObject()
}

// Monitor Sounds
//# address-hook(0x01d716) end(0x01d7b6)
function void MonitorIntact.Opening()
{
	if (tt16s.monitor_sounds)
		tt16s.monitorSoundTT16 = true

	base.MonitorIntact.Opening()
}

function u64 Standalone.getModdedSoundKey(u64 soundKey, u8 sfxId, u8 soundRegType)
{
    if (tt16s.monitor_sounds && tt16s.monitorSoundTT16 && sfxId == 0x3D) // Badnik/Monitor Hit SFX
    {
		tt16s.monitorSoundTT16 = false
        return "tt16_monitor"
    }
	else if (tt16s.monitor_sounds && sfxId == 0x3D)
    {
		return "tt16_break"
	}
    else
    {
        return base.Standalone.getModdedSoundKey(soundKey, sfxId, soundRegType)
    }
}

// Water Slide
//# address-hook(0x050e90) end(0x050e98)
function void UpdateLevelTiles.HCZ2()
{
	base.UpdateLevelTiles.HCZ2()
	
	if tt16s.hcz_slide && u8[0xffffb000 + 0x20] == char.state.FALLING_PANIC && !(u8[0xffffb000 + 0x2a] & char.flag.IN_AIR) && !debug_mode.state
	{
		if (tt16s.hcz_slide == 1 && ((level.framecounter.low + 2) & 0x0f) == 0)
		{
			playSound(0xdb)
		}
		else if !Audio.isPlayingAudio(tt16s.hcz_slide == 3 ? "character_slide" : "ice_slide")
			Audio.playAudio(tt16s.hcz_slide == 3 ? "character_slide" : "ice_slide")
	}
}

// Ice Slide
//# address-hook(0x053662) end(0x053666)
function void UpdateLevelTiles.ICZ1()
{
	base.UpdateLevelTiles.ICZ1()
	
	if tt16s.icz_slide && u8[0xffffb000 + 0x20] == char.state.GOT_HURT_PANIC && !(u8[0xffffb000 + 0x2a] & char.flag.IN_AIR) && !debug_mode.state
	{
		if (tt16s.icz_slide == 1)
		{
			if ((level.framecounter.low & 0x0f) == 0)
			playSound(0xc8)
		}
		else if !Audio.isPlayingAudio(tt16s.icz_slide == 3 ? "character_slide" : "ice_slide")
			Audio.playAudio(tt16s.icz_slide == 3 ? "character_slide" : "ice_slide")
	}
}

// Mud/Sand Slide
//# address-hook(0x055a4c) end(0x055a54)
function void UpdateLevelTiles.SOZ1()
{
	base.UpdateLevelTiles.SOZ1()
	
	if tt16s.soz_slide && u8[0xffffb000 + 0x20] == char.state.GOT_HURT_PANIC && !(u8[0xffffb000 + 0x2a] & char.flag.IN_AIR) && !Audio.isPlayingAudio(tt16s.soz_slide == 2 ? "character_slide" : "mud_slide") && !debug_mode.state
		Audio.playAudio(tt16s.soz_slide == 2 ? "character_slide" : "mud_slide")
}

//# address-hook(0x0561bc) end(0x0561c8)
function void UpdateLevelTiles.SOZ2()
{
	base.UpdateLevelTiles.SOZ2()
	
	if tt16s.soz_slide && u8[0xffffb000 + 0x20] == char.state.GOT_HURT_PANIC && !(u8[0xffffb000 + 0x2a] & char.flag.IN_AIR) && !Audio.isPlayingAudio(tt16s.soz_slide == 2 ? "character_slide" : "mud_slide") && !debug_mode.state
		Audio.playAudio(tt16s.soz_slide == 2 ? "character_slide" : "mud_slide")
}

global bool tt16s.sandJump

function void playSound(u8 soundId)
{
	if (tt16s.soz_jump && tt16s.sandJump && soundId == SFX_JUMP)
	{
		Audio.playAudio("mud_jump")
		return
	}
	
	base.playSound(soundId)
}

// Mud/Sand Jump
//# address-hook(0x03fd4e) end(0x03fe42)
function void fn03fd4e()
{
	u8 bit = (1 << D6.u8)

	if ((objA0.flags2a & bit) != 0)
		tt16s.sandJump = true
		
	base.fn03fd4e()
	
	tt16s.sandJump = false
}

//# address-hook(0x03fe70) end(0x03ff7e)
function void fn03fe70()
{
	u8 bit = (1 << D6.u8)

	if ((objA0.flags2a & bit) != 0)
		tt16s.sandJump = true
		
	base.fn03fe70()
	
	tt16s.sandJump = false
}