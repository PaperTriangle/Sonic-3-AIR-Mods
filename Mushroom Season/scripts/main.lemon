global bool ms.mhzfade

//# address-hook(0x055008) end(0x055038)
function void fn055008()
{
	u16 px = camera.position.x.u16 + getScreenWidth() / 2
	u16 py = u16[0xffffb000 + 0x14]

	s16 extraPixels = max(s16(getScreenWidth() - 384), 0) / 2
	
	if (px >= 0x09c0 - extraPixels - 0x60 && px <= 0x09c0 + extraPixels + 0x60 && py >= 0x0700 && py <= 0x800)
	{
		mushroomFade(px, extraPixels, 0x09c0, 0x0a945c, 0x0a94bc)
		return
	}
	else if (px >= 0x2b40 - extraPixels - 0x60 && px <= 0x2b40 + extraPixels + 0x60 && py >= 0x0500 && py <= 0x600)
	{
		mushroomFade(px, extraPixels, 0x2b40, 0x0a94bc, 0x0550fe)
		return
	}
	else if (px >= 0x2940 - extraPixels - 0x60 && px <= 0x2940 + extraPixels + 0x60 && py >= 0x0200 && py <= 0x380)
	{
		mushroomFade(px, extraPixels, 0x2940, 0x0a94bc, 0x0550fe)
		return
	}
	
	if (px >= 0x400 && px <= 0x500)
	{
		mushroomFade(py, 0x18, 0x0678, 0x0a94bc, 0x0a945c)
		return
	}

	base.fn055008()
}

// New function for MVZ Palette transition
function void mushroomFade(u16 camPos, s16 width, u16 centrePoint, u32 palA1, u32 palA2)
{
	float fadeVal
	
	if (width > 0)
	{
		float fadeMult = 256.0f / (2.0f * width)
		fadeVal = min((min(max(camPos, centrePoint - width), centrePoint + width) - (centrePoint - width)) * fadeMult, 256)
	}
	else
	{
		fadeVal = camPos > centrePoint ? 256 : 0
	}

	if ms.mhzfade && (fadeVal > 0 && fadeVal < 256) 
	{
		if (ms.mhzfade == 2)
			fadeVal = 128
		else
			fadeVal = (fadeVal < 128 ? Math.ceil(fadeVal / 64) : Math.floor(fadeVal / 64) ) * 64
	}
	
	for (u8 i = 0; i < 31; i++)
	{
		u16[0xfffffc40 + i*2] = blendColorsPacked(u16[palA1 + i*2], u16[palA2 + i*2], Math.roundToInt(fadeVal))
	}
	
	mushroomGroundParticle(palA1, palA2, Math.roundToInt(fadeVal))
}

// New function to decide ground particle.
// u8[0xfffff7c1] = 0xff -> Leaves
// u8[0xfffff7c1] = 0x00 -> Pollen
function void mushroomGroundParticle(u32 palA1, u32 palA2, u16 fadeVal)
{
	if (palA2 == 0x0a94bc && fadeVal == 0x100) || (palA1 == 0x0a94bc && fadeVal == 0)
	{
		u8[0xfffff7c1] = 0xff
		u16[0xffffeed6] = 0xff
	}
	else if (palA2 == 0x0550fe && fadeVal == 0x100) || (palA1 == 0x0550fe && fadeVal == 0)
	{
		u8[0xfffff7c1] = 0xff
		u16[0xffffeed6] = 0
	}
	else
	{
		u8[0xfffff7c1] = 0
		u16[0xffffeed6] = 0
	}
}
