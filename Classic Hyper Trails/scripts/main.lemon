global bool cht.transparent
global u8 cht.number
global bool cht.super_tails
global bool cht.dynamic_trails

global s64 player1BackupKey[14]
global s64 tailsBackupKey[14] 
global u8 player1BackupAngle[14]
global u8 tailsBackupAngle[14] 

function bool Standalone.onWriteToSpriteTable(s16 px, s16 py, u16 renderQueue)
{
	if (A0 == 0xffffb000 || A0 == 0xffffb04a || objA0.mapping_offset == 0x344bb8)
	{
		System.setGlobalVariableValueByName("noRenderPlz", true)
		//System.setGlobalVariableValueByName("renderTransparentPlz", asSmallGhost)
		
		bool isPlayer1 = (A0 == 0xffffb000)
		u32 characterAddress = A0
		
		if (objA0.mapping_offset == 0x344bb8)
		{
			characterAddress = 0xffff0000 + u16[A0 + 0x30]
			isPlayer1 = (characterAddress == 0xffffb000)
		}
		
		bool returnVal = base.Standalone.onWriteToSpriteTable(px, py, renderQueue)

		System.setGlobalVariableValueByName("noRenderPlz", false)
		System.setGlobalVariableValueByName("renderTransparentPlz", false)

		bool useAfterImages = NT.AfterImages()
		bool useHyperImages = false
		bool useAfterShoes = false
		if (isPlayer1)
		{
			if ((super.active == 0xff) || (super.active.tails == 0xff && (Game.getSetting(SETTING_HYPER_TAILS) || !(!cht.super_tails && !Game.getSetting(SETTING_HYPER_TAILS)))))
			{
				useHyperImages = true
			}
			
			if (Game.getSetting(SETTING_SPEEDUP_AFTERIMGS))
			{
				useAfterShoes = ((u8[characterAddress + 0x2b] & char.bonus.SPEED_UP) != 0)
			}
		}
		
		if (cht.transparent)
			System.setGlobalVariableValueByName("renderTransparentPlz", true)
		
		u8 imageNumber = (cht.number < 4) ? cht.number : (useAfterShoes + useHyperImages + useAfterImages) * 2
		
		if (cht.number == 5)
			imageNumber = 1 + imageNumber / 2
		
		if ( (useAfterImages || useHyperImages || useAfterShoes) && lastKey != "")
		{
			for (s8 i = imageNumber; i > 0; --i)
			{
				A1 = 0xffffe500 + u8(posbackup.offset.player1 - (i * 8 + 4))
				s16 px0 = u16[A1] - camera.foreground.x.u16
				s16 py0 = u16[A1+2] - camera.foreground.y.u16
				if (level.vertical_wrap == 0xff00)	// Consider vertical level wrap
					py0 &= level.height.bitmask
				
				Renderer.setSpriteTagWithPosition(characterAddress + 0x10 + i, px0, py0)
				
				u64 renderKey = lastKey
				u8 renderAngle = lastAngle
				
				if (cht.dynamic_trails)
				{
					if (A0 == 0xffffb000 && player1BackupKey[cht.dynamic_trails == 2 ? i*2 : i] != "")
					{
						renderKey = player1BackupKey[cht.dynamic_trails == 2 ? i*2 : i]
						renderAngle = player1BackupAngle[cht.dynamic_trails == 2 ? i*2 : i]
					}
					else if (objA0.mapping_offset == 0x344bb8 && tailsBackupKey[cht.dynamic_trails == 2 ? i*2 : i] != "")
					{
						renderKey = tailsBackupKey[cht.dynamic_trails == 2 ? i*2 : i]
						renderAngle = tailsBackupAngle[cht.dynamic_trails == 2 ? i*2 : i]
					}
				}
				
				Renderer.drawCustomSprite(renderKey, px0, py0, lastAtex, lastFlags, lastRenderQueue - i, renderAngle, 0xd0 - i * (0x28 - 0x08 * ( (cht.number > 3) ? useAfterShoes + useHyperImages + useAfterImages : 0)))
			}		
		}
		

		
		if (cht.transparent)
			System.setGlobalVariableValueByName("renderTransparentPlz", false)
	
		return returnVal
	}
	else
		return base.Standalone.onWriteToSpriteTable(px, py, renderQueue)
}


function void Renderer.drawSprite(u64 key, s16 px, s16 py, u16 atex, u8 flags, u16 renderQueue, u8 angle, u8 alpha)
{
	if cht.dynamic_trails && (NT.PreventRendering(key) && alpha == 0xff && !NT.NotCharacter(key))
	{
		for (u8 i = 13; i > 0; i--)
		{
			if (A0 == 0xffffb000)
			{
				player1BackupKey[i] = player1BackupKey[i - 1]
				player1BackupAngle[i] = player1BackupAngle[i - 1]
			}
			else if (objA0.mapping_offset == 0x344bb8)
			{
				tailsBackupKey[i] = tailsBackupKey[i - 1]
				tailsBackupAngle[i] = tailsBackupAngle[i - 1]
			}
		}
		
		if (A0 == 0xffffb000)
		{
			player1BackupKey[0] = key
			player1BackupAngle[0] = angle
		}
		else if (objA0.mapping_offset == 0x344bb8)
		{
			tailsBackupKey[0] = key
			tailsBackupAngle[0] = angle
		}
	}

	base.Renderer.drawSprite(key, px, py, atex, flags, renderQueue, angle, alpha)
}

function void Renderer.drawSpriteTinted(u64 key, s16 px, s16 py, u16 atex, u8 flags, u16 renderQueue, u8 angle, u32 tintColor, s32 scale)
{
	u8 alpha = tintColor

	if cht.dynamic_trails && (NT.PreventRendering(key) && alpha == 0xff && !NT.NotCharacter(key))
	{
		for (u8 i = 13; i > 0; i--)
		{
			if (A0 == 0xffffb000)
			{
				player1BackupKey[i] = player1BackupKey[i - 1]
				player1BackupAngle[i] = player1BackupAngle[i - 1]
			}
			else if (objA0.mapping_offset == 0x344bb8)
			{
				tailsBackupKey[i] = tailsBackupKey[i - 1]
				tailsBackupAngle[i] = tailsBackupAngle[i - 1]
			}
		}
		
		if (A0 == 0xffffb000)
		{
			player1BackupKey[0] = key
			player1BackupAngle[0] = angle
		}
		else if (objA0.mapping_offset == 0x344bb8)
		{
			tailsBackupKey[0] = key
			tailsBackupAngle[0] = angle
		}
	}
	
	base.Renderer.drawSpriteTinted(key, px, py, atex, flags, renderQueue, angle, tintColor, scale)
}