define u32 char.ADDRESS_P1 = 0xffffb000
define u32 char.ADDRESS_P2 = 0xffffb04a

global u8 kr.frames

//--------
// Rolling
//--------

function void yieldExecution()
{
	if (global.zone_act == 0x0001)
		System.loadExternalRawData("AIZ2_Cliff_Collision", 0x020e9e)

	keepRollin(char.ADDRESS_P1)
	keepRollin(char.ADDRESS_P2)

	base.yieldExecution()
}

function void keepRollin(u32 AX)
{
	u32 backupA0 = A0
	A0 = AX
	
	if (char.state == char.state.ROLLING) && (char.look_up_down_timer > 0)
		char.look_up_down_timer--
	
	if (char.jumping > 0) || (kr.frames < 0x10 && char.velocity.x == 0)
		char.look_up_down_timer = 0
	else if (char.state == char.state.ROLLING) && !(char.flags & char.flag.IN_AIR)
		char.look_up_down_timer = kr.frames
		
	A0 = backupA0
}

//# address-hook(0x012172) end(0x012178)
//# address-hook(0x01560c) end(0x01569a)
function void Character.LandingOnGround()
{
	if (char.state == char.state.ROLLING) && (char.look_up_down_timer > 0)
		Character.LandingOnGroundResetState()
	else
		base.Character.LandingOnGround()
}

//# address-hook(0x01217e) end(0x012230)
//# address-hook(0x015618)
//# address-hook(0x017b24) end(0x017bb4)
function void Character.LandingOnGroundNoSpindash()
{
	if (char.state == char.state.ROLLING) && (char.look_up_down_timer > 0)
		Character.LandingOnGroundResetState()
	else
		base.Character.LandingOnGroundNoSpindash()
}

// Keep rolling on LBZ Spring Launcher
//# address-hook(0x0261f2) end(0x026296)
function void fn0261f2()
{
	base.fn0261f2()

	if (objA1.state != char.state.ROLLING) && (u8[A1 + 0x39] > 0)
	{
		u8[A1 + 0x2a] |= char.flag.ROLLING
		objA1.hitbox_extends.x = char.hitbox.x.ROLLING
		objA1.hitbox_extends.y = char.hitbox.y.ROLLING
		objA1.state = char.state.ROLLING
		s8 dy = (u8[A1 + 0x38] == CHARACTER_TAILS) ? 1 : 5
		objA1.position.y.u16 += (global.inv_gravity) ? -dy : dy
	}
}

// Prevent Rolling in FBZ Vertical Cylinder
//# address-hook(0x03a0d6) end(0x03a21a)
function void fn03a0d6()
{	

	u8 bit = (1 << D6.u8)

	if ((objA0.flags2a & bit) == 0)
	{
		D0.u16 = objA1.position.x.u16 - objA0.position.x.u16 + 0x80
		if (D0.u16 >= 0x0100)
			return

		D1.u16 = objA1.position.y.u16 - objA0.position.y.u16 + D4.u16
		if (D1.u16 >= D5.u16)
			return

		if (u8[A1 + 0x05] >= base_state.DIED || debug_mode.state != 0 || s8[A1 + 0x2e] < 0)
			return

		if (D0.u16 >= 0x20 && D0.u16 < 0xe0)
			return
	}

	base.fn03a0d6()

	objA1.flags2a |= char.flag.IN_AIR
}