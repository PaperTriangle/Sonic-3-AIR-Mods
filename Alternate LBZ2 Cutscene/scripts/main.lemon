// We cut a lot from this section as we are doing the winning poses later
// We also skip straight to 0x072c0a, spawning 0x072d24 there instead!
//# address-hook(0x072b46) end(0x072b94)
function void fn072b46()
{
	objA0.update_address = 0x072bbc
	addPatternLoadingCue(0x083d64)		// Boss explosion sprites
}

//# address-hook(0x072bbc) end(0x072c04)
function void fn072bbc()
{
	objA0.update_address = 0x072c0a
	objA0.flags38 |= 0x20	// This makes the explosions stop
	u16[0xfffffaa4] = A0.u16


	if (allocDynamicObjectStd())
	{
		objA1.update_address = 0x0863c0
	}

	Kosinski.addToDMAQueue(0x37921c, 0x95c0)		// Death Egg falling in the distance

	if (!Mods.isModActive("Origins Parity Galore") || !Game.getSetting(SETTING_LBZ_BIGARMS))
	{
		spawnSimpleChildObjects(0x072d24, 2)
	}
}

// Moves the player to the middle before progressing the cutscene.
//# address-hook(0x072c0a) end(0x072c62)
function void fn072c0a()
{
	A1 = 0xffffb000

	player1.control_override = 0xff
	control.player1 = 0

	D0.s16 = camera.position.x.u16 + getScreenWidth() / 2 - objA1.position.x.u16
	if (abs(D0.s16) < 4)
	{
		objA0.update_address = 0x072c68
		u8[0xfffffa88] = 0
		StopObjectA1()

		objA1.render_flags &= ~render_flag.FLIP_X
		u8[A1 + 0x2a] &= ~char.flag.FACING_LEFT

		control.player1 = 0x0101		// CONTROL_UP, CONTROL_UP

	}
	else
	{
		D1 = (D0.s16 < 0) ? 2 : 3		// CONTROL_LEFT : CONTROL_RIGHT
		control.player1.state |= (1 << D1.u8)
	}
}

//# address-hook(0x072c68) end(0x072c9c)
function void fn072c68()
{
	if (getNumPlayers() >= 2)
	{
		// Make Tails stop next to Sonic
		if s16[0xffffb04a + 0x18] > 0 && (u16[0xffffb04a + 0x10] > u16[0xffffb000 + 0x10] - 0x30)
		{
			u16[0xffffb04a + 0x18] -= min(u16[0xffffb04a + 0x18], 0xa0)
			u16[0xffffb04a + 0x1c] -= min(u16[0xffffb04a + 0x1c], 0xa0)
		}
	}
		
	base.fn072c68()
}

//# address-hook(0x072dea) end(0x072e4e)
function void fn072dea()
{

	--objA0.countdown_value
	
	if Mods.isModActive("Origins Screen Resolution") && (objA0.countdown_value == 0)
	{
		VDP.setupVRAMWrite(0x0960)
		VDP.zeroVRAM(0x95c0 - 0x0960)		
	}
	
	if (objA0.countdown_value < 0)
	{
		++objA0.value39
		if (objA0.value39 == 0x08)
		{
			u8[0xffffeec6] = 0xff
		}

		if (objA0.value39 == 0x18 && !altlbz2cs.fadeadjust) // Results here if we do not change the fade point.
		{
			objA0.update_address = 0x072e2e
			objA0.countdown_value = 0x003f
			
			level.wait_for_results = 0xff
			control.player1 = 0
			A1 = 0xffffb000
			StartCharacterWinPose()
			level.results_done = 0
			
			if (allocDynamicObjectStd())
			{
				// Level results
				objA1.update_address = addressof(LevelResults.Update)
			}
			
			if (allocDynamicObjectStd())
			{
				// Win pose for Tails
				objA1.update_address = 0x072cfa
			}
			
			Game.onZoneActCompleted(global.zone_act.apparent)
			
			fn072e2e()
			return
		}
		
		if (objA0.value39 >= 0xff && altlbz2cs.fadeadjust)
		{
			u16[A0 + 0x48] = 0
			objA0.update_address = 0x072e30
		}

		if (objA0.value39 < 0x18)
		{
			objA0.countdown_value = u16[A0 + 0x3a]
			++u16[A0 + 0x3a]
			if (allocDynamicObjectStd())
			{
				objA1.update_address = 0x072e54
			}
		}
	}
}

// make debris fall infront sometimes...
//# address-hook(0x072e54) end(0x072e94)
function void fn072e54()
{
	base.fn072e54()
	
	objA0.position.x.u16 += getScreenExtend()
	
	if (level.framecounter & 1)
	{
		objA0.sprite_priority = 0x0080
		objA0.sprite_attributes |= sprite_attribute.PRIORITY
	}
}

// This is the function that handles the sky fading back
//# address-hook(0x072e30)
function void fn072e30()
{
	if (!altlbz2cs.fadeadjust || u16[A0 + 0x48] < 48) // Ignore the steps that handle fading logic
	{
		base.fn072e30()
		return
	}

	if (u16[A0 + 0x48] == 48)
	{
		if (Mods.isModActive("Better Big Arm Fade")) // We want to use the saved palette values here
		{
			u16[0xfffffc00 + 0x3b * 2] = System.getGlobalVariableValueByName("bigarmfade.p1")
			u16[0xfffffc00 + 0x3c * 2] = System.getGlobalVariableValueByName("bigarmfade.p2")
			u16[0xfffffc00 + 0x3d * 2] = System.getGlobalVariableValueByName("bigarmfade.p3")
			u16[0xfffffc00 + 0x3e * 2] = System.getGlobalVariableValueByName("bigarmfade.p4")
		}
		else
		{
			u16[0xfffffc00 + 0x3b * 2] = 0x0ece
			u16[0xfffffc00 + 0x3c * 2] = 0x0e8a
			u16[0xfffffc00 + 0x3d * 2] = 0x0e48
			u16[0xfffffc00 + 0x3e * 2] = 0x0e46
		}

	}
	else if (u16[A0 + 0x48] == 68)
	{
		// We do the results here if we are change the fade point.
		objA0.update_address = 0x072e2e
		objA0.countdown_value = 0x003f
		
		level.wait_for_results = 0xff
		control.player1 = 0
		A1 = 0xffffb000
		StartCharacterWinPose()
		level.results_done = 0
		
		if (allocDynamicObjectStd())
		{
			// Level results
			objA1.update_address = addressof(LevelResults.Update)
		}
		
		if (allocDynamicObjectStd())
		{
			// Win pose for Tails
			objA1.update_address = 0x072cfa
		}
		
		Game.onZoneActCompleted(global.zone_act.apparent)
		
		fn072e2e()
		return
	}
	
	++u16[A0 + 0x48]
}

//# address-hook(0x072e2e)
function void fn072e2e()
{
	if (!level.results_done)
		return
	
	Game.startSkippableCutscene()
	
	if (altlbz2cs.removehud)
	{
		if (altlbz2cs.dangerhud == 0)
		{
			if (global.level_started > -0x70)
				global.level_started = global.level_started - 0x10
				
			if (global.level_started <= -0x70)
				altlbz2cs.hudgobye = 1
		}
		else
		{
			if (altlbz2cs.hudgobyedanger < 0x100)
				altlbz2cs.hudgobyedanger = altlbz2cs.hudgobyedanger + 8
		}
	}
	
	if (altlbz2cs.restoremusic)
		PlayMusicAfterLevelResults()

	stopCharacterWinPose(0xffffb000)
	stopCharacterWinPose(0xffffb04a)


	if (Mods.isModActive("LBZ Eggman Fleeing"))
	{
		System.setGlobalVariableValueByName("cutscenenumer", 383)
		System.setGlobalVariableValueByName("ZNA_LBZEF_starttime", timer.alldata)
	}
	
	--objA0.countdown_value
	if (objA0.countdown_value >= 0)
		return

	u8[0xfffffa88] |= 0x01
	objA0.value39 = 0
	objA0.countdown_value = 0

	// "spawnChildObjects(0x07380c)" replaced by:
	spawnChildObject(0x072e9e, 0x00, 0, 0)
	spawnChildObject(0x072e9e, 0x02, -16, 40)
	spawnChildObject(0x072e9e, 0x04, -112, 0)
	spawnChildObject(0x072e9e, 0x06, -72, 40)
	spawnChildObject(0x072e9e, 0x08, 24, 16)
	spawnChildObject(0x072e9e, 0x0a, -36, -8)
	spawnChildObject(0x072e9e, 0x0c, -80, 28)

#if STANDALONE
	if (Game.getSetting(SETTING_LBZ_BIGARMS) && !altlbz2cs.fadeadjust)
	{
		// Go into another state before unloading, to lighten up the sky again
		u16[A0 + 0x48] = 0
		objA0.update_address = 0x072e30
	}
	else
#endif
	{
		Object.TriggerUnloading()
	}
}

// Stops the invisible walls from being spawned
// and spawns updrafts if needed.
// Also includes the exhaust flashing.
//# address-hook(0x08d47c) end(0x08d4c6)
function void fn08d47c()
{
	
	// Make the Death Egg launch exhaust flash
	if (altlbz2cs.deflash)
	{
		// Here we are changing the tiles to be rendered each frame.
		if (level.framecounter & 1)
		{
			u8[0xffff896f] = 0x00
			u8[0xffff8970] = 0x00
			u8[0xffff8974] = 0x00
			u8[0xffff8975] = 0x00
			u8[0xffff8978] = 0x00
			u8[0xffff8979] = 0x00
		}
		else
		{
			u8[0xffff896f] = 0xa6
			u8[0xffff8970] = 0xa7
			u8[0xffff8974] = 0xa6
			u8[0xffff8975] = 0xa7
			u8[0xffff8978] = 0xa6
			u8[0xffff8979] = 0xa7
		}
		// This function here re-renders the tiles, without it the changes are not applied while the tiles are on the screen.
		fillPlaneA_Default(camera.foreground.x.u16, camera.foreground.y.u16, getScreenWidth(), getScreenHeight())
	}
	
	if (altlbz2cs.removewalls == 0)
	{
		base.fn08d47c()

		// We will still play the jump sound regardless of settings.
		if (objA0.position.x.u16 >= 0x4440)
		{
			playSound(0x62)
			//move_area.bottom.target += (getScreenHeight() - 224)/2 // Origins Resolution for boss arena
		}

		return
	}
	
	fn0847e6()
	UpdateMovementStraightSimple()
	fn08d506()

	if (objA0.position.x.u16 >= 0x4440)
	{
		// Character jumps out of the mobile
		objA0.update_address = 0x08d4cc
		camera.screenshake.state = 0

		A1 = 0xffffb000
		objA1.velocity.x = -0x100
		objA1.velocity.y = -0x600
		objA1.state = char.state.ROLLING
		objA1.flags2a |= char.flag.IN_AIR
		u8[A1 + 0x2e] = 0
		u8[A1 + 0x40] = 0

	#if STANDALONE
		Game.endSkippableCutscene()

		if (altlbz2cs.removewalls == 1)
		{
			// Create updraft elements so the player cannot fall off the platform
			for (u16 i = 0; i < 2; ++i)
			{
				if (allocDynamicObjectStd())
				{
					objA1.update_address = 0x03fb90
					objA1.position.x.u16 = (i == 1) ? 0x4519 : 0x4347
					objA1.position.y.u16 = 0x0755
					objA1.subtype2c = 0x01
				}
			}
		}
	#endif
	}

	fn08d53e()
	DrawObject()

	// Added in a jump sound when they exit the Egg Mobile
	if (objA0.position.x.u16 >= 0x4440)
	{
		playSound(0x62)
		//move_area.bottom.target += (getScreenHeight() - 224)/2 // Origins Resolution for boss arena
	}

}

// Fix for getting hurt and falling into updrafts
//# address-hook(0x03fbc4) end(0x03fcd2)
function void fn03fbc4()
{
	if (altlbz2cs.removewalls != 1)
	{
		base.fn03fbc4()
		return
	}

	if (global.zone == 0x06 && (camera.position.x.u16 > 0x4350 && u16[A1 + 0x14] > 0x072c) && u8[A1 + 0x05] == base_state.HURT) // Otherwise they fall through to their death!
	{
		u8[A1 + 0x05] = base_state.NORMAL
	}
	
	base.fn03fbc4()
}

// Alt HUD removal
// ...I do not want to document this...
// It was annoying...

function void HUD.drawSprite(u64 key, u16 px, u16 py, u16 renderQueue)
{
	if (altlbz2cs.dangerhud == 3 && altlbz2cs.hudgobyedanger != 0)
		return
	
	if (altlbz2cs.dangerhud == 0 || debug_mode.state || !altlbz2cs.removehud || altlbz2cs.hudgobyedanger == 0)
	{
		base.HUD.drawSprite(key, px, py, renderQueue)
		return
	}
		
	if (px > getScreenWidth() / 2)
		Renderer.drawCustomSprite(key, px + altlbz2cs.hudgobyedanger, py, 0, SPRITE_FLAG_PRIO, renderQueue)
	else
		Renderer.drawCustomSprite(key, px - altlbz2cs.hudgobyedanger, py, 0, SPRITE_FLAG_PRIO, renderQueue)
}

function void HUD.drawDigit(u8 digit, u16 px, u16 py, u16 renderQueue)
{	
	if (altlbz2cs.dangerhud == 3 && altlbz2cs.hudgobyedanger != 0)
		return
	
	if (altlbz2cs.dangerhud != 2 || debug_mode.state || !altlbz2cs.removehud || altlbz2cs.hudgobyedanger == 0)
	{
		base.HUD.drawDigit(digit, px, py, renderQueue)
		return
	}
	
	if (px > getScreenWidth() / 2)
		Renderer.drawCustomSprite(stringformat("hud_digit_%d", digit), px + altlbz2cs.hudgobyedanger, py, 0, SPRITE_FLAG_PRIO, renderQueue)
	else
		Renderer.drawCustomSprite(stringformat("hud_digit_%d", digit), px - altlbz2cs.hudgobyedanger, py, 0, SPRITE_FLAG_PRIO, renderQueue)
}

function void HUD.drawNumber(string stringMask, u32 number, u16 px, u16 py, u16 renderQueue)
{
	if (altlbz2cs.dangerhud == 3 && altlbz2cs.hudgobyedanger != 0)
		return
	
	if (altlbz2cs.dangerhud != 2 || debug_mode.state || !altlbz2cs.removehud || altlbz2cs.hudgobyedanger == 0)
	{
		base.HUD.drawNumber(stringMask, number, px, py, renderQueue)
		return
	}
	while (true)
	{
		u8 digit = number % 10
		
		if (px > getScreenWidth() / 2)
			Renderer.drawCustomSprite(stringformat(stringMask, digit), px + altlbz2cs.hudgobyedanger, py, 0, SPRITE_FLAG_PRIO, renderQueue)
		else
			Renderer.drawCustomSprite(stringformat(stringMask, digit), px - altlbz2cs.hudgobyedanger, py, 0, SPRITE_FLAG_PRIO, renderQueue)
	
		px -= 8
		number /= 10
		if (number == 0)
			break
	}
}

function void HUD.drawSmallDigit(u8 digit, u16 px, u16 py, u16 renderQueue)
{
	if (altlbz2cs.dangerhud == 3 && altlbz2cs.hudgobyedanger != 0)
		return
		
	if (altlbz2cs.dangerhud != 2 || debug_mode.state || !altlbz2cs.removehud || altlbz2cs.hudgobyedanger == 0)
	{
		base.HUD.drawSmallDigit(digit, px, py, renderQueue)
		return
	}
	
	if (px > getScreenWidth() / 2)
		Renderer.drawCustomSprite(stringformat("hud_smalldigit_%d", digit), px + altlbz2cs.hudgobyedanger, py, 0, SPRITE_FLAG_PRIO, renderQueue)
	else
		Renderer.drawCustomSprite(stringformat("hud_smalldigit_%d", digit), px - altlbz2cs.hudgobyedanger, py, 0, SPRITE_FLAG_PRIO, renderQueue)
}

// HUD removal flags

function void yieldExecution()
{
	if (altlbz2cs.hudgobye && altlbz2cs.dangerhud == 0)
		global.level_started = -0x7f

	base.yieldExecution()	
}

// Remove the flags on loading titlecards.
//# address-hook(0x02d856) end(0x02d8dc)
function void TitleCard.Show()
{
	altlbz2cs.hudgobye = 0
	altlbz2cs.hudgobyedanger = 0
	altlbz2cs.byebye_chair = 0

	base.TitleCard.Show()
}

// Origins Parity Galore Compatability 
//# address-hook(0x0746f4) end(0x074734)
function void fn0746f4()
{
	base.fn0746f4()

	if (Mods.isModActive("Origins Parity Galore"))
    {
		if (camera.position.y.u16 >= 0x0500)
		{
			// This is when the bounce collides with the ground
			if (System.getGlobalVariableValueByName("OPG_EggTimer") == 2)
			{
				// Spawning these starts everything up!
				spawnSimpleChildObjects(0x072d24, 2)
				
				// It should be fine to set this to 3.
				System.setGlobalVariableValueByName("OPG_EggTimer", 3)
			}
		}
	}
}

// Stop Music at Defeat
//# address-hook(0x074fd2) end(0x07508c)
function void fn074fd2()
{
	base.fn074fd2()
	
	if (altlbz2cs.stopmusic == 1 && objA0.update_address == 0x08566a)
		Standalone.playAudio(MUSIC_CTRL_FADEOUT)
	else if (altlbz2cs.stopmusic == 2 && objA0.update_address == 0x08566a)
		objA0.update_address = 0x085668
}

// Restore music for Knuckles
//# address-hook(0x07473a) end(0x074764)
function void fn07473a()
{
	if (level.wait_for_results || u8[0xfffffaa2] == 0)
		return

	if (altlbz2cs.restoremusic)
		PlayMusicAfterLevelResults()

	base.fn07473a()
}

// Extra Cutscene Jump Height

//# address-hook(0x0549c6) end(0x054a92)
function void fn0549c6()
{
	if (u8[0xffffb000 + 0x05] >= base_state.DIED)
		return

	if (player1.camera_lock)
	{
		D0.u16 = u16[0xffffb000 + 0x10] - camera.position.x.u16 - getScreenWidth() / 2
		if (D0.s16 >= 0)
		{
			camera.position.x.u16 += D0.u16
		}

		// Camera reached boss fight area?
		if (camera.position.x.u16 >= 0x4390 - getScreenExtend() || camera.position.y.u16 >= 0x0668 - (getScreenHeight() - 224)/2)
		{
			player1.camera_lock = 0
		}
	}

	if (u16[0xffffeee0] != 0)
	{
		--u16[0xffffeee0]
	}
	else
	{
		if (camera.position.x.u16 >= 0x4390 - getScreenExtend())
		{
			#if STANDALONE
			{
				// TODO: It would be nice to limit the character move area independently from the camera
				move_area.left = 0x4390 - getScreenExtend()
				move_area.right = 0x4390 + getScreenExtend()
			}
			#else
			{
				move_area.left = move_area.right
			}
			#endif
		}

		// This check is what is removed.
		if (!altlbz2cs.highjump) && (camera.position.y.u16 >= 0x0668 - (getScreenHeight() - 224)/2)
		{
			level.vertical_wrap = move_area.bottom.target
		}

		A1 = 0xffffeed4
		D1 = u16[0xffffeea2]
		u32[A1] += D1
		D0.u16 = u16[A1] - u16[A1 + 0x08]
		u16[A1 + 0x08] = u16[A1]

		D1.u16 = 0x2200
		if (player1.camera_lock == 0)
		{
			D1 = u32[0xffffee9c]
		}
		u32[A1 + 0x04] += D1

		D1.u16 = u16[A1 + 0x04] - u16[A1 + 0x0a]
		u16[A1 + 0x0a] = u16[A1 + 0x04]
		if (player1.camera_lock != 0)
		{
			A5 = 0xffff0000 + level.display_routine
			u16[A5 + 0x14] += D0.u16
			camera.position.y.u16 += D0.u16
		}

		D2.u16 = water.height.target + D0.u16 + D1.u16
		if (D2.u16 >= 0x0f00)
		{
			D2.u16 = 0x0f80
		}
		water.height.target = D2.u16
		u16[0xffffeee6] = D0.u16
		u16[0xffffeee6] += D1.u16
	}
}

//# address-hook(0x0729de) end(0x072a4e)
function void fn0729de()
{
	if (!altlbz2cs.highjump)
	{
		base.fn0729de()
		loadPaletteLine1(0x073886)
		return
	}
	
	// Set this value here, since we removed it from 0x0549c6
	level.vertical_wrap = move_area.bottom.target
	
	loadPaletteLine1(0x073886)
	
	base.fn0729de()
}

// Makes Eggman go straight up after defeat.
//# address-hook(0x073056)
function void fn073056()
{
	if (!altlbz2cs.eggup)
	{
		base.fn073056()
		return
	}
	
	// Wait for Robotnik to leave the screen to the top
	D0.u16 = objA0.position.y.u16 - 1
	D1.u16 = camera.position.y.u16 - 0x50
	if (D0.u16 >= D1.u16)
	{
		objA0.position.y.u16 = D0.u16
		DrawObject()
		u16[A0 + 0x48] = 0
	}
	else
	{
		objA0.position.y.u16 = D1.u16
		objA0.flags38 |= 0x20									// Stop the explosions
		objA0.sprite_attributes &= ~sprite_attribute.PRIORITY	// Draw him in background
		objA0.update_address = 0x07305a							// Skipping 0x073058.
	}
}

// Tails taking flight to the boss arena

//# address-hook(0x08d370) end(0x08d384)
function void fn08d370()
{
	// Make tails use the CNZ fly away routine.
	if (altlbz2cs.tailsflight && camera.position.x.u16 < 0x3bc8 && (s16[0xffffb04a + 0x1a] == 0 || u8[0xffffb04a + 0x20] == char.state.TAILS_FLYUP || u8[0xffffb04a + 0x20] == char.state.TAILS_FLYDOWN))
		tails.ai_routine = 0x10
	
	base.fn08d370()
}

#if STANDALONE
function void LBZ2MidBossCutscene.stopTailsFromSuicide()
{
	if (!altlbz2cs.tailsflight)
	{
		base.LBZ2MidBossCutscene.stopTailsFromSuicide()
		return
	}
	
	if (camera.position.x.u16 >= 0x3bc8)
	{
		u32 backupA0 = A0
		A0 = 0xffffb04a
		RespawnTails()
		A0 = backupA0
	}
	else if (u16[0xffffb000 + 0x10] > 0x3bd9 && (u8[0xffffb04a + 0x20] == char.state.TAILS_FLYUP || u8[0xffffb04a + 0x20] == char.state.TAILS_FLYDOWN)) // We want tails to move to the right while flying.
	{
		level.vertical_wrap = camera.position.y.u16 - 0x20 // Otherwise tails bangs his head on the top of the screen.
		u16[0xffffb04a + 0x18] += 0x04
	}
	else if (u16[0xffffb04a + 0x10] >= 0x3bb0)
	{
		u16[0xffffb04a + 0x10] = 0x3bb0
		u16[0xffffb04a + 0x14] = min(u16[0xffffb04a + 0x14], 0x0630)
		u16[0xffffb04a + 0x18] = 0
		u16[0xffffb04a + 0x1c] = 0
	}
}
#endif

//# address-hook(0x01408a) end(0x0140c4)
function void fn01408a()
{
	tails.control_counter = 0
	tails.flight_countdown = 0xf0
	control.tails = (level.framecounter.low & 0x0f) ? 0 : 0x7878		// (CONTROL_ABC | CONTROL_RIGHT), (CONTROL_ABC | CONTROL_RIGHT)

	if (!(objA0.render_flags & render_flag.VISIBLE))
	{
		if (global.zone_act != 0x0601) // This is so we do not despawn tails in LBZ2!
		{
			objA0.update_address = 0
		}
		objA0.position.x.u16 = 0
		objA0.position.y.u16 = 0
		tails.ai_routine = 0x0a
	}
}

