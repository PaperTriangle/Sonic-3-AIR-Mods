// Add extra time to the countdown to account for game clear sound being longer.
//# address-hook(0x02dae6) end(0x02dbc8)
function void fn02dae6()
{
	base.fn02dae6()
	
	if (altlbz2cs.gameclear > 0 && camera.position.y.u16 > 0x0500 && global.zone_act == 0x0601)
		objA0.countdown_value = 670
}


// Play game clear sound here
//# address-hook(0x02dc36) end(0x02dd38)
function void LevelResults.UpdateBonusCounting()
{
	// Only play game clear sound given these conditions
	if (altlbz2cs.gameclear > 0 && camera.position.y.u16 > 0x0500 && camera.position.x.u16 > 0x0400 && global.zone_act == 0x0601) 
	{
		if (objA0.countdown_value != 0)
		{
			--objA0.countdown_value
			if (objA0.countdown_value != 599) // Value here is larger to account for longer sample
				return

			// Reset char.drown_countdown for both characters
			u8[0xffffb000 + 0x2c] = 30
			u8[0xffffb04a + 0x2c] = 30

			playMusic(MUSIC_GAMECLEAR)
			return
		}
	}
	else // Original logic here
	{
		if (objA0.countdown_value != 0)
		{
			--objA0.countdown_value
			if (objA0.countdown_value != 289)
				return

			// Reset char.drown_countdown for both characters
			u8[0xffffb000 + 0x2c] = 30
			u8[0xffffb04a + 0x2c] = 30

			playMusic(MUSIC_LEVELCLEAR)
			return
		}
	}

	u16 delta = 10
#if STANDALONE
	if (Game.getSetting(SETTING_LEVELRESULT_SCORE))
	{
		// Count faster over time
		if (results.total_bonus >= 3000)
			delta = 30
		else if (results.total_bonus >= 1000)
			delta = 20

		// Allow for manually (more or less) skipping the counter
		if ((control.pad1.state & (CONTROL_ABC | CONTROL_START)) || Input.buttonDown(BUTTON_Y))
		{
			delta = 200
		}
	}
#endif

	D0 = 0
	if (results.time_bonus != 0)
	{
		u16 diff = min(delta, results.time_bonus)
		D0.u16 += diff
		results.time_bonus -= diff
	}
	if (results.ring_bonus != 0)
	{
		u16 diff = min(delta, results.ring_bonus)
		D0.u16 += diff
		results.ring_bonus -= diff
	}

	results.total_bonus += D0.u16
	if (D0.u16 != 0)
	{
		// Still counting
		addScore(D0)
		if ((level.framecounter & 0x03) == 0)
		{
			playSound(SFX_CLICK)
		#if STANDALONE
			Input.setControllerRumble(-1, 0.0f, 0.25f, 100)
		#endif
		}
	}
	else
	{
		// Done
		playSound(0xb0)

		// Special handling for Sky Sanctuary Zone (S/T) and probably also Lava Reef Boss
		if (global.zone_act == 0x0a00 || u16[A0 + 0x2c] != 0)
		{
			sram.block_interrupts.u8 = 0xff
			SaveGameOnLevelFinished()
		}

		objA0.countdown_value = 90
		objA0.base_state += 2
		LevelResults.AdvanceToNextAct()
	}
}

// Use Sonic 3's gameclear if enabled
function u64 Standalone.getModdedSoundKey(u64 soundKey, u8 sfxId, u8 soundRegType)
{
	if (altlbz2cs.gameclear == 2 && camera.position.y.u16 > 0x0500 && global.zone_act == 0x0601)
	{
		if (soundKey == MUSIC_GAMECLEAR)
		{
			return soundKey = "32_sonic3"
		}
	}
	
    return base.Standalone.getModdedSoundKey(soundKey, sfxId, soundRegType)
}

// Origins Resolution Compat & Function Replacements

// Origins Eggman fleeing and Origins Resolution fix
//# address-hook(0x072e9e) end(0x072ed4)
function void fn072e9e()
{
	base.fn072e9e()
	
	if Mods.isModActive("LBZ Eggman Fleeing") && Mods.isModActive("Origins Screen Resolution") && (System.getGlobalVariableValueByName("screen_width") > 0)
		objA0.velocity.y += (getScreenHeight() - 224)/2
}

// Adjust vertical screen boundaries for LBZ2 Knuckles punch cutscene through bosses to account for screen height.
// We also initialize unused.lives_counter.player2 here as a timer for shifting the Death Egg image at the end of the level.
// Change: Only use getScreenHeightExtend()/2 for this.
//# address-hook(0x05449a) end(0x054504)
function void fn05449a()
{
	if (u16[0xffffeec6] == 0)
	{
		UpdateBackground.LBZ2()
		fn0544a4()
		return
	}

	unused.lives_counter.player2 = 0	// new; this unused byte in ROM is repurposed as a timer for shifting the Death Egg image in the act ending cutscene

	u16[0xffffeec6] = 0
	u16[A3] = u16[A3 + 0x08]
	u16[A3 + 0x04] = u16[A3 + 0x0c]
	move_area.right = 0x4390 + getScreenExtend()
	move_area.bottom.current = 0x0668 - (getScreenHeight() - 224)/2
	move_area.bottom.target = 0x0668 - (getScreenHeight() - 224)/2
	u16[0xffffeee0] = 0x3c
	u16[0xffffeea2] = 0x1e00
	u32[0xffffee9c] = 0x6200
	player1.camera_lock = 0xff
	u8[0xffffef40] = 0xff
	level.scrolling_routine += 4

	fn054508()
}

// I adjust this because it appears to be a pixel off.
// I also add the extra graphic to cover the jump with unlocked camera
function void Renderer.drawCustomSprite(u64 key, s16 px, s16 py, u8 atex, u8 flags, u16 renderQueue)
{
	if (key == "lbz2_death_egg_platform" || key == "lbz2_death_egg_platformsupport" || key == "lbz2_death_egg_platformsupport" || key == "lbz2_death_egg")
		if (camera.position.x.u16 < 0x4340)
			return
		else if (unused.lives_counter.player2 >= 0x60)
			renderQueue = 0x9e04

	if (key == "lbz2_death_egg")
	{
		Renderer.drawSprite("death_egg_extension", px + 464, py - 56, u16(atex), SPRITE_FLAG_WORLDSPACE | SPRITE_FLAG_PRIO, renderQueue)
		
		if (flags != SPRITE_FLAG_WORLDSPACE)
			py -= (getScreenHeight() - 224)/2
	}
	
	Renderer.drawSprite(key, px, py, u16(atex), flags, renderQueue)
}

// Adjust horizontal screen boundary for LBZ2 ball shooter boss.
// The default 0x39b8 value causes a slight camera jump at wide resolutions, including 426x240.
// I mix this up a bit to be more like origins.
//# address-hook(0x07397a) end(0x07399c)
function void fn07397a()
{
	if ((objA0.flags38 & 0x80) == 0)
		return

	objA0.base_state = 0x06
	player1.camera_lock = 1

	if (getScreenWidth() > 320)
	{
		move_area.left = 0x3a20 - getScreenExtend() * 3
		move_area.right = 0x3a20 - getScreenExtend() 
	}
	else
	{
		move_area.left = 0x39f0
		move_area.right = 0x39f0
	}
}

// I mix this up a bit to be more like origins.
//# address-hook(0x073906) end(0x073954)
function void fn073906()
{
	setupObjectAttributesFull(0x0740ec)

	boss.remaining_hits = 8
	objA0.countdown_callback = 0x073960
	A1 = 0x0738ce
	objA0.value26 = MUSIC_MAINBOSS
	StartBossFight()

#if STANDALONE
	if (getScreenWidth() > 320)
	{
		// Both are 0x3a20 originally
		level.bossarea.left = 0x3a20 - getScreenExtend() * 3
		level.bossarea.right = 0x3a20 - getScreenExtend()
	}
    level.bossarea.top -= (getScreenHeight() - 224)
    level.bossarea.bottom -= (getScreenHeight() - 224)
#endif

	// "spawnChildObjects(0x07414c)" replaced by:
	spawnChildObject(0x073e0e, 0x00, 0, -8)		// Robotnik head, Egg Mobile empty seat
	spawnChildObject(0x073ea2, 0x02, -24, -112)

	requestLoadingPatterns(0x77)		// Robotnik running + ship and boss explosion sprites

	Kosinski.addToDMAQueue(0x376542, 0x84a0)		// Boss sprites

	loadPaletteLine1(0x0741fe)

#if STANDALONE
	// If you made it here and stayed dry, you've earned this achievement
	if (Game.getAchievementValue(ACHIEVEMENT_LBZ_STAY_DRY) == 1)
	{
		Game.setAchievementComplete(ACHIEVEMENT_LBZ_STAY_DRY)
	}
#endif
}

