global bool altlbz2cs.fadeadjust
global bool altlbz2cs.removehud
global u8 altlbz2cs.hudgobye = 0
global u8 altlbz2cs.dangerhud
global u16 altlbz2cs.hudgobyedanger = 0
global bool altlbz2cs.highjump
global u8 altlbz2cs.stopmusic
