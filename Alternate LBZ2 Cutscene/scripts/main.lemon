	base.fn0543cc()

	if (altlbz2cs.knuxpipe == 1) // Longer pipe.
	{
		u8[0xffff867c] = 0x07
		u8[0xffff8716] = 0x0f
		u8[0xffff8715] = 0x56
	}
	else if (altlbz2cs.knuxpipe == 2) // Shorter pipe.
