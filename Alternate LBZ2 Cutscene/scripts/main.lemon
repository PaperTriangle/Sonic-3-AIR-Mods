}

// Make the exhaust flames from Beam Rocket flash
// Also fix the arm showing infront of players during fall
function bool Standalone.onDrawVdpSprite(s16 px, s16 py, u8 size, u16 index, u16 renderQueue)
{
	//LBZ2 Eggman Flames
	if (altlbz2cs.eggmanflames && objA0.update_address == 0x073384)
		return (level.framecounter & 1) ? base.Standalone.onDrawVdpSprite(px, py, size, index, renderQueue) : true
		
	////LBZ2 Eggman Debris
	//if (altlbz2cs.eggmandebris && objA0.update_address == 0x073152)
	//	return (level.framecounter & 1) ? base.Standalone.onDrawVdpSprite(px, py, size, index, renderQueue) : true
	
	// Fix Big Arm's arm during drop
	if (altlbz2cs.behind && (objA0.update_address == 0x074b36 || objA0.update_address == 0x0749d0))
	{
		Renderer.drawVdpSprite(px, py, size, index, renderQueue - 0x1000)
		return true
	}
	
	// Origins Resolution debris compat
	if Mods.isModActive("Origins Screen Resolution") && (objA0.update_address == 0x856d0)
	{
		Renderer.drawVdpSprite(px, py, size, index, objA0.sprite_priority == 0x0080 ? 0xa000 : 0x4000)
		return true
	}

	return base.Standalone.onDrawVdpSprite(px, py, size, index, renderQueue)
}

