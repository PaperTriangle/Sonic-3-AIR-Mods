function void LevelObjectTableBuilder.addObject(u16 px, u16 py, u8 type, u8 subtype, u8 flags)
{

	if Mods.isModActive("Monitors +")
	{
		if (global.zone_act == 0x0000) // AIZ1
		{
			if (px == 0x28c0 && py == 0x0561)
				subtype = 0x0f
		}
		else if (global.zone_act == 0x0001) // AIZ2
		{
			if (px == 0x1dd0 && py == 0x05c0)
				subtype = 0x0f
		}
		else if (global.zone_act == 0x0100) // HCZ1
		{
			if (px == 0x1da3 && py == 0x0370)
				subtype = 0x0f
		}
		else if (global.zone_act == 0x0101) // HCZ2
		{
			if (px == 0x1a10 && py == 0x0570)
				subtype = 0x0f
			else if (px == 0x3410 && py == 0x0830)
				subtype = 0x0f
		}
		else if (global.zone_act == 0x0200) // MGZ1
		{
			if (px == 0x0b17 && py == 0x093b)
				subtype = 0x0f
			else if (px == 0x2150 && py == 0x0abf)
				subtype = 0x0f
			else if (px == 0x2170 && py == 0x0abf)
				return
		}
		else if (global.zone_act == 0x0201) // MGZ2
		{
			if (px == 0x2450 && py == 0x02c0)
				subtype = 0x0f
			if (px == 0x1400 && py == 0x0680)
				subtype = 0x0f
		}
		else if (global.zone_act == 0x0300) // CNZ1
		{
			if (px == 0x0f00 && py == 0x0a30)
				subtype = 0x0f
			else if (px == 0x1a50 && py == 0x00d0)
				subtype = 0x0f
		}
		else if (global.zone_act == 0x0301) // CNZ2
		{
			if (px == 0x1730 && py == 0x0130)
				subtype = 0x0f
			else if (px == 0x2070 && py == 0x0730)
				subtype = 0x0f
		}
		else if (global.zone_act == 0x0400) // FBZ1
		{
			if (px == 0x1410 && py == 0x0378)
				base.LevelObjectTableBuilder.addObject(0x140e, 0x0af1, OBJECTTABLE1_01, 0x0f, 0)
		}
		else if (global.zone_act == 0x0401) // FBZ2
		{
			if (px == 0x1c40 && py == 0x0710)
				base.LevelObjectTableBuilder.addObject(0x1c2e, 0x08f0, OBJECTTABLE1_01, 0x0f, 0)
		}
		else if (global.zone_act == 0x0500) // ICZ1
		{
			if (px == 0x5778 && py == 0x0211)
			{
				LevelObjectTableBuilder.addObject(0x57aa, 0x0734, OBJECTTABLE1_b6, 0x00, 0)
				LevelObjectTableBuilder.addObject(0x57aa, 0x0737, OBJECTTABLE1_01, 0x0f, 0)
			}
			if (px == 0x57c0 && (py == 0x0734 || py == 0x073c))
				px += 0x18
		}
		else if (global.zone_act == 0x0501) // ICZ2
		{
			if (px == 0x2020 && py == 0x03f8)
				subtype = 0x0f
			else if (px == 0x26c0 && py == 0x00b3)
			{
				base.LevelObjectTableBuilder.addObject(0x26c0, 0x00b3, OBJECTTABLE1_b6, 0x00, 0)
				base.LevelObjectTableBuilder.addObject(0x26c0, 0x00b4, OBJECTTABLE1_01, 0x0f, 0)
				return
			}
		}
		else if (global.zone_act == 0x0600) // LBZ1
		{
			if (px == 0x11d0 && py == 0x0410)
				subtype = 0x0f
			else if (px == 0x2b10 && py == 0x06f0)
				subtype = 0x0f
			else if (px == 0x35f0 && py == 0x0228)
				subtype = 0x0f
		}
		else if (global.zone_act == 0x0601) // LBZ2
		{
			if (px == 0x0650 && py == 0x05f0)
				subtype == 0x0f
			else if (px == 0x11b2 && py == 0x04f0)
				subtype = 0x0f
			else if (px == 0x3730 && py == 0x0130)
				subtype = 0x0f
			else if (px == 0x11b0 && py == 0x08d0)
				subtype = 0x0f
		}
		else if (global.zone_act == 0x0700) // MHZ1
		{
			if (px == 0x0f30 && py == 0x0870)
				subtype = 0x0f
			else if (px == 0x13a0 && py == 0x0470)
				subtype = 0x0f
			else if (px == 0x17b0 && py == 0x0420)
			{
				base.LevelObjectTableBuilder.addObject(0x1790, 0x0272, OBJECTTABLE1_01, 0x0f, 0)
			}
		}
		else if (global.zone_act == 0x0701) // MHZ2
		{
			if (px == 0x1ba0 && py == 0x084c)
				subtype = 0x0f
			else if (px == 0x2220 && py == 0x03b0)
				subtype = 0x0f
			else if (px == 0x3250 && py == 0x02b0)
				subtype = 0x0f
		}
		else if (global.zone_act == 0x0800) // SOZ1
		{
			if (px == 0x0e30 && py == 0x09b0)
			{
				px = 0x0e40
				subtype = 0x0f
			}
			else if (px == 0x0e50 && py == 0x09b0)
				return
			else if (px == 0x2240 && py == 0x05b0)
				subtype = 0x0f
			else if (px == 0x22b0 && py == 0x04dc)
			{
				base.LevelObjectTableBuilder.addObject(0x2290, 0x0970, OBJECTTABLE1_01, 0x0f, 0)
			}
		}
		else if (global.zone_act == 0x0801) // SOZ2
		{
			if (px == 0x2830 && py == 0x01f0)
				px -= 0x10
			else if (px == 0x2850 && py == 0x01f0)
			{
				base.LevelObjectTableBuilder.addObject(0x2840, 0x01f0, OBJECTTABLE1_01, 0x0f, 0)
				px += 0x10
			}
			else if (px == 0x0c30 && py == 0x0250)
			{
				px = 0x0c40
				subtype = 0x0f
			}
			else if (px == 0x0c50 && py == 0x0250)
				return
			else if (px == 0x19c8 && py == 0x05b0)
			{
				base.LevelObjectTableBuilder.addObject(0x19a0, 0x0330, OBJECTTABLE1_01, 0x0f, 0)
			}
		}
		else if (global.zone_act == 0x0900) // LRZ1
		{
			if (px == 0x2452 && py == 0x0687)
				subtype = 0x0f
			else if (px == 0x0de8 && py == 0x0234)
				subtype = 0x0f
			else if (px == 0x07f0 && py == 0x06b0)
				subtype = 0x0f
			else if (px == 0x07d0 && py == 0x06d0)
				return
		}
		else if (global.zone_act == 0x0901) // LRZ2
		{
			if (px == 0x1270 && py == 0x0351)
			{
				subtype = 0x0f
				py--
			}
			else if (px == 0x2370 && py == 0x0630)
				subtype = 0x0f
			else if (px == 0x3280 && py == 0x00f4)
			{
				base.LevelObjectTableBuilder.addObject(0x3240, 0x04b0, OBJECTTABLE1_01, 0x0f, 0)
			}
		}
		else if (global.zone_act == 0x1601) // HPZ
		{
			if (px == 0x02d0 && py == 0x0670)
				subtype = 0x0f
		}
		else if (global.zone_act == 0x0a00) // SSZ
		{
			if (px == 0x0890 && py == 0x07f0)
				subtype = 0x0f
			else if (px == 0x10d0 && py == 0x0fb0)
				subtype = 0x0f
		}
		else if (global.zone_act == 0x0b00) // DEZ1
		{
			if (px == 0x1d80 && py == 0x03d0)
				subtype = 0x0f
			else if (px == 0x3100 && py == 0x0330)
				subtype = 0x0f
		}
		else if (global.zone_act == 0x0b01) // DEZ2
		{
			if (px == 0x0c40 && py == 0x076c)
				subtype = 0x0f
			else if (px == 0x1a70 && py == 0x0bcf)
				subtype = 0x0f
		}
	}

	base.LevelObjectTableBuilder.addObject(px, py, type, subtype, flags)
}