include original_zone_order

global bool tca.mgz
global bool tca.fbz
global bool tca.icz
global bool tca.lbz
global bool tca.mvz
global bool tca.soz
global bool tca.hpz
global bool tca.ssz_sonic
global bool tca.ssz_knux

global bool tca.intended
global bool tca.fadetype
global bool tca.fadespeed
global bool tca.mgz2boss
global bool tca.leftescape
global bool tca.fbz_s3_icon
global bool tca.fbz_bg
global bool tca.fbz_explosions
global bool tca.icz_trans_point
global bool tca.icz_trans_fade
global bool tca.lbz_clouds
global u8 tca.ssz_trans_point
global bool tca.ssz_knux_csfix
global bool tca.ssz_knux_fade
global bool tca.ssz_knux_longdawn
global bool tca.ssz_knux_emerald
global u8 tca.bmpline
global bool tca.bg_stars
global bool tca.bg_twinkle
global bool tca.zone_icons
global bool tca.ssz_icon

global bool tca.mgz_knux_night
global bool tca.mgz_mountains
global bool tca.soz_bg
global bool tca.knux_fbz
global bool tca.fbz_intro
global bool tca.fbz_clouds

global bool tca.pal_ssz_dawn

global u8 transition_state = 0
global u16 transition_time = 0
global bool tca.knux_stars_off
global bool tca.infbz1forreal
global bool tca.inssz1forreal
global u16 tca.stars_offset

function bool isKnucklesRoute()
{
	if (global.characters == CHARS_KNUCKLES_ALONE)
		return true
	else if (global.characters > CHARS_KNUCKLES_ALONE) && MISC.getAllowedZones(global.characters) == 0x0b
		return true
		
	return false
}

function void yieldExecution()
{
	//Tile Data
	if (tca.mgz_mountains)
	{
		System.loadExternalRawData("MGZ_Mountain_Fix_1", 0x3C8A70)
		System.loadExternalRawData("MGZ_Mountain_Fix_2", 0x3CA132)
	}
	
	if (tca.fbz_clouds)
		System.loadExternalRawData("FBZ_Cloud_Fix", 0x195040)
	
	
	if (tca.soz_bg)
	{
		if (isKnucklesRoute() && tca.intended && !tca.knux_fbz)
			System.loadExternalRawData("SOZ_Day_Fix", 0x1AA36A)
		else
			System.loadExternalRawData("SOZ_Original", 0x1AA36A)
	}
	
	if (tca.hpz && global.zone_act == 0x1601)
	{
		if (isKnucklesRoute() && tca.intended && tca.knux_fbz != 1)
		{
			System.loadExternalRawData("HPZ_Roof_Fix_1", 0x1BEE58)
			System.loadExternalRawData("HPZ_Roof_Fix_2", 0x1C3F2C)
		}
		else
		{
			System.loadExternalRawData("HPZ_Roof_Original_1", 0x1BEE58)
			System.loadExternalRawData("HPZ_Roof_Original_2", 0x1C3F2C)
		}
	}
	
	// Zone Logic
	if (tca.mgz && global.zone_act == 0x0200) // MGZ Act 1
	{
		if ((checkpoint.number == 3 && transition_state == 0) || (transition_state == 1 && transition_time > 0x78))
		{
			transition_state = 2
		}
		
		if (transition_state == 2)
			System.loadExternalRawData("MGZ2_Palette", 0x0A8F5C)
		
		if ((camera.position.x.u16 + getScreenWidth() / 2 > 0x2100 && !(camera.position.x.u16 + getScreenWidth() / 2 > 0x26c0 && camera.position.x.u16 + getScreenWidth() / 2 < 0x2880)) && (camera.position.y.u16 + getScreenHeight() / 2 > 0x0a00 && camera.position.y.u16 + getScreenHeight() / 2 < 0x0b00) && transition_state == 0)
		{
			transition_state = 1
			transition_time = 0
		}
		else if ((camera.position.x.u16 > (!tca.fadespeed ? 0x27e8 : 0x28b8) - getScreenExtend() && camera.position.y.u16 > 0x0cc0) && transition_state == 0)
		{
			transition_state = 1
			transition_time = 0
		}
		
		if (transition_state == 1 && transition_time <= 0x78) && (!global.game.paused)
		{
			System.loadExternalRawData("MGZ2_Palette", 0x3fff30)
			
			transition_time += !tca.fadespeed ? 1 : 2
			if (transition_time % (tca.fadespeed ? 30 : 24) == 0 || !tca.fadetype)
			{
				for (u8 i = 0; i < 31; i++)
				{
					u16[0xfffffc00 + (0x21 + i)*2] = blendColorsPacked(u16[0x0A8F3C + (0x21 + i)*2], u16[0x3fff30 + (0x11 + i)*2], min(256, transition_time * 2 + transition_time / 8 + 1))
				}
			}
		}
	
	}
	else if (tca.mgz && global.zone_act == 0x0201) // MGZ Act 2
	{
		System.loadExternalRawData("MGZ2_Palette", 0x0A8F5C)
		
		if (transition_state == 1 && transition_time <= 0x78) && (!global.game.paused)
		{	
			System.loadExternalRawData("MGZ2_Palette_Night", 0x3fff30)
			
			transition_time++
			if (transition_time % 20 == 0 || !tca.fadetype)
			{
				for (u8 i = 0; i < 31; i++)
				{
					u16[0xfffffc00 + (0x21 + i)*2] = blendColorsPacked(u16[0x0A8F3C + (0x21 + i)*2], u16[0x3fff30 + (0x11 + i)*2], min(256, transition_time * 2 + transition_time / 8 + 1))
				}
			}
		}
		
		if tca.mgz_knux_night && ((checkpoint.number == 8) || (transition_state == 2 && transition_time > 0x78))
		{
			System.loadExternalRawData("MGZ2_Palette_Night", 0x0A8F5C)
			transition_state = 3
		}
		
		if (tca.mgz_knux_night && (camera.position.x.u16 + getScreenWidth() / 2  > 0x39d0 && camera.position.y.u16 + getScreenHeight() / 2 < 0x00f0) && transition_state == 0)
		{
			transition_state = 2
			transition_time = 0
		}
		
		if (transition_state == 2 && transition_time <= 0x78) && (!global.game.paused)
		{	
			System.loadExternalRawData("MGZ2_Palette_Night", 0x3fff30)
			
			transition_time += !tca.fadespeed ? 1 : 2
			if (transition_time % (tca.fadespeed ? 30 : 24) == 0 || !tca.fadetype)
			{
				for (u8 i = 0; i < 31; i++)
				{
					u16[0xfffffc00 + (0x21 + i)*2] = blendColorsPacked(u16[0x0A8F3C + (0x21 + i)*2], u16[0x3fff30 + (0x11 + i)*2], min(256, transition_time * 2 + transition_time / 8 + 1))
				}
			}
		}
	}
	else if (tca.fbz && global.zone_act == 0x0400 && (tca.intended && !(isMainCharacter(CHARACTER_KNUCKLES) && tca.knux_fbz))) // FBZ Act 1
	{
		System.loadExternalRawData("FBZ_Palette", 0x052dd0)
		
		if (tca.infbz1forreal && tca.bg_stars && fbzInOutCheck())
		{
			TCA.RenderFix()
			
			if (!level.restart)
				tca.stars_offset = (camera.background.y >> 16) // I do this to prevent the clouds snapping when restarting
			
			for (u16 fs = 0 ; fs*128 < getScreenWidth() + 128; fs++)
			{
				Renderer.drawSprite(stringformat("fbz_stars_%d", tca.bg_twinkle ? (level.framecounter >> 4) % 4 : 1), 128 + fs*128 - ((level.framecounter + camera.position.x.u16) % 1152) / 9, 128 - tca.stars_offset - camera.screenshake.offset, 0, SPRITE_FLAG_PRIO, 0x1001)
			}
		}
		
	}
	else if (tca.fbz && global.zone_act == 0x0400 && (!tca.intended || (tca.intended && (isMainCharacter(CHARACTER_KNUCKLES) && tca.knux_fbz)))) // FBZ Act 1 (As Released) ****
	{
		System.loadExternalRawData("FBZ_Palette_Released", 0x052dd0)
	}
	else if (tca.fbz && global.zone_act == 0x0401 && (tca.intended && !(isMainCharacter(CHARACTER_KNUCKLES) && tca.knux_fbz))) // FBZ Act 2 (Intended)
	{

		if (camera.position.x.u16 >= 0x29a8 - getScreenExtend())
			System.loadExternalRawData("FBZ_Palette_Boss", 0x052dd0)
		else
			System.loadExternalRawData(tca.fbz_bg ? "FBZ_Palette_Alt" : "FBZ_Palette", 0x052dd0)
		
		if (transition_state >= 1 && transition_time <= 0x78) && (!global.game.paused)
		{	
			System.loadExternalRawData("FBZ_Palette_Boss", 0x3fff30)
			System.loadExternalRawData("FBZ_Palette_Released", 0x3fff60)
			
			transition_time += !tca.fadespeed ? 1 : 2
			if (transition_time % (tca.fadespeed ? 30 : 24) == 0 || !tca.fadetype)
			{
				for (u8 i = 0; i < 8; i++)
				{
					u16[0xfffffc00 + (0x32 + i)*2] = blendColorsPacked(u16[0x3fff30 + i*2], u16[0x3fff60 + i*2], min(256, transition_time * 2 + transition_time / 8 + 1))
				}
			}
		}
	}
	else if (tca.fbz && global.zone_act == 0x0401 && (!tca.intended || (tca.intended && (isMainCharacter(CHARACTER_KNUCKLES) && tca.knux_fbz)))) // FBZ Act 2 (As Released) ****
	{

		if (camera.position.x.u16 >= 0x29a8 - getScreenExtend())
			System.loadExternalRawData("FBZ_Palette_Boss_Released", 0x052dd0)
		else
			System.loadExternalRawData("FBZ_Palette_Released", 0x052dd0)

	}
	else if (tca.icz && global.zone == 0x05 && tca.intended) // ICZ Act 1 & 2
	{
	
		if (transition_state == 0)
			System.loadExternalRawData("ICZ_Dawn_Palette", 0x3fff30)
		else if (transition_state == 1 && transition_time <= 0x78 && camera.position.y.u16 < 0x700) && (!global.game.paused)
		{	
			System.loadExternalRawData("ICZ_Dawn_Palette", 0x3fff30)
			System.loadExternalRawData("ICZ_Morning_Palette", 0x3fff60)
			transition_time += 2
			if (transition_time % 24 == 0 || !tca.fadetype)
			{
				for (u8 i = 0; i < 15; i++)
				{
					u16[0xfffffc00 + (0x31 + i)*2] = blendColorsPacked(u16[0x3fff30 + i*2], u16[0x3fff60 + i*2], min(0xff, transition_time * 2 + transition_time / 8 + 1))
				}
			}
		}
		else if (tca.icz_trans_fade && transition_state == 2 && transition_time <= 0x78 && camera.position.y.u16 < 0x700) && (!global.game.paused)
		{
			System.loadExternalRawData("ICZ_Morning_Palette", 0x3fff30)
			System.loadExternalRawData("ICZ_New_Palette", 0x3fff60)
			
			transition_time += 2
			if (transition_time % 24 == 0 || !tca.fadetype)
			{
				for (u8 i = 0; i < 15; i++)
				{
					u16[0xfffffc00 + (0x31 + i)*2] = blendColorsPacked(u16[0x3fff30 + i*2], u16[0x3fff60 + i*2], min(0xff, transition_time * 2 + transition_time / 8 + 1))
				}
			}
		}
		else if (!tca.icz_trans_fade && transition_state == 2 && transition_time <= 0x78 && camera.position.y.u16 < 0x700) && (!global.game.paused)
		{	
			System.loadExternalRawData("ICZ_Dawn_Palette", 0x3fff30)
			System.loadExternalRawData("ICZ_New_Palette", 0x3fff60)
			
			transition_time += 2
			if (transition_time % 24 == 0 || !tca.fadetype)
			{
				for (u8 i = 0; i < 15; i++)
				{
					u16[0xfffffc00 + (0x31 + i)*2] = blendColorsPacked(u16[0x3fff30 + i*2], u16[0x3fff60 + i*2], min(0xff, transition_time * 2 + transition_time / 8 + 1))
				}
			}
		}
		
		if (isKnucklesRoute())
		{
			if (!tca.icz_trans_point && transition_state == 1 && transition_time >= 0x78)
			{
				transition_state = 2
				transition_time = 0
			}
			
			if (tca.icz_trans_point && global.zone_act == 0x0501 && transition_state == 0 && camera.position.x.u16 > 0x3ad8 - getScreenExtend())
			{
				transition_state = tca.icz_trans_fade ? 1 : 2
				transition_time = 0
			}
		}
	}
	else if (tca.icz && global.zone == 0x05 && !tca.intended) // ICZ Act 1 & 2 (As Released) ****
	{
		if (transition_state == 1 && transition_time <= 0x78) && (!global.game.paused)
		{	
			System.loadExternalRawData("ICZ_Act1_Palette", 0x3fff30)
			System.loadExternalRawData("ICZ_New_Palette", 0x3fff60)
			
			transition_time += 2
			if (transition_time % 24 == 0 || !tca.fadetype)
			{
				for (u8 i = 0; i < 15; i++)
				{
					u16[0xfffffc00 + (0x31 + i)*2] = blendColorsPacked(u16[0x3fff30 + i*2], u16[0x3fff60 + i*2], min(0xff, transition_time * 2 + transition_time / 8 + 1))
				}
			}
		}
	}
	else if (tca.lbz && global.zone == 0x06) // LBZ Act 1 & 2
	{
		System.loadExternalRawData("LBZ1_Palette", 0x0A929C)
		System.loadExternalRawData("LBZ2_Palette", 0x0A92FC)
		
		if (tca.lbz_clouds)
		{
			System.loadExternalRawData("LBZ2_Chunks", 0x3EAF04)
			System.loadExternalRawData("LBZ2_Blocks", 0x3E5F70)
			System.loadExternalRawData("LBZ2_Tiles", 0x3E77D0)
			System.loadExternalRawData("LBZ2_Collision", 0x27BF60)
			System.loadExternalRawData("LBZ2_Boss_Chunks", 0x3ED3D4)
			System.loadExternalRawData("LBZ2_Boss_Blocks", 0x3E69B0)
			System.loadExternalRawData("LBZ2_Boss_Tiles", 0x3E8F72)
			System.loadExternalRawData("LBZ2_Boss_Tiles2", 0x37F6EE)
		}
		
	}
	else if (tca.mvz && global.zone == 0x07 && tca.intended) // MVZ Act 2
	{
		if (!isKnucklesRoute() && global.act == 0x01 && camera.position.x.u16 > 0x3ae5 - getScreenExtend())
			System.loadExternalRawData("MVZ2_Palette_Sunset", 0x0A943C)
		else
			System.loadExternalRawData("MVZ2_Palette_Day", 0x0A943C)
	}
	else if (tca.soz && global.zone_act == 0x0800) // SOZ Act 1
	{	
		if (isKnucklesRoute() && tca.intended && !tca.knux_fbz)
			System.loadExternalRawData("SOZ1_Palette_Day", 0x0A94FC)
		else
			System.loadExternalRawData("SOZ1_Palette_Arvo", 0x0A94FC)
	}
	else if (tca.ssz_sonic && global.zone_act == 0x0a00 && tca.intended) // SSZ Sonic
	{
		if (checkpoint.number < (tca.ssz_trans_point < 2 ? 1 : 2) )
			System.loadExternalRawData(tca.pal_ssz_dawn ? "SSZ1_Palette_Morning_Pink" : "SSZ1_Palette_Morning", 0x0A973C)
		else
			System.loadExternalRawData("SSZ1_Palette_Original", 0x0A973C)

		if (transition_state == 0 && tca.ssz_trans_point == 0 && camera.position.y.u16 < 0xc80 && checkpoint.number < 1 )
			transition_state = 1
		else if (transition_state == 0 && tca.ssz_trans_point == 2 && camera.position.y.u16 < 0xa80 && checkpoint.number < 2 )
			transition_state = 1
		else if (transition_state == 0 && tca.ssz_trans_point == 3 && camera.position.y.u16 < 0x700 && checkpoint.number < 2 )
			transition_state = 1
		
		if (transition_state == 1 && transition_time <= 0x78) && (!global.game.paused) && tca.inssz1forreal
		{	
			transition_time += !tca.fadespeed ? 1 : 2
			if (transition_time % (tca.fadespeed ? 30 : 24) == 0 || !tca.fadetype)
			{
				System.loadExternalRawData("SSZ1_Palette_Original", 0x3fff30)
							
				for (u8 i = 0; i < 7; i++)
				{
					u16[0xfffffc00 + (0x31 + i)*2] = blendColorsPacked(u16[0x0A971C + (0x31 + i)*2], u16[0x3fff30 + (0x21 + i)*2], min(0xff, transition_time * 2 + transition_time / 8 + 1))
				}
			}
		}	
	}
	else if (tca.ssz_knux && global.zone_act == 0x0a01 && tca.intended) // SSZ Knuckles (Intended)
	{
		if !(isMainCharacter(CHARACTER_KNUCKLES) && tca.knux_fbz == 1) // Normal Mode (Knuckles skips FBZ)
		{
			if (transition_state == 0 )
			{
				if (!tca.knux_stars_off && tca.bg_stars)
				{
					TCA.RenderFix()
					
					for (u16 fs = 0 ; fs*128 < getScreenWidth(); fs++)
					{
						Renderer.drawSprite(stringformat("knux_stars_%d", tca.bg_twinkle ? (level.framecounter >> 4) % 4 : 1), 128 + fs*128 - (camera.position.x.u16 % 1024) / 8, -1 * (camera.position.y.u16 - 0x400) - camera.screenshake.offset + 80, 0, SPRITE_FLAG_PRIO, 0x2001)
					}
				}

				System.loadExternalRawData("SSZK_Palette_Night", 0x0A979C)
			}
			
			if (transition_state == 1 && transition_time <= 0x78) && (!global.game.paused)
			{	
				System.loadExternalRawData("SSZK_Palette_Pre_Dawn", 0x0A979C)
				transition_time += !tca.fadespeed ? 1 : 2
				if (tca.ssz_knux_fade)
				{
					if (transition_time % (tca.fadespeed ? 30 : 24) == 0 || !tca.fadetype)
					{
						System.loadExternalRawData(tca.pal_ssz_dawn ? "SSZK_Palette_Morning_Pink" : "SSZK_Palette_Morning", 0x3fff30)
						
						for (u8 i = 0; i < 23; i++)
						{
							if (i != 13 && i != 14)
							{
								u16[0xfffffc00 + (0x21 + i)*2] = blendColorsPacked(u16[0x0A977C + (0x21 + i)*2], u16[0x3fff30 + (0x11 + i)*2], min(0xff, transition_time * 2 + transition_time / 8 + 1))
								u16[0xfffffc00 + 0x80 + (0x21 + i)*2] = blendColorsPacked(u16[0x0A977C + (0x21 + i)*2], u16[0x3fff30 + (0x11 + i)*2], min(0xff, transition_time * 2 + transition_time / 8 + 1))
							}
						}
					}

					if (transition_time >= 0x79)
					{
						if (!tca.ssz_knux_longdawn)
						{
							transition_state = 2
							transition_time = 0
						}
						System.loadExternalRawData("SSZK_Palette_Original", 0x0A979C)
					}
				}
				else
				{
					if (transition_time % (tca.fadespeed ? 30 : 24) == 0 || !tca.fadetype)
					{
						System.loadExternalRawData("SSZK_Palette_Original", 0x3fff30)
						
						for (u8 i = 0; i < 31; i++)
						{
							if (i != 13 && i != 14)
							{
								u16[0xfffffc00 + (0x21 + i)*2] = blendColorsPacked(u16[0x0A977C + (0x21 + i)*2], u16[0x3fff30 + (0x11 + i)*2], min(0xff, transition_time * 2 + transition_time / 8 + 1))
								u16[0xfffffc00 + 0x80 + (0x21 + i)*2] = blendColorsPacked(u16[0x0A977C + (0x21 + i)*2], u16[0x3fff30 + (0x11 + i)*2], min(0xff, transition_time * 2 + transition_time / 8 + 1))
							}
						}
					}

					if (transition_time >= 0x79)
					{
						transition_state = 3
						System.loadExternalRawData("SSZK_Palette_Original", 0x0A979C)
					}
				}
				
			}
			else if (transition_state == 2 && transition_time <= 0x78) && (!global.game.paused)
			{
				System.loadExternalRawData(tca.pal_ssz_dawn ? "SSZK_Palette_Morning_Pink" : "SSZK_Palette_Morning", 0x0A979C)
				transition_time += !tca.fadespeed ? 1 : 2
				if (transition_time % (tca.fadespeed ? 30 : 24) == 0 || !tca.fadetype)
				{
					System.loadExternalRawData("SSZK_Palette_Original", 0x3fff30)
					
					for (u8 i = 0; i < 31; i++)
					{
						if (i != 13 && i != 14)
						{
							u16[0xfffffc00 + (0x21 + i)*2] = blendColorsPacked(u16[0x0A977C + (0x21 + i)*2], u16[0x3fff30 + (0x11 + i)*2], min(256, transition_time * 2 + transition_time / 8 + 1))
							u16[0xfffffc00 + 0x80 + (0x21 + i)*2] = blendColorsPacked(u16[0x0A977C + (0x21 + i)*2], u16[0x3fff30 + (0x11 + i)*2], min(256, transition_time * 2 + transition_time / 8 + 1))
						}
					}
				}
				
			}
		}
		else // If Knuckles visits FBZ
		{
			if (transition_state == 0)
			{
				System.loadExternalRawData(tca.pal_ssz_dawn ? "SSZK_Palette_Morning_Pink" : "SSZK_Palette_Morning", 0x0A979C)
			}
			else if (transition_state == 1 && transition_time <= 0x78) && (!global.game.paused)
			{
				System.loadExternalRawData(tca.pal_ssz_dawn ? "SSZK_Palette_Morning_Pink" : "SSZK_Palette_Morning", 0x0A979C)
				transition_time += !tca.fadespeed ? 1 : 2
				if (transition_time % (tca.fadespeed ? 30 : 24) == 0 || !tca.fadetype)
				{
					System.loadExternalRawData("SSZK_Palette_Original", 0x3fff30)
					
					for (u8 i = 0; i < 31; i++)
					{
						if (i != 13 && i != 14)
						{
							u16[0xfffffc00 + (0x21 + i)*2] = blendColorsPacked(u16[0x0A977C + (0x21 + i)*2], u16[0x3fff30 + (0x11 + i)*2], min(256, transition_time * 2 + transition_time / 8 + 1))
							u16[0xfffffc00 + 0x80 + (0x21 + i)*2] = blendColorsPacked(u16[0x0A977C + (0x21 + i)*2], u16[0x3fff30 + (0x11 + i)*2], min(256, transition_time * 2 + transition_time / 8 + 1))
						}
					}
				}
				
				if (transition_time >= 0x79)
				{
					transition_state = 3
					System.loadExternalRawData("SSZK_Palette_Original", 0x0A979C)
				}
				
			}
		}
	}
	
	base.yieldExecution()
}

function void TCA.RenderFix()
{
#if GAMEAPP >= 0x25021500
	Renderer.resetLifetimeContext(2)
	Renderer.setLifetimeContext(2)
	Renderer.resetViewport(0x9fe0)
#endif
}

// Zone Icons

// What route is the character on?
function u8 MISC.getAllowedZones(u8 slotnum)
{
    // add exceptions for your individual character like this:
    // if (slotnum == CHARACTER_CUSTOM)
    //    return 0x0d
	// 
	// for reference:
	// 0x0d - Sonic zones (includes doomsday)
	// 0x0c - Tails zones (excludes doomsday)
	// 0x0b - Knux zones (ends at ssz)

	return base.MISC.getAllowedZones(slotnum)
}

//# address-hook(0x00d96a) end(0x00d9f2)
function void fn00d96a()
{
	u16 tca.ds_char = u16[A0 + 0x34]
	
	bool tca.knux_route = false
	
#if EXTRA_CHARACTER_FRAMEWORK_ACTIVE
	if !ECF_dataselect_getStr()
#endif
	{
		if (tca.ds_char == 3 || tca.ds_char == 4)
			tca.knux_route = true
		else if (tca.ds_char > 4) && MISC.getAllowedZones(tca.ds_char - 1) == 0x0b
			tca.knux_route = true
	}
		
	u16 posY = 0x10 + ((Mods.isModActive("Data Select Options") && Mods.isModActive("Origins Screen Resolution")) ? 0x08 : 0x00)
	
	if (tca.zone_icons && tca.intended)
	{		
		if tca.knux_route
		{
			if (tca.soz && !tca.knux_fbz)
				System.loadExternalRawData("SOZ_Zone_Card_Knux", 0x00CC18)
			if (tca.ssz_knux)
			{
				if (tca.knux_fbz == 1)
					System.loadExternalRawData(tca.pal_ssz_dawn ? "SSZ_Zone_Card_Knux_Released_Dawn_Pink" : "SSZ_Zone_Card_Knux_Released_Dawn", 0x00CC78)
				else
					System.loadExternalRawData("SSZ_Zone_Card_Knux", 0x00CC78)
			}
		}
		else
		{
			if (tca.soz)
				System.loadExternalRawData("SOZ_Zone_Card_Sonic", 0x00CC18)

			if (tca.ssz_icon && tca.ssz_sonic)
				System.loadExternalRawData(tca.pal_ssz_dawn ? "SSZ_Zone_Card_Sonic_Dawn_Pink" : "SSZ_Zone_Card_Sonic_Dawn", 0x00CC78)
			else if (tca.ssz_sonic && Mods.isModActive("Moar Transparency") && System.getGlobalVariableValueByName("mt.teleframe"))
				System.loadExternalRawData("SSZ_Zone_Card_Sonic_Compat", 0x00CC78)
			else if (tca.ssz_sonic || tca.ssz_knux)
				System.loadExternalRawData("SSZ_Zone_Card_Sonic", 0x00CC78)
		}
		
		if (!tca.fbz_s3_icon && tca.fbz)
			System.loadExternalRawData(tca.knux_route ? "FBZ_Zone_Card_Original" : "FBZ_Zone_Card", 0x00CBF8)
		else if (tca.fbz_s3_icon)
			System.loadExternalRawData("FBZ_Zone_Card_S3", 0x00CBF8)

		if (tca.lbz)
			System.loadExternalRawData("LBZ_Zone_Card", 0x00CBB8)

		if (u16[A0 + 0x36] == 0x007 && s16[0xffffb04a + 0x2e] == 0)
		{
			if (!tca.fbz_s3_icon && tca.fbz && !tca.knux_route)
			{
				SpriteHandle dataselpreview = Renderer.addSpriteHandle("fbz_icon", (objA0.position.x.u16 + getScreenExtend() - 208) - getScreenExtend() + 40, posY, 0x9ff9)
				dataselpreview.setFlags(0x40)
			}
			else if (tca.fbz_s3_icon)
			{
				SpriteHandle dataselpreview = Renderer.addSpriteHandle("fbz_icon_s3", (objA0.position.x.u16 + getScreenExtend() - 208) - getScreenExtend() + 40, posY, 0x9ff9)
				dataselpreview.setFlags(0x40)
			}
		}
		if (u16[A0 + 0x36] == 0x005 && s16[0xffffb04a + 0x2e] == 0)
		{
			if (tca.lbz)
			{	
				u64 lbzkey = "lbz_icon"
				if (tca.ds_char == 0x03 || tca.ds_char == 0x04)
					lbzkey = "lbz_icon_knux"
					
				SpriteHandle dataselpreview = Renderer.addSpriteHandle(lbzkey, (objA0.position.x.u16 + getScreenExtend() - 208) - getScreenExtend() + 40, posY, 0x9ff9)
				dataselpreview.setFlags(0x40)
			}
		}
		if (u16[A0 + 0x36] == 0x008 && s16[0xffffb04a + 0x2e] == 0)
		{
			if (tca.soz)
			{
				SpriteHandle dataselpreview = Renderer.addSpriteHandle("soz_icon", (objA0.position.x.u16 + getScreenExtend() - 208) - getScreenExtend() + 40, posY, 0x9ff9)
				dataselpreview.setFlags(0x40)
			}
		}
		else if (u16[A0 + 0x36] == 0x000b && s16[0xffffb04a + 0x2e] == 0)
		{
			if (tca.ssz_knux && tca.knux_route)
			{
				SpriteHandle dataselpreview = Renderer.addSpriteHandle((tca.knux_fbz == 1) ? "ssz_icon_knux_released" : "ssz_icon_knux", (objA0.position.x.u16 + getScreenExtend() - 208) - getScreenExtend() + 40, posY, 0x9ff9)
				dataselpreview.setFlags(0x40)
			}
			else if (tca.ssz_icon && tca.ssz_sonic)
			{
				SpriteHandle dataselpreview = Renderer.addSpriteHandle("ssz_icon_dawn", (objA0.position.x.u16 + getScreenExtend() - 208) - getScreenExtend() + 40, posY, 0x9ff9)
				dataselpreview.setFlags(0x40)
			}
			else if (tca.ssz_sonic && Mods.isModActive("Moar Transparency") && System.getGlobalVariableValueByName("mt.teleframe"))
			{
				SpriteHandle dataselpreview = Renderer.addSpriteHandle("ssz_icon_compat", (objA0.position.x.u16 + getScreenExtend() - 208) - getScreenExtend() + 40, posY, 0x9ff9)
				dataselpreview.setFlags(0x40)
			}
		}
	}
	else if (tca.zone_icons && !tca.intended)
	{
		if (tca.ssz_knux && tca.knux_route)
		{
			System.loadExternalRawData("SSZ_Zone_Card_Knux_Released", 0x00CC78)
		}
		else
		{
			if (tca.ssz_sonic && Mods.isModActive("Moar Transparency") && System.getGlobalVariableValueByName("mt.teleframe"))
				System.loadExternalRawData("SSZ_Zone_Card_Sonic_Compat", 0x00CC78)
			else if (tca.ssz_sonic || tca.ssz_knux)
				System.loadExternalRawData("SSZ_Zone_Card_Sonic", 0x00CC78)
		}
		
		if (tca.soz)
			System.loadExternalRawData("SOZ_Zone_Card_Sonic", 0x00CC18)
		if (tca.fbz_s3_icon)
			System.loadExternalRawData("FBZ_Zone_Card_S3", 0x00CBF8)
		if (tca.lbz)
			System.loadExternalRawData("LBZ_Zone_Card", 0x00CBB8)
	
		if (u16[A0 + 0x36] == 0x005 && s16[0xffffb04a + 0x2e] == 0)
		{
			if (tca.lbz)
			{	
				u64 lbzkey = "lbz_icon"
				if (tca.knux_route)
					lbzkey = "lbz_icon_knux"
					
				SpriteHandle dataselpreview = Renderer.addSpriteHandle(lbzkey, (objA0.position.x.u16 + getScreenExtend() - 208) - getScreenExtend() + 40, posY, 0x9ff9)
				dataselpreview.setFlags(0x40)
			}
		}
		if (u16[A0 + 0x36] == 0x007 && s16[0xffffb04a + 0x2e] == 0)
		{
			if (tca.fbz_s3_icon)
			{
				SpriteHandle dataselpreview = Renderer.addSpriteHandle("fbz_icon_s3", (objA0.position.x.u16 + getScreenExtend() - 208) - getScreenExtend() + 40, posY, 0x9ff9)
				dataselpreview.setFlags(0x40)
			}
		}
		if (u16[A0 + 0x36] == 0x008 && s16[0xffffb04a + 0x2e] == 0)
		{
			if (tca.soz)
			{
				SpriteHandle dataselpreview = Renderer.addSpriteHandle("soz_icon", (objA0.position.x.u16 + getScreenExtend() - 208) - getScreenExtend() + 40, posY, 0x9ff9)
				dataselpreview.setFlags(0x40)
			}
		}
		if (u16[A0 + 0x36] == 0x000b && s16[0xffffb04a + 0x2e] == 0)
		{
			if (tca.ssz_knux && tca.knux_route)
			{
				SpriteHandle dataselpreview = Renderer.addSpriteHandle("ssz_icon_knux_released", (objA0.position.x.u16 + getScreenExtend() - 208) - getScreenExtend() + 40, posY, 0x9ff9)
				dataselpreview.setFlags(0x40)
			}
			else if (tca.ssz_sonic && Mods.isModActive("Moar Transparency") && System.getGlobalVariableValueByName("mt.teleframe"))
			{
				SpriteHandle dataselpreview = Renderer.addSpriteHandle("ssz_icon_compat", (objA0.position.x.u16 + getScreenExtend() - 208) - getScreenExtend() + 40, posY, 0x9ff9)
				dataselpreview.setFlags(0x40)
			}
		}
	}
	
	base.fn00d96a()
}

function bool Standalone.onDrawVdpSpriteCompound(s16 px, s16 py, u8 size, u16 index, u16 renderQueue, u8 spriteCounter)
{
	// New Save Slot Arrows
	if (objA0.update_address == 0x00d42c && (index == 0x93bd || index == 0x83bd))
	{
		Renderer.drawVdpSprite(px, py, size, index, 0x9ffa)
		return true
	}

	return base.Standalone.onDrawVdpSpriteCompound(px, py, size, index, renderQueue, spriteCounter)
}

function bool Standalone.onWriteToSpriteTable(s16 px, s16 py, u16 renderQueue)
{
	// Extended palette version of the Master Emerald
	if (tca.ssz_knux_emerald && global.zone_act == 0x0a01)
	{
		if (objA0.update_address == 0x07c856 || objA0.update_address == 0x07c864)
		{
			Renderer.drawSprite("ssz_rubble", px, py, 0x30, SPRITE_FLAG_PRIO, renderQueue, 0, 0xff)
			
			if (objA0.animation.sprite == 0)
				Renderer.drawSprite("master_emerald", px, py, 0xa0 + tca.bmpline * 0x10, SPRITE_FLAG_PRIO, renderQueue - 1, 0, 0xff)
			else
				Renderer.drawSprite("master_emerald_flash", px, py, 0xa0 + tca.bmpline * 0x10, SPRITE_FLAG_PRIO, renderQueue - 1, 0, 0xff)
			
			return true
		}
		
		if (objA0.update_address == 0x05ebe4)
		{
			Renderer.drawSprite("master_emerald", px, py, 0xa0 + tca.bmpline * 0x10, SPRITE_FLAG_PRIO, renderQueue, 0, 0xff)
			
			return true
		}
	}
	
	return base.Standalone.onWriteToSpriteTable(px, py, renderQueue)
}

//-----------------------
// MGZ Specific Functions
//-----------------------

// Prevent original palette flash at the end of act 1
//# address-hook(0x0511c8) end(0x051278)
function void fn0511c8()
{
	if (!tca.mgz)
	{
		base.fn0511c8()
		return
	}
	System.loadExternalRawData("MGZ2_Palette", 0x0A8F5C)
	base.fn0511c8()
	transition_state = 0
	transition_time = 0
}

// Start transition to night
//# address-hook(0x06d104) end(0x06d138)
function void fn06d104()
{
	if (!tca.mgz)
	{
		base.fn06d104()
		return
	}
	
	--objA0.countdown_value
	if (objA0.countdown_value >= 0)
		return
		
	if (objA0.value39 == 0x0a && transition_state == 0)
		transition_state = 1

	objA0.countdown_value = u16[0x06d14c + objA0.value39]
	objA0.value39 += 2
	if (objA0.value39 >= 0x20)
	{
		fn06d13c()
	}
}

// Spawn MGZ2 boss closer to the edge
//# address-hook(0x01c96e) end(0x01c9c6)
function void fn01c96e()
{
	if (!tca.mgz2boss)
	{
		base.fn01c96e()
		return
	}
	
	if (camera.position.x.u16 >= 0x3a00)
	{
		D0.u16 = (getScreenWidth() > 400) ? 0x3c80 - getScreenExtend() : 0x3c80 - (getScreenExtend() & 0xfff0)
		if (D0.u16 > camera.position.x.u16)
			return

		move_area.left = D0.u16
		move_area.left.target = D0.u16

		if (allocDynamicObjectStd())
		{
			// Trigger boss
			objA1.update_address = 0x06c31a
			objA1.position.x.u16 = 0x3d20 + getScreenWidth() / 2 - 0x2A
			objA1.position.y.u16 = 0x0668 - (getScreenHeight() - 224)
		}

		camera.update_routine += 2
	}
	else
	{
		D0 = 0x1000
		u32[0xffffee18] = D0
		u32[0xffffee10] = D0

		D0.u16 = 0x6000
		move_area.right = D0.u16
		move_area.right.target = D0.u16

		camera.update_routine -= 2
	}
}

//-----------------------
// CNZ Specific Functions
//-----------------------

// Make Eggman escape in the direction of FBZ
//# address-hook(0x067f1e) end(0x067f38)
function void fn067f1e()
{
	if !(tca.intended && tca.leftescape && global.zone == 0x03)
	{
		base.fn067f1e()
		return
	}

	objA0.render_flags &= ~render_flag.FLIP_X
	objA0.velocity.x = -0x0300
	objA0.velocity.y = 0
	objA0.countdown_value = 0x0100

	spawnChildObjects(0x0681b4)
}

//-----------------------
// FBZ Specific Functions
//-----------------------

function bool fbzInOutCheck()
{
	// Old method: u16[0xfffffc00 + 0x39 * 2] != u16[0x00052dc0 + 0x07 * 2]
	return u8[0xffffeed6] ? 1 : 0
}

//# address-hook(0x070870) end(0x0708a4)
function void fn070870()
{
	base.fn070870()
	
	move_area.left = camera.position.x.u16
}

// Move to daylight after boss.
//# address-hook(0x0708aa) end(0x07091a)
function void fn0708aa()
{
	if (!tca.fbz)
	{
		base.fn0708aa()
		return
	}
	
	if (level.wait_for_results != 0)
		return
	
	base.fn0708aa()
	transition_state = 1
}

// Explosions method... Just reusing routine from AIZ Act 1...
//# address-hook(0x07092a) end(0x070942)
function void fn07092a()
{
	if (!tca.fbz_explosions)
	{
		base.fn07092a()
		return
	}
	
	if (tca.intended && !tca.knux_fbz) || isKnucklesRoute()
	{
		if (camera.position.x.u16 >= 0x30d8 - getScreenExtend() && transition_state == 1)
		{
			transition_state = 2
			requestLoadingPatterns(0x5a)
			spawnChildObject(0x083f22, 0x00, 0, 0)
		}
		if (camera.position.x.u16 >= 0x3278 - getScreenExtend() && transition_state == 2)
		{
			transition_state = 3
			spawnChildObject(0x083f22, 0x00, 0, 0)
		}
		if (camera.position.x.u16 >= 0x3418 - getScreenExtend() && transition_state == 3)
		{
			transition_state = 4
			spawnChildObject(0x083f22, 0x00, 0, 0)
		}
	}
	
	base.fn07092a()

}

//-----------------------
// ICZ Specific Functions
//-----------------------

// Remove Time of Day change from Act 1 Boss
//# address-hook(0x0713e8) end(0x07141a)
function void fn0713e8()
{
	if (!tca.icz)
	{
		base.fn0713e8()
		return
	}
	
	fn085ba8()

	A1 = 0xffff0000 + u16[0xfffffaae]
	if (objA1.update_address == 0x08b660)
	{
		u8[A1 + 0x38] |= 0x20
	}
	
	if (!tca.intended && camera.position.y.u16 < 0x0700)
	{
		transition_state = 1
	}

	// Spawn boss giblets
	// "spawnChildObjects(0x0719b0)" replaced by:
	spawnChildObject(0x07168a, 0x00, -12, -12)
	spawnChildObject(0x07168a, 0x02, 12, -12)
	spawnChildObject(0x07168a, 0x04, -12, 12)
	spawnChildObject(0x07168a, 0x06, 12, 12)
}

// Change Time of Day after Knux boss
//# address-hook(0x071de2) end(0x071e22)
function void fn071de2()
{
	if (!tca.icz || !tca.intended)
	{
		base.fn071de2()
		return
	}
	
	if (tca.icz_trans_point && isKnucklesRoute() && transition_state == 1)
	{
		transition_state = 2
		transition_time = 0
	}
	else if (!tca.icz_trans_point && isKnucklesRoute() && transition_state == 0)
	{
		transition_state = tca.icz_trans_fade ? 1 : 2
	}
	
	base.fn071de2()
}

// Always sunny at the start of ICZ1
//# address-hook(0x23de96) end(0x23dec4)
function void fn23de96()
{
		if (!tca.icz)
		{
			base.fn23de96()
			return
		}
	
		// Set outdoor palette
		u32[A1 + 0x00] = 0x0eee0eec
		u32[A1 + 0x04] = 0x0eea0eca
		u32[A1 + 0x08] = 0x0ec80ea6
		u32[A1 + 0x0c] = 0x0e860e64
		u32[A1 + 0x10] = 0x0e400e00
		u32[A1 + 0x14] = 0x0c000000
		u32[A1 + 0x18] = 0x0aec0cea
		u16[A1 + 0x1c] = 0x0e80
		
	if (!tca.intended) // Use Sonic 3C Palette when using release order. It's a bit darker.
	{
		u16[A1 + 0x00] = 0x0eee
		u16[A1 + 0x02] = 0x0eec
		u16[A1 + 0x04] = 0x0eea
		u16[A1 + 0x06] = 0x0ec8
		u16[A1 + 0x08] = 0x0ea6
		u16[A1 + 0x0a] = 0x0e84
		u16[A1 + 0x0c] = 0x0c62
		u16[A1 + 0x0e] = 0x0a40
		u16[A1 + 0x10] = 0x0820
		u16[A1 + 0x12] = 0x0600
		u16[A1 + 0x14] = 0x0400
		u16[A1 + 0x18] = 0x0aec
		u16[A1 + 0x1a] = 0x0cea
	}
}

// Force Knux onto dawn palette
// Swap Palette from indoor to outdoor
//# address-hook(0x23e1aa) end(0x23e1d8)
function void fn23e1aa()
{
	if (!tca.icz || !tca.intended)
	{
		base.fn23e1aa()
		return
	}
	
	if (isKnucklesRoute())
	{
		fn23e20e()
	}
	else
	{
		base.fn23e1aa()
	}
}

// Force knux onto the new dawn palette and sonic onto day
//# address-hook(0x23e20e) end(0x23e23c)
function void fn23e20e()
{
	if (!tca.icz || !tca.intended)
	{
		base.fn23e20e()
		return
	}
	
	if (isKnucklesRoute())
	{
		u32 palAddress = transition_state == 0 ? 0x3fff30 : 0x3fff60
		
		if ((global.game_mode & 0x80) == 0)
			A1 = 0xfffffc62
		else
			A1 = 0xfffffce2
		
		u32[(A1+=4)-4] = u32[palAddress]
		u32[(A1+=4)-4] = u32[palAddress + 0x04]
		u32[(A1+=4)-4] = u32[palAddress + 0x08]
		u32[(A1+=4)-4] = u32[palAddress + 0x0c]
		u32[0xfffffcfc] = u32[palAddress + 0x1a]		// New line, corrects original S3&K glitch with brightest two colors in background reflections on water
		objA1.update_address = u32[palAddress + 0x10]
	}
	else
	{
		fn23e1aa()
		return
	}
}

//----------------------
// LBZ Specific Features
//----------------------

//# address-hook(0x072e30)
function void fn072e30()
{
	if (!tca.lbz || Mods.isModActive("Smoother Skies"))
	{
		base.fn072e30()
		return
	}
	
	// Sky palette fade steps
	if (u16[A0 + 0x48] == 16)
	{
		u16[0xfffffc00 + 0x3b * 2] = 0x0a66
		u16[0xfffffc00 + 0x3c * 2] = 0x0842
		u16[0xfffffc00 + 0x3d * 2] = 0x0820
		u16[0xfffffc00 + 0x3e * 2] = 0x0600
	}
	else if (u16[A0 + 0x48] == 32)
	{
		u16[0xfffffc00 + 0x3b * 2] = 0x0caa
		u16[0xfffffc00 + 0x3c * 2] = 0x0c62
		u16[0xfffffc00 + 0x3d * 2] = 0x0c42
		u16[0xfffffc00 + 0x3e * 2] = 0x0a20
	}
	else if (u16[A0 + 0x48] == 48)
	{
		u16[0xfffffc00 + 0x3b * 2] = 0x0eee
		u16[0xfffffc00 + 0x3c * 2] = 0x0ea0
		u16[0xfffffc00 + 0x3d * 2] = 0x0e64
		u16[0xfffffc00 + 0x3e * 2] = 0x0e42
		
		if !Mods.isModActive("Alternate LBZ2 Cutscene")
			Object.TriggerUnloading()
	}
	else if Mods.isModActive("Alternate LBZ2 Cutscene") && (u16[A0 + 0x48] == 68)
	{
		// We do the results here if we are change the fade point.
		objA0.update_address = 0x072e2e
		objA0.countdown_value = 0x003f
		
		level.wait_for_results = 0xff
		control.player1 = 0
		A1 = 0xffffb000
		StartCharacterWinPose()
		level.results_done = 0
		
		if (allocDynamicObjectStd())
		{
			// Level results
			objA1.update_address = addressof(LevelResults.Update)
		}
		
		if (allocDynamicObjectStd())
		{
			// Win pose for Tails
			objA1.update_address = 0x072cfa
		}
		
		Game.onZoneActCompleted(global.zone_act.apparent)
		
		fn072e2e()
		return
	}
	
	++u16[A0 + 0x48]
}

//# address-hook(0x07305a)
function void fn07305a()
{
	if (!tca.lbz || Mods.isModActive("Smoother Skies"))
	{
		base.fn07305a()
		return
	}
	
	// Handling for Big Arms fight on Sonic's path:
	//  Music change, fade to dark sky
	if (u16[A0 + 0x48] == 0)
	{
		playMusic(MUSIC_CTRL_FADEOUT)
	}
	else if (u16[A0 + 0x48] == 120)
	{
		playMusic(MUSIC_BIGARMS)
		level.boss_encounter = 2	// Usually only 0 or 1, but we're using a value of 2 here for "chooseFittingMusic"
	}

	// Sky palette fade steps
	if (u16[A0 + 0x48] == 16)
	{
		u16[0xfffffc00 + 0x3b * 2] = 0x0caa
		u16[0xfffffc00 + 0x3c * 2] = 0x0c62
		u16[0xfffffc00 + 0x3d * 2] = 0x0c42
		u16[0xfffffc00 + 0x3e * 2] = 0x0a20
	}
	else if (u16[A0 + 0x48] == 32)
	{
		u16[0xfffffc00 + 0x3b * 2] = 0x0a66
		u16[0xfffffc00 + 0x3c * 2] = 0x0842
		u16[0xfffffc00 + 0x3d * 2] = 0x0820
		u16[0xfffffc00 + 0x3e * 2] = 0x0600
	}
	else if (u16[A0 + 0x48] == 48)
	{
		u16[0xfffffc00 + 0x3b * 2] = 0x0844
		u16[0xfffffc00 + 0x3c * 2] = 0x0622
		u16[0xfffffc00 + 0x3d * 2] = 0x0400
		u16[0xfffffc00 + 0x3e * 2] = 0x0200
	}

	++u16[A0 + 0x48]
	if (u16[A0 + 0x48] <= 120)
		return

	if (allocDynamicObjectStd())
	{
		// Spawn Big Arms
		objA1.update_address = 0x074262
	}
	fn0852ae()
}

//-----------------------
// SOZ Specific Functions
//-----------------------

// Fix for allowing stage to go too far at boss
//# address-hook(0x055a7a) end(0x055a7e)
function void UpdateLevelScrolling.SOZ1()
{
	move_area.right = 0x4438 - 0x128
	base.UpdateLevelScrolling.SOZ1()
}

// Allow camera to focus on player in SOZ1 intro.
//# address-hook(0x044a26) end(0x044a62)
function void fn044a26()
{
	player1.control_override = 1
	control.player1 = 0x0800		// CONTROL_RIGHT, 0

	if (global.zone_act != 0x0800)
	{
		camera.use_forced_target = true			// Forces camera to a certain position
		camera.forced_target.x = u16[A0 + 0x30]
		camera.forced_target.y = objA0.value32
	}

	D0.u16 = u16[0xffffb000 + 0x10] + 0x10
	if (D0.u16 < u16[A0 + 0x30])
		return

	player1.control_override = 0
	player2.control_override = 0
	UnloadObject()
}

//--------------------------------
// SSZ / Ending Specific Functions
//--------------------------------

// Prevent palette shenanigans near the act start
//# address-hook(0x0659cc) end(0x065a2c)
function void fn0659cc()
{
	setupObjectAttributesFull(0x0664aa)
	objA0.update_address = 0x065a30

	objA0.position.x.u16 = 0x0200
	objA0.position.y.u16 = 0x0c68
	objA0.velocity.y = 0x0c68
	u16[A0 + 0x40] = 0xffc0
	objA0.countdown_value = 0x0100
	global.random.seed = global.framecounter

	// "spawnChildObjects(0x0665c4)" replaced by:
	spawnChildObject(0x065b0e, 0x00, 0, 0)
	spawnChildObject(0x065a8c, 0x02, 0, -51)
	spawnChildObject(0x065b42, 0x04, -32, 29)
	spawnChildObject(0x065b42, 0x06, -16, 29)
	spawnChildObject(0x065b42, 0x08, 8, 29)
	spawnChildObject(0x065b42, 0x0a, 16, 29)
	spawnChildObject(0x065b42, 0x0c, 40, 29)

	copyMemory(0xfffffce0, 0xfffffc60, 0x20)

	A1 = 0x0669b2 + 0x10
	A2 = 0xfffffc70 
	D0 = 0x07 
	while (D0.s16 >= 0)
	{
		D1.u16 = u16[(A1+=2)-2]
		if (D1.u16 != 0)
		{
			u16[A2] = D1.u16
		}
		A2 += 2
		--D0.s16
	}

	fn065a30()
}

// Transition at switch
//# address-hook(0x0658f2) end(0x065944)
function void fn0658f2()
{
	base.fn0658f2()
	if (tca.ssz_trans_point == 1)
		transition_state = 1
}

// Transition after Egg Wrecker.
//# address-hook(0x07a3e6) end(0x07a422)
function void fn07a3e6()
{
	base.fn07a3e6()
	
	if (objA0.countdown_value == 0 && transition_state == 0 && tca.ssz_trans_point == 3)
		transition_state = 1
}

// Knux Ending transition
//# address-hook(0x05e80a) end(0x05e830)
function void fn05e80a()
{
	if (!tca.ssz_knux || !tca.intended)
	{
		base.fn05e80a()
		return
	}
	
	base.fn05e80a()
	if (objA0.countdown_value < 0)
	{
		transition_state = 1
	}
}	

// Disable Knuckles' Stars during screen flash
//# address-hook(0x085ee6) end(0x085ef2)
function void fn085ee6()
{
	if (tca.intended && global.zone_act == 0x0a01)
	{
		tca.knux_stars_off = 1
		if (tca.knux_fbz != 1)
		{
			System.loadExternalRawData("SSZK_Palette_Pre_Dawn", 0x0A979C)
			for (u8 i = 0; i < 0x20; i++)
			{
				if (i != 13 && i != 14)
				{
					u16[0xfffffc00 + 0x80 + (0x21 + i)*2] = u16[0x0A977C + (0x21 + i)*2]
				}
			}
		}
	}
	
	base.fn085ee6()
}

// Dodgy fix for Knuckles falling in the floor
//# address-hook(0x07ccb0) end(0x07ccf8)
function void fn07ccb0()
{
	if (!tca.ssz_knux_csfix)
	{
		base.fn07ccb0()
		return
	}
	
	A1 = 0xffffb000
	objA1.velocity.x = 0
	objA1.groundspeed = 0x01
	objA1.velocity.y = 0 
	u8[A1 + 0x2a] = char.flag.FACING_LEFT | char.flag.IN_AIR
	u8[A1 + 0x2e] = 0
	u8[A1 + 0x20] = char.state.KNUX_FALLING
	u8[A1 + 0x2f] = 2
	knuckles.glideclimbstate |= 0x02
	
	objA1.animation.sprite = 0xcb
	
	UnloadObject()
}

// Make Dawn fade to day when sonic exits the screen.
//# address-hook(0x05e9c2) end(0x05e9e0)
function void fn05e9c2()
{
	base.fn05e9c2()
	if (tca.intended && tca.ssz_knux_fade && tca.ssz_knux_longdawn)
	{
		transition_state = 2
		transition_time = 0
	}
}

// Write Master Emerald palette to extended palette line.
//# address-hook(0x07c818) end(0x07c854)
function void fn07c818()
{
	base.fn07c818()
	
	if (tca.ssz_knux_emerald && global.zone_act == 0x0a01)
	{
		u16 offset = 3 * 0x40 + tca.bmpline * 0x20
		
		u16[0x802002 + offset] = 0xeee
		u16[0x802004 + offset] = 0xee0
		u16[0x802006 + offset] = 0x6a0
		u16[0x802008 + offset] = 0x482
		u16[0x80200a + offset] = 0x460
		u16[0x80200c + offset] = 0x622
		
		u16[0x802182 + offset] = 0xeee
		u16[0x802184 + offset] = 0xee0
		u16[0x802186 + offset] = 0x6a0
		u16[0x802188 + offset] = 0x482
		u16[0x80218a + offset] = 0x460
		u16[0x80218c + offset] = 0x622
	}
	
}

// Place Master Emerald glow cycle on extended palette line
//# address-hook(0x085a1a) end(0x085a58)
function void fn085a1a()
{
	base.fn085a1a()
	
	if (tca.ssz_knux_emerald && global.zone_act == 0x0a01)
	{
		u16 offset = 3 * 0x40 + tca.bmpline * 0x20
		
		u16[0x802006 + offset] = u16[0xfffffc5e]
		u16[0x802008 + offset] = u16[0xfffffc5c]
	}
}

//------------------
// Generic Functions
//------------------

//# address-hook(0x02d856) end(0x02d8dc)
function void TitleCard.Show()
{
	transition_state = 0
	transition_time = 0
	tca.knux_stars_off = 0
	
	if (tca.fbz && global.zone_act == 0x0400)
		tca.infbz1forreal = 1
	else
		tca.infbz1forreal = 0
		
	if (tca.fbz && global.zone_act == 0x0a00)
		tca.inssz1forreal = 1
	else
		tca.inssz1forreal = 0
		
	if (tca.icz_trans_point && isKnucklesRoute() && global.zone_act == 0x0501 && camera.position.x.u16 > 0x3ad8 - getScreenExtend())
	{
		transition_state = 1
		transition_time = 0xff
	}
	
	if (tca.mgz && global.zone_act == 0x0200 && checkpoint.number != 3)
		System.loadExternalRawData("MGZ_Palette_Original", 0x0A8F5C)
	
	base.TitleCard.Show()
}

// Sonic 3 Complete Level Select Plus Compat
function void Renderer.drawCustomSprite(u64 key, s16 px, s16 py, u8 atex, u8 flags, u16 renderQueue)
{
	if tca.fbz && (key == "S3CompleteSelect_Zone8" || key == "S3CompleteSelect_Zone8_alt")
	{
		if (!tca.fbz_s3_icon && tca.intended)
			key = tca.knux_fbz && (levelselect.characters == 3 || levelselect.characters == 4) ? "S3CompleteSelect_Zone8" : "S3CompleteSelect_FBZ"
		else if (tca.fbz_s3_icon)
			key = "S3CompleteSelect_FBZ_S3"
	}
	else if (key == "S3CompleteSelect_Zone9")
	{
		if (tca.soz)
			key = tca.intended && !tca.knux_fbz && (levelselect.characters == 3 || levelselect.characters == 4) ? "S3CompleteSelect_SOZ_Knux" : "S3CompleteSelect_SOZ"
	}
	else if (key == "S3CompleteSelect_Zone6")
	{
		if (tca.lbz)
			key = (levelselect.characters == 3 || levelselect.characters == 4) ? "S3CompleteSelect_LBZ_Knux" : "S3CompleteSelect_LBZ"
	}
	else if (key == "S3CompleteSelect_Zone12")
	{
		if (tca.intended && tca.ssz_icon && tca.ssz_sonic) && (levelselect.selection == 0x16)
			key = tca.pal_ssz_dawn ? "S3CompleteSelect_SSZ_Dawn_Pink" : "S3CompleteSelect_SSZ_Dawn"
		else if (tca.ssz_knux) && (levelselect.selection == 0x17)
			if (tca.intended)
			{
				if (tca.knux_fbz == 1)
					key = tca.pal_ssz_dawn ? "S3CompleteSelect_SSZ_Knux_Released_Dawn_Pink" : "S3CompleteSelect_SSZ_Knux_Released_Dawn"
				else
					key = "S3CompleteSelect_SSZ_Knux"
			}
			else
				key = "S3CompleteSelect_SSZ_Knux_Released"
		else if (Mods.isModActive("Moar Transparency") && System.getGlobalVariableValueByName("mt.teleframe"))
			key = "S3CompleteSelect_SSZ_C"
	}
	
	base.Renderer.drawCustomSprite(key, px, py, atex, flags, renderQueue)
}