global bool airCamCheck
global s16 oldCamDiff

define u8 global.xtrachar = u8[0xffffe654]

function s16 AC.CharacterAdjust()
{
	return (global.xtrachar == 0 && char.character == CHARACTER_TAILS) ? 1 : 5
}

//# address-hook(0x01c11e) end(0x01c236)
function void UpdateCameraPositionY()
{
	if (Mods.isModActive("Don't Stop My Glide") && isMainCharacter(CHARACTER_KNUCKLES) && dsmg.smooth_landing_setting && (char.state == char.state.KNUX_STANDUP))
	{
		base.UpdateCameraPositionY()
		return
	}

	D0.s16 = char.position.y.u16 - u16[A1] - (getScreenHeight() - 224)/2
	if (level.vertical_wrap == 0xff00)
	{
		D0.s16 &= level.height.bitmask
	}
	if (char.flags & char.flag.ROLLING)
	{
		D0.s16 -= AC.CharacterAdjust()
	}

#if STANDALONE
	// Prevent the infamous level wrap glitch
	if (Game.getSetting(SETTING_FIX_GLITCHES) && level.vertical_wrap == 0xff00)
	{
		if (D0.s16 > level.height.bitmask / 2)
		{
			D0.s16 -= level.height.bitmask
		}
	}
#endif

	D1 = D3.u16
	if (competition_mode.active)
		D1.u16 >>= 1

	if (char.flags & char.flag.IN_AIR)
	{
		airCamCheck = true
		oldCamDiff = 0
		
		D0.s16 += 0x20 - D1.u16
		if (D0.s16 < 0)
		{
			D1.u16 = 0x1800
		}
		else
		{
			D0.u16 -= 0x40
			if (D0.s16 >= 0)
			{
				D1.u16 = 0x1800
			}
			else if (u8[0xffffee32] != 0)
			{
				u8[0xffffee32] = 0
				D0 = 0
			}
			else
			{
				u16[A4] = 0
				return
			}
		}
	}
	else
	{
		D0.s16 -= D1.u16
		if (D0.s16 == 0)
		{
			airCamCheck = false
			
			if (u8[0xffffee32] != 0)
			{
				u8[0xffffee32] = 0
				D0 = 0
			}
			else
			{
				u16[A4] = 0
				return
			}
		}
		else
		{
			if (airCamCheck)
			{
				u8 camMulti = 0x38
				if oldCamDiff > 0 && abs(D0.s16) > 0x22 && oldCamDiff < abs(D0.s16)
				{
					airCamCheck = false
					D1.u16 = 0x600
				}
				else
				{
					D1.u16 = max( (abs(D0.s16)/2) * (max(abs(s16[A0 + 0x1c]), 0x300)/0x300) * camMulti, camMulti)
				}
				
				oldCamDiff = abs(D0.s16)
			}
			else if (u8[0xffffee39] != 0)
			{
				D1.u16 = 0x1800
			}
			else if (abs(s16[A0 + 0x1c]) >= 0x800)
			{
				D1.u16 = 0x1800
			}
			else
			{
				D1.u16 = 0x600
			}
		}
	}

	s16 threshold = (D1.u16 >> 8)
	if (D0.s16 > threshold)
	{
		D1.s32 = D1.s16 << 8
		D1 += u32[A1]
		D1 = (D1 << 16) + (D1 >> 16)
	}
	else if (D0.s16 < -threshold)
	{
		D1.s32 = (-D1.s16) << 8
		D1 += u32[A1]
		D1 = (D1 << 16) + (D1 >> 16)
	}
	else
	{
		D1 = D0.u16
		D1.u16 += u16[A1]
	}

	if (D0.s16 < 0)
	{
		if (D1.s16 <= s16[A2 + 4])
		{
			if (D1.s16 <= -0x100)
			{
				D1.u16 &= level.height.bitmask
			}
			else
			{
				D1.u16 = u16[A2 + 4]
			}
		}
	}
	else
	{
		if (D1.s16 >= s16[A2 + 6])
		{
			u16 levelHeight = level.height.bitmask + 1
			D1.u16 -= levelHeight
			if (D1.s16 >= 0)
			{
				u16[A1] -= levelHeight
			}
			else
			{
				D1.u16 = u16[A2 + 6]
			}
		}
	}

	D4.u16 = u16[A1]
	D1 = (D1 << 16) + (D1 >> 16)
	D3 = D1 - u32[A1]
	D3 = (D3 >> 8) + (D3 << 24)
	u16[A4] = D3.u16
	u32[A1] = D1

	if (competition_mode.active)
	{
		D1 = (D1 << 16) + (D1 >> 16)
		D1.u16 &= level.height.bitmask
		u16[A1] = D1.u16
	}
}