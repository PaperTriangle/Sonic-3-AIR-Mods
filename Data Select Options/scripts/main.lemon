//# address-hook(0x00c890) end(0x00c95c)
function void fn00c890()
{		
	// Render "New" or static noise for the slots
	D0.u16 = level.framecounter & 0x0c
	A2 = 0x200000 + u32[0x3a216a + D0.u16]
	D7.u16 = Mods.isModActive("Origins Screen Resolution") ? 0xc31a : 0xc21a
	A0 = 0xffffe6ac
	for (u8 slot = 0; slot < 8; ++slot)
	{
		A1 = (s8[A0] >= 0) ? A2 : 0x3a20de
		D0 = VDPHelper.getDirectVRAMWriteCode(D7.u16)
		D1 = 9
		D2 = 6
		fn001506()

		D7.u16 += 0x1a
		A0 += 10
	}

	A3 = 0xffffb128
	D7.u16 = Mods.isModActive("Origins Screen Resolution") ? 0xcb20 : 0xca20
	A0 = 0xffffe6ac
	for (u8 slot = 0; slot < 8; ++slot)
	{
		D0.u16 = D7.u16 - 2
		VDP.setupVRAMWrite(D0)
		VDP.writeData16(sprite_attribute.PRIORITY | 0x02b1)		// Render a small black bar to complete the save slot graphic

		if (s8[A0] >= 0)
		{
			if (Mods.isModActive("Time Consistent Adventure") && System.getGlobalVariableValueByName("tca.intended") || Mods.isModActive("Useott's Original Zone Order"))
			{
				u16 tca.ds_char = u16[A3 + 0x34]
		
				bool tca.knux_route = false
				
			#if EXTRA_CHARACTER_FRAMEWORK_ACTIVE
				if !ECF_dataselect_getStr(A3)
			#endif
				{
					if (tca.ds_char == 3 || tca.ds_char == 4)
						tca.knux_route = true
					else if (tca.ds_char > 4) && MISC.getAllowedZones(tca.ds_char - 1) == 0x0b
						tca.knux_route = true
				}
			
				if (u8[A3 + 0x3a] == u8[A3 + 0x37] && u8[A3 + 0x3b] != 0)
				{
					// Render "CLEAR" label
					A1 = 0x00db36
					D0.u16 = D7.u16
					fn00d9f4()
				}
				else
				{
					// Render "ZONE" label
					A1 = 0x00db31
					D0.u16 = D7.u16 - 2
					fn00d9f4()

					//This is the modified content, everything else should be untouched.
					// Render zone number
					D0.u16 = u16[A3 + 0x36] * 2
					if !tca.knux_route
					{
						if (u16[A3 + 0x36] == 4 || u16[A3 + 0x36] == 5 || u16[A3 + 0x36] == 6)
							D0.u16 += 2
						if u16[A3 + 0x36] == 7
							D0.u16 -= 6
					}
					else if (!System.getGlobalVariableValueByName("tca.knux_fbz") && u16[A3 + 0x36] >= 8)
						D0.u16 -= 2

					// Second digit (10, 20, etc)
					D1 = u8[0x00c95e + D0.s16]
					if (D1.s8 < 0)
					{
						D1.u16 = (sprite_attribute.PRIORITY | 0)
					}
					else
					{
						D1.u16 += (sprite_attribute.PRIORITY | sprite_attribute.PALETTE.LINE1 | (DataSelect.TextTiles.targetInVRAM >> 5))
					}
					VDP.writeData16(D1.u16)

					// First digit (1, 2, etc)
					D1 = (sprite_attribute.PRIORITY | sprite_attribute.PALETTE.LINE1 | (DataSelect.TextTiles.targetInVRAM >> 5)) + u8[0x00c95f + D0.s16]
					VDP.writeData16(D1.u16)
				}
			}
			else
			{
				if (u8[A3 + 0x3a] == u8[A3 + 0x37] && u8[A3 + 0x3b] != 0)
				{
					// Render "CLEAR" label
					A1 = 0x00db36
					D0.u16 = D7.u16
					fn00d9f4()
				}
				else
				{
					// Render "ZONE" label
					A1 = 0x00db31
					D0.u16 = D7.u16 - 2
					fn00d9f4()

					// Render zone number
					D0.u16 = u16[A3 + 0x36] * 2

					// Second digit (10, 20, etc)
					D1 = u8[0x00c95e + D0.s16]
					if (D1.s8 < 0)
					{
						D1.u16 = (sprite_attribute.PRIORITY | 0)
					}
					else
					{
						D1.u16 += (sprite_attribute.PRIORITY | sprite_attribute.PALETTE.LINE1 | (DataSelect.TextTiles.targetInVRAM >> 5))
					}
					VDP.writeData16(D1.u16)

					// First digit (1, 2, etc)
					D1 = (sprite_attribute.PRIORITY | sprite_attribute.PALETTE.LINE1 | (DataSelect.TextTiles.targetInVRAM >> 5)) + u8[0x00c95f + D0.s16]
					VDP.writeData16(D1.u16)
				}
			}
		}
		else
		{
			// Render empty tiles
			A1 = 0x00db2b
			D0.u16 = D7.u16
			fn00d9f4()
		}

		D7.u16 += 0x1a
		A0 += 10
		A3 += 0x4a
	}

	fn00c97a()
}

//# address-hook(0x00d69e) end(0x00d6ca)
function void fn00d69e()
{
	// Used by all character icons, the zone preview image, and Robotnik
	objA0.position.x.u16 = u16[A0 + 0x12] - camera.foreground.x.u16
	objA0.compound.sprite1.position.x = objA0.position.x.u16
	objA0.compound.sprite1.position.y = objA0.position.y.u16
	objA0.compound.sprite2.position.x = objA0.position.x.u16
	objA0.compound.sprite2.position.y = objA0.position.y.u16
	if (objA0.compound.sprite1.animation.sprite == 0x1a)
	{
		objA0.compound.sprite1.position.y -= 8
	}

#if STANDALONE
	// Prevent too early clipping
	objA0.box_size.x = 0x28
#endif

	// Note that "Knuckles & Tails" uses objA0.animation.sprite == 8
	//  -> We handle that in Standalone.onDrawVdpSpriteCompound

	DrawObject()
}

// What route is the character on?
function u8 MISC.getAllowedZones(u8 slotnum)
{
    // add exceptions for your individual character like this:
    // if (slotnum == CHARACTER_CUSTOM)
    //    return 0x0d
	// 
	// for reference:
	// 0x0d - Sonic zones (includes doomsday)
	// 0x0c - Tails zones (excludes doomsday)
	// 0x0b - Knux zones (ends at ssz)

	return base.MISC.getAllowedZones(slotnum)
}

// Level Select Changes!
function void EntryFunctions.levelSelect()
{
	if Mods.isModActive("Origins Screen Resolution")
	{
		Renderer.setScreenSize(System.getGlobalVariableValueByName("screen_width"), 240)
		System.setGlobalVariableValueByName("set_screen_size", 1)
	}

	Renderer.resetSprites()

	base.EntryFunctions.levelSelect()
}

// Render extra char slots lower...
function void Renderer.drawCustomSprite(u64 key, s16 px, s16 py, u8 atex, u8 flags, u16 renderQueue)
{
	if Mods.isModActive("Origins Screen Resolution")
	{
		if (global.game_mode == 0x28 || global.game_mode == 0x1c)
			py += 8
		
	#if EXTRA_CHARACTERS_UNLIMITED
		if Mods.isModActive("Sonic 3 Complete Level Select+") && (global.xtrachar == 0x04) && (key == "level_select_S3C_M_Mighty" || key == "level_select_S3C_S3_Mighty")
		{
			base.Renderer.drawCustomSprite(key, px, py, atex, flags, renderQueue)
			base.Renderer.drawCustomSprite(RenderExtraCharIcon(0x02), px + 0x10, py, atex, flags, renderQueue)
			return
		}
	#endif
	}
	
	if lsds.alphashadow && (key == "S3CompleteSelect_Border")
	{
		key = "s3cls_border"
		Renderer.drawCustomSprite("s3cls_border_shadow" , px, py, 0x00, 0, renderQueue, 0, 0x80)
	}
	
	base.Renderer.drawCustomSprite(key, px, py, atex, flags, renderQueue)
}

// Push text down!
function void LevelSelect.init()
{
	base.LevelSelect.init()
	
	if (lsds.levelselect)
	{
		Renderer.drawCustomSprite("custom_ls_bg", s16(getScreenWidth() - 426)/2 - 43, -8, 0x10, 0, 0x1000)
	}
	
	if Mods.isModActive("Origins Screen Resolution")
		scrolloffset.y.planeA -= 8
}

// Fix up Extra Slot Character Selection
//# address-hook(0x007e64) end(0x007f1e)
//# translated(0x007f46) end(0x007f60)
function void fn007e64()
{
	u8 oldXtraChar = global.xtrachar
	
	base.fn007e64()
	
#if EXTRA_CHARACTERS_UNLIMITED
	if (lsds.esureorder && (Mods.isModActive("Extra Slot Amy") || Mods.isModActive("Extra Slot Amy SHC")) && (Mods.isModActive("Extra Slot Mighty") || Mods.isModActive("Extra Slot Mighty SHC")) && (Mods.isModActive("Extra Slot Ray") || Mods.isModActive("Extra Slot Ray SHC")))
	{
		if (global.xtrachar == 0x00 && oldXtraChar == 0x04)
		{
			levelselect.characters = CHARS_SONIC_ALONE
			global.xtrachar = 0x01
			levelselect.xtrachar = true
		}
		else if (global.xtrachar == 0x01 && oldXtraChar == 0)
			global.xtrachar = 0x03
		else if (global.xtrachar > 0x04 && oldXtraChar == (Mods.isModActive("Extra Slot Mighty & Ray") ? 0x04 : 0x03))
			global.xtrachar = 0x01
		else if (global.xtrachar == 0x03 && oldXtraChar == 0x02)
		{
			global.xtrachar = 0x04
			
			if (global.xtrachar < ExtraChar.getHighestSlot())
			{
				for (u8 A = 0x01; A <= 0xff; ++A)
				{
					if (Renderer.hasCustomSprite(stringformat("dataSel_slot%d", A)) && A > global.xtrachar)
					{
						global.xtrachar = A
						levelselect.characters = CHARS_SONIC_ALONE
						ExtraChar.startupWithExtraChar()
						break
					}
				}
			}
			// If the extra variable is equal to the highest slot, then reset the variables and go to the next default slot
			else
			{
				global.xtrachar = 0x00
				levelselect.characters = 0x00
				levelselect.xtrachar = false
			}
		}
	}
#endif
}

// Draw background and quit out!
function bool LevelSelect.innerUpdate()
{
	if (lsds.levelselect && Mods.isModActive("Sonic 3 Complete Level Select+"))
	{
		Renderer.drawCustomSprite("custom_ls_bg", s16(getScreenWidth() - 426)/2 - 43, -8, 0x10, 0, 0x1000)
	}
	
	if lsds.backtotitle && ((control.pad1.pressed & CONTROL_B || Input.buttonPressed(BUTTON_BACK)) || (levelselect.selection == 0x22 && (control.pad1.pressed | control.pad2.pressed) & CONTROL_START))
	{
		playSound(0xad)
		FadeOutScreenBlocking()

		global.game_mode = 0x04
		Audio.fadeOutChannel(0, 0x40)
		return false
	}
	
	
	return base.LevelSelect.innerUpdate()
}

