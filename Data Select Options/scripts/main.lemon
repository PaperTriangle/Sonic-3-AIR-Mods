global bool lsds.leftshift
global bool lsds.noflicker
global u8 lsds.traded_emeralds
global bool lsds.alphashadow
global bool lsds.nodetail
global bool lsds.backtotitle
global u8 lsds.noknuxtails
global u8 lsds.amyicon
global bool lsds.esureorder
global bool lsds.levelselect

define u8 global.xtrachar = u8[0xffffe654]

global u16 oldposy = 0
global bool inDataSelect

function void DataSelect.setup()
{
	inDataSelect = true
	base.DataSelect.setup()
	
	if (lsds.leftshift)
	{
		camera.foreground.x.u16 += getScreenExtend()
		u16[0xffffe002] -= getScreenExtend()
		u16[0xffffb000 + 0x14] += 0x05
	}
	
	if Mods.isModActive("Origins Screen Resolution")
		u16[0xffffb000 + 0x14] += 0x06

}

//# address-hook(0x003be4) end(0x003c02)
function void FadeOutScreenBlocking()
{
	base.FadeOutScreenBlocking()
	inDataSelect = false
}

function void EntryFunctions.dataSelect()
{
	if Mods.isModActive("Origins Screen Resolution")
	{
		Renderer.setScreenSize(System.getGlobalVariableValueByName("screen_width"), 240)
		System.setGlobalVariableValueByName("set_screen_size", 1)
	}
	
	base.EntryFunctions.dataSelect()
}

//# address-hook(0x00d1b6) end(0x00d1f4)
function void fn00d1b6()
{
	if (!lsds.leftshift)
	{
		base.fn00d1b6()
		return
	}
	
	D0.u16 = 0xa8
	D1 = 0
	D2 = dataselect.slot_selected - 1
	while (D2.s16 >= 0)
	{
		D4 = 0x0c
		while (D4.s16 >= 0)
		{
			if (D0.u16 > 0x0118 + getScreenExtend() && D1.u16 <= 0x02b8 + getScreenExtend())
			{
				D1.u16 += 8
			}
			else
			{
				D0.u16 += 8
			}
			--D4.s16
		}
		--D2.s16
	}

	u16[A0 + 0x12] = D0.u16
	camera.foreground.x.u16 = D1.u16
	u16[0xffffe002] = -D1.s16

	objA0.update_address = 0x00d1fa
	fn00d1fa()
}


//# address-hook(0x00d1fa) end(0x00d30a)
function void fn00d1fa()
{
#if STANDALONE
	if (u16[0xffffeee4] == 0 && (control.pad1.pressed & DataSelect.CONTROLS_CANCEL || Input.buttonPressed(BUTTON_BACK)))
#else
	if (u16[0xffffeee4] == 0 && (control.pad1.pressed & DataSelect.CONTROLS_CANCEL))
#endif
	{
		// Back to the intro / title screen
		global.game_mode = 0x04

		if (!lsds.backtotitle)
		{
		#if STANDALONE
			playSound(0xad)
			DataSelect.drawCustomPlanes()	// Required here, otherwise we can have one frame without custom plane setup if returning already during the fade-in
		
			u32 backupA0 = A0
			FadeOutScreenBlocking()
			A0 = backupA0
		
			// Do not fade out music in this case, Data Select music is meant to keep playing
			Game.returnToMainMenu()
			yieldExecution()
		#endif
		}
		return
	}
	
	if (!lsds.leftshift)
	{
		base.fn00d1fa()
		return
	}
	

	if (u16[0xffffeee2] == 0)
	{
		bool skipPart = false
		if (u16[A0 + 0x30] == 0)
		{
			D0 = 0
			if (control.pad1.pressed & CONTROL_LEFT)
			{
				if (u16[0xffffeee4] == 0 || dataselect.slot_selected != 1)
				{
					if (dataselect.slot_selected != 0)
					{
						--dataselect.slot_selected
						u8 sfx = (u16[0xffffeee4] != 0) ? 0x7b : 0xb7
						playSound(sfx)
						D0 = -8
					}
				}
			}
		#if STANDALONE
			else	// Don't allow both left & right being pressed at the same time, as this leads to buggy behavior
		#endif
			if (control.pad1.pressed & CONTROL_RIGHT)
			{
				if (dataselect.slot_selected != 9)
				{
					++dataselect.slot_selected
					u8 sfx = (u16[0xffffeee4] != 0) ? 0x7b : 0xb7
					playSound(sfx)
					D0 = 8
				}
			}

			objA0.countdown_value = D0.u16
			if (objA0.countdown_value != 0)
			{
				u16[A0 + 0x30] = 0x0d
			}
			else
			{
				skipPart = true
			}
		}

		if (!skipPart)
		{
			D0.u16 = u16[A0 + 0x12]		// Position of cursor on screen
			s16 moveStep = objA0.countdown_value

			D0.s16 += moveStep
			if (moveStep >= 0)
			{
				if (D0.s16 > s16(0x120 + getScreenExtend()))
				{
					camera.foreground.x.u16 += moveStep
					if (s16(camera.foreground.x.u16) > s16(0x2c0 - getScreenExtend() * 2))
					{
						camera.foreground.x.u16 -= moveStep
					}
					else
					{
						D0.s16 -= moveStep
					}
				}
			}
			else
			{
				if (D0.s16 < s16(0x120 + getScreenExtend()))
				{
					camera.foreground.x.u16 += moveStep
					if (s16(camera.foreground.x.u16) < 0x0000)
					{
						camera.foreground.x.u16 -= moveStep
					}
					else
					{
						D0.s16 -= moveStep
					}
				}
			}

			u16[A0 + 0x12] = D0.u16
			--u16[A0 + 0x30]
		}
	}

	D2 = 0
	if (dataselect.slot_selected == 0)
	{
		D2.s16 = 8
	}
	else if (dataselect.slot_selected == 9)
	{
		D2.s16 = -8
	}

	D2.u16 += u16[A0 + 0x12]
	objA0.position.x.u16 = D2.u16

	// Determine size of the cursor (large or small)
	objA0.animation.sprite = (D2.u16 >= 0xf0 && D2.u16 <= 0x148 + getScreenExtend() * 2) ? 1 : 2

	if (level.framecounter.low & 0x04)
	{
		DrawObject()
	}
}

function void DataSelect.update()
{
	if (!lsds.noflicker)
	{
		base.DataSelect.update()
		return
	}
	while (true)
	{
		global.frame_state = 0x1e
		waitForNextFrame()
	@EntryPoint:

		DataSelect.drawCustomPlanes()


		++level.framecounter
		UpdateGameObjects()
		u16[0xffffe002] = -camera.foreground.x.u16
		RenderSprites()

		A0 = 0xfffffc42
		++emerald.animframe
		if (emerald.animframe >= 3)
			emerald.animframe = 0

		copyMemory(A0, 0x00ca9a, 0x1e)

		// Data Select
		if (global.game_mode != 0x4c)
			break
	}

	playSound(0xaf)
}

function bool Game.isSecretUnlocked(u32 secretId)
{
	if lsds.noknuxtails && (global.game_mode == 0x4c || lsds.noknuxtails == 2) && secretId == SECRET_KNUX_AND_TAILS
		return false
	
	return base.Game.isSecretUnlocked(secretId)
}

// Data Select Order Swap ESU
//# address-hook(0x00d6d0) end(0x00d70a)
function void fn00d6d0()
{
	u8 originalCharacter = D0.u8
	u8 oldXtraChar = objA0.animation.timer
	
	base.fn00d6d0()
	
#if EXTRA_CHARACTERS_UNLIMITED
	if (lsds.esureorder && (Mods.isModActive("Extra Slot Amy") || Mods.isModActive("Extra Slot Amy SHC")) && (Mods.isModActive("Extra Slot Mighty") || Mods.isModActive("Extra Slot Mighty SHC")) && (Mods.isModActive("Extra Slot Ray") || Mods.isModActive("Extra Slot Ray SHC")))
	{
		if (objA0.animation.timer == 0x00 && oldXtraChar == (Mods.isModActive("Extra Slot Mighty & Ray") ? 0x04 : 0x03))
		{
			D0.u8 = 0x01
			objA0.animation.timer = 0x01
		}
		else if (objA0.animation.timer == 0x00 && oldXtraChar == 0x01)
		{
			D0.u8 = 0x01
			objA0.animation.timer = Mods.isModActive("Extra Slot Mighty & Ray") ? 0x04 : 0x03
		}
		else if (objA0.animation.timer == 0x01 && oldXtraChar == 0)
			objA0.animation.timer = 0x03
		else if (objA0.animation.timer > 0x04 && oldXtraChar == (Mods.isModActive("Extra Slot Mighty & Ray") ? 0x04 : 0x03))
			objA0.animation.timer = 0x01
		else if Mods.isModActive("Extra Slot Mighty & Ray") && (objA0.animation.timer == 0x04 && oldXtraChar == 0)
			objA0.animation.timer = 0x02
		else if (objA0.animation.timer == 0x03 && oldXtraChar == 0x00)
			objA0.animation.timer = 0x02
		else if (objA0.animation.timer == 0x02 && oldXtraChar == 0x03)
		{
			objA0.animation.timer = 0x00
			D0.u8 = Game.isSecretUnlocked(SECRET_KNUX_AND_TAILS) ? 0x04 : 0x03
		}
		else if (objA0.animation.timer == (Mods.isModActive("Extra Slot Mighty & Ray") ? 0x04 : 0x03) && oldXtraChar > 0x04)
			objA0.animation.timer = 0x02
		else if (objA0.animation.timer == 0x03 && oldXtraChar == 0x02)
		{
			objA0.animation.timer = 0x04
			
			if (objA0.animation.timer < ExtraChar.getHighestSlot())
			{
				for (u8 A = 0x01; A <= 0xff; ++A)
				{
					if (Renderer.hasCustomSprite(stringformat("dataSel_slot%d", A)) && A > objA0.animation.timer)
					{
						objA0.animation.timer = A
						break
					}
				}
			}
			// If the extra variable is equal to the highest slot, then reset the variables and go to the next default slot
			else
			{
				objA0.animation.timer = 0x00
				D0.u8 = 0x00
			}
		}
	}
#endif

}

#if STANDALONE
function void DataSelect.drawCustomPlanes()
{
	if Mods.isModActive("Origins Screen Resolution")
	{
		// Draw our own widescreen version of the background
		// TODO: The actual background still gets rendered, though it's not visible at all
		//  -> Maybe the plane W is used here?
		Renderer.drawCustomSprite("wide_bg_dataselect", getScreenExtend() - 96, 0, 0x00, 0, 0x2000)

		// Custom rendering of plane B (which is not the background here) to ignore the wrapping
		s16 px = s16(camera.foreground.x.u16)
		if (px < 0)
		{
			Renderer.enableDefaultPlane(2, false)
			Renderer.setupPlane(-px, 0, getScreenWidth() + px, getScreenHeight(), 0x10, 0, 0x3000)
		}
		else if (px > 0x400 - getScreenWidth())
		{
			Renderer.enableDefaultPlane(2, false)
			Renderer.setupPlane(0, 0, 0x400 - px, getScreenHeight(), 0x10, 0, 0x3000)
		}
		return
	}
	
	base.DataSelect.drawCustomPlanes()
}
#endif

function bool Standalone.onWriteToSpriteTable(s16 px, s16 py, u16 renderQueue)
{
	u8 gameMode = global.game_mode & 0x7f

	if (inDataSelect)
	{
		if Mods.isModActive("Origins Screen Resolution")
			py += 8
		
		if ((objA0.mapping_offset == 0x00ce0e || objA0.mapping_offset == 0x20bd68))
		{
			if (objA0.update_address == 0x00d42c)
			{
				Renderer.drawCustomSprite("large_border_frame", px, (lsds.nodetail) ? py - 0x10 : py, 0x00, 0, renderQueue - 100)
				Renderer.drawCustomSprite(lsds.alphashadow ? "large_border_shadow" : "large_regular_border_shadow" , px, (lsds.nodetail) ? py - 0x10 : py, 0x00, 0, renderQueue - 100, 0, lsds.alphashadow ? 0x80 : 0xff)
			}
			else if (objA0.update_address == 0x00d30c)
			{
				Renderer.drawCustomSprite("small_border_frame", px, py, 0x00, 0, renderQueue - 100)
				Renderer.drawCustomSprite(lsds.alphashadow ? "small_border_shadow" : "small_regular_border_shadow", px, py, 0x00, 0, renderQueue - 100, 0, lsds.alphashadow ? 0x80 : 0xff)
			}
			else if (objA0.update_address == 0x00d782)
			{
				Renderer.drawCustomSprite("small_border_frame", 0x3c8 - camera.foreground.x.u16, py - 16, 0x00, 0, renderQueue - 100)
				Renderer.drawCustomSprite(lsds.alphashadow ? "small_border_shadow" : "small_regular_border_shadow", 0x3c8 - camera.foreground.x.u16, py - 16, 0x00, 0, renderQueue - 100, 0, lsds.alphashadow ? 0x80 : 0xff)
			}
		}
		
		u8 slotnum = max(s16(u16[A0 + 0x34] - 1), 0) // Character selection AFTER Knuckles & Tails
		bool ecf_slot = false
	#if EXTRA_CHARACTER_FRAMEWORK_ACTIVE
		if ECF_dataselect_getStr()
			ecf_slot = true
	#endif
		
		// ES Amy Icon for regular charactersprite
		if (lsds.amyicon && u8[A0 + 0x23] == 0x1b && (slotnum < 4) && !ecf_slot && (u8[A0 + 0x38] == 0xff && objA0.animation.timer == 0 && u16[0xffffb04a + 0x30] == 0))
		{
			u64 portrait = "Clear_slot3"
			u16 py_shift = 0
			if (lsds.amyicon == 2)
				portrait = "dataSel_savePortrait_clear_char4"
			else if (lsds.amyicon == 3)
			{
				portrait = "saveimage_JUWL-Amy_3"
				py_shift += 0x78
			}
			
			if (Renderer.hasCustomSprite(portrait))
			{
				Renderer.drawCustomSprite(portrait, px, py - py_shift - (lsds.nodetail ? 0x10 : 0), 0, SPRITE_FLAG_PRIO, renderQueue)
				u8[A0 + 0x23] = 0
			}
		}
		
	#if EXTRA_CHARACTER_FRAMEWORK_ACTIVE
		if (lsds.nodetail && (objA0.update_address == 0x00d30c || objA0.update_address == 0x00d42c))
		{
			string name = ECF_dataselect_getStr()
			string id = ECF_dataselect_getNum()

			if (name)
			{
				ECF_drawCharSelectSpr(name, id, px, py - 20, renderQueue)
				if (objA0.update_address == 0x00d42c && u8[u32[A0 + 0x30]] != 0x80 && u8[A0 + 0x1d] < 0x1d && u8[A0 + 0x1d] != 0x0f)
					ECF_drawCharSelectSprIcons(name, id, px, py, renderQueue)
				objA0.animation.sprite = 0
				
				if (objA0.compound.count >= 2 && objA0.value26 && objA0.update_address == 0x00d42c)
				{
					u64 key = stringformat("saveimage_%s_%d", name, objA0.value26)
					if (!Renderer.hasCustomSprite(key))
						key = "saveimage_unknown"
						
					SpriteHandle zone = Renderer.addSpriteHandle(key, px, py - 136, renderQueue)
					zone.setFlags(SPRITE_FLAG_PRIO)
					zone.setPaletteOffset(0x30)
					objA0.compound.count = 1
					return false
				}
				return false
			}
		}
	#endif
		
	#if MISC_ACTIVE
		if (slotnum > 3)
		{
			if (objA0.update_address == 0x00d42c && objA0.animation.frame > 0x17 && u8[A0 + 0x38] == 0xff && u16[0xffffb04a + 0x30] == 0)
			{
				px = (objA0.position.x.u16 - 0xa8) + 40
				string key = MISC.getClearPortrait(objA0.value3b, slotnum)
				if (Renderer.hasCustomSprite(key))
				{
					MISC.drawPortraitSprite(key, px, py - (lsds.nodetail ? 0x10 : 0), 0x00, SPRITE_FLAG_PRIO, renderQueue - 1, slotnum)
					u8[A0 + 0x23] = 0
				}
			}
		}
	#endif
		
	#if EXTRA_CHARACTERS_UNLIMITED
		// Hackey way to handle extra slot compat...
		if (lsds.nodetail && objA0.update_address == 0x00d42c && objA0.animation.sprite == 0x05 && objA0.animation.timer > 0x00)
		{
			
			if (u8[A0 + 0x38] == 0xff && objA0.animation.sprite == 5 && objA0.animation.timer != 0 && u16[0xffffb04a + 0x30] == 0)
			{
				u8 xtrachar = (Mods.isModActive("Extra Slot Mighty & Ray") && objA0.animation.timer == 0x04) ? 0x01 : objA0.animation.timer
				u64 portrait = 0
				u64 portraitesp = 0
				if (u8[A0 + 0x23] == 0x18)
					portrait = stringformat("dataSel_savePortrait_slot%d", xtrachar)
				else if (u8[A0 + 0x23] == 0x19)
					portrait = stringformat("dataSel_savePortrait_superslot%d", xtrachar)
				else if (u8[A0 + 0x23] == 0x1b)
				{
					portrait = stringformat("dataSel_savePortrait_clear_slot%d", xtrachar)
					portraitesp = stringformat("Clear_slot%d", xtrachar)
				}

				if (Renderer.hasCustomSprite(portrait))
				{
					Renderer.drawCustomSprite(portrait, px, py - 16, 0, SPRITE_FLAG_PRIO, renderQueue - 100)
					u8[A0 + 0x23] = 0
				}
				
				if (Renderer.hasCustomSprite(portraitesp))
				{
					Renderer.drawCustomSprite(portraitesp, px, py - 16, 0, SPRITE_FLAG_PRIO, renderQueue - 100)
					u8[A0 + 0x23] = 0
				}
			}
			
			ExtraChar.DataSelect.drawCharacterSprite(px, py, renderQueue)
			
			return false
			
		}
		else if (objA0.animation.sprite == 5 && objA0.animation.timer != 0)
		{
			renderQueue -= 100
		}
	#endif
	}

	return base.Standalone.onWriteToSpriteTable(px, py, renderQueue)
}

function bool Standalone.onDrawVdpSprite(s16 px, s16 py, u8 size, u16 index, u16 renderQueue)
{
	u8 gameMode = global.game_mode & 0x7f

	if (inDataSelect) && Mods.isModActive("Origins Screen Resolution")
	{
		Renderer.drawVdpSprite(px, py + 0x08, size, index, renderQueue)
		return true
	}
	
	return base.Standalone.onDrawVdpSprite(px, py, size, index, renderQueue)
}

function bool Standalone.onDrawVdpSpriteCompound(s16 px, s16 py, u8 size, u16 index, u16 renderQueue, u8 spriteCounter)
{
	u8 gameMode = global.game_mode & 0x7f

	if (inDataSelect)
	{
		// New Save Slot Arrows
		if (lsds.nodetail && objA0.update_address == 0x00d42c && (index == 0x93bd || index == 0x83bd) && u8[A0 + 0x38] == 0)
		{
			Renderer.drawVdpSprite(px, py + (Mods.isModActive("Origins Screen Resolution") ? 0x18 : 0x10), size, index, renderQueue)
			return true
		}
		
		if Mods.isModActive("Origins Screen Resolution")
		{
			if Mods.isModActive("Time Consistent Adventure") && (objA0.update_address == 0x00d42c && (index == 0x93bd || index == 0x83bd))
				return base.Standalone.onDrawVdpSpriteCompound(px, py + 0x08, size, index, renderQueue, spriteCounter)
				
			if index != 0xab0b && index != 0xab17
				Renderer.drawVdpSprite(px, py + 0x08, size, index, renderQueue)
			return true
		}
	}

	return base.Standalone.onDrawVdpSpriteCompound(px, py, size, index, renderQueue, spriteCounter)
}

function void ExtraChar.DataSelect.drawCharacterSprite(s16 px, s16 py, u16 renderQueue)
{
	base.ExtraChar.DataSelect.drawCharacterSprite(px, py, renderQueue)
}

//# address-hook(0x001506) end(0x00da1c)
function void fn001506()
{
	if ((D0.u16 == D7.u16 - 2) && (A2 != 0x200000 + u32[0x3a216a + D0.s16]))
		return

	if (A1.u16 == 0x00 || A1.u16 == 0x104 || A1.u16 == 0x222)
		return
	
	base.fn001506()
}

//# address-hook(0x00d9f4) end(0x00da1c)
function void fn00d9f4()
{

	if (A1 == 0x00db36)
	{
		D0 -= 1
		// Render empty tiles
		A1 = 0x00db2b
		base.fn00d9f4()

		// Render "CLEAR" label
		A1 = 0x00db36
		D0.u16 = D7.u16
		base.fn00d9f4()
		
		return
	}
	else if (A1 == 0x00db2b)
	{
		// Render empty tiles
		A1 = 0x00db2b
		base.fn00d9f4()
		
		D0 -= 2
		A1 = 0x00db2b
		base.fn00d9f4()
		
		return
	}

	if Mods.isModActive("Origins Screen Resolution") && (A1 != 0x00db31)
		D0.u16 += 0x100

	base.fn00d9f4()
}

//# address-hook(0x00c97a) end(0x00ca12)
function void fn00c97a()
{
	if (lsds.nodetail)
		return
	
	if Mods.isModActive("Origins Screen Resolution")
	{
		A2 = 0x00da8a
		A3 = 0xffffb128
		D7.u16 = 0xd220 + 0x100
		A0 = 0xffffe6ac
		for (u8 slot = 0; slot < 8; ++slot)
		{
			bool saveGameSlotUsed = (u8[A0] & 0x80) == 0
			u16 characters = u16[A3 + 0x34]
			if (!saveGameSlotUsed)
			{
				characters = CHARS_SONIC_AND_TAILS
			}
			else if (characters == CHARS_SONIC_AND_TAILS)	// Handle Sonic & Tails - show Sonic's icons
			{
				characters = CHARS_SONIC_ALONE
			}
		#if STANDALONE
			else
			{
				characters = min(characters, 3)		// Handle Knuckles & Tails - show Knuckles' icons
			}
		#endif

			u8 ecf_slot = false

		#if EXTRA_CHARACTER_FRAMEWORK_ACTIVE
			ecf_slot = Renderer.hasCustomSprite(getECFCharacterSelectSpriteKey(ECF_dataselect_getStr(A3)))
		#endif		
			
			// Draw icons for lives & continues
			if (!(u8[A3 + 0x05] > 0x00 && Renderer.hasCustomSprite(stringformat("dataSel_lifeContinue_slot%d", u8[A3 + 0x05]))) && !ecf_slot)
			{
				A1 = A2 + characters * 32
				D0 = VDPHelper.getDirectVRAMWriteCode(D7.u16)
				D1 = 2
				D2 = 4
				fn001506()
			}
			
			// Draw lives & continues numbers
			if (!saveGameSlotUsed)
			{
				A1 = 0x00db08
				D0 = VDPHelper.getDirectVRAMWriteCode(D7.u16 + 6)
				D1 = 1
				D2 = 4
				fn001506()
			}
			else
			{
				// Render lives digits
				D0.u8 = u8[A3 + 0x3e]	// Get lives data from save file
				fn00ca14()

				D0 = VDPHelper.getDirectVRAMWriteCode(D7.u16 + 6)
				D1 = 1
				D2 = 1
				fn001506()

				// Render continues digits
				D0.u8 = u8[A3 + 0x3f]	// Get continues data from save file
				fn00ca14()

				D0 = VDPHelper.getDirectVRAMWriteCode(D7.u16 + 0x306)
				D1 = 1
				D2 = 1
				fn001506()
			}

			D7.u16 += 0x1a
			A0 += 10
			A3 += 0x4a
		}
	}
	else
		base.fn00c97a()
}

//# address-hook(0x00d42c) end(0x00d69a)
function void fn00d42c()
{
	if (!lsds.nodetail)
	{
		base.fn00d42c()
		return
	}
	
	objA0.position.y.u16 = (oldposy != 0) ? oldposy : objA0.position.y.u16
	
	base.fn00d42c()
	
	oldposy = objA0.position.y.u16
	objA0.position.y.u16 += 0x10
}

