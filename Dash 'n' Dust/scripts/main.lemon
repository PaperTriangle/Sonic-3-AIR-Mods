global u8 dd.hyper_dash
global bool dd.newgraphic
global bool dd.dropdash_dust
global bool dd.underwater_dust
global bool dd.splash_object
global bool dd.dropdash_animation
global bool dd.no_air_dust
global bool dd.super_screenclear
global bool dd.camera_delay
global bool dd.dropdash_sound
global bool dd.super_release_sound
global bool dd.dropdash_retry
global bool dd.dropdash_used
global u8 dd.waterplus_palette

define u8 global.xtrachar = u8[0xffffe654]

//-----------------------------//
// Hyper Dash Dropdash Charge! //
//-----------------------------//

function void SonicPressedJumpInMidAir()
{
	if (!dd.hyper_dash || !super.active)
	{
		base.SonicPressedJumpInMidAir()
		return
	}
	
	// Remove control lock
	char.flags &= ~char.flag.CONTROL_LOCK
	char.double_jump_state = 1	// Always set this flag; needed for Drop Dash

	if ((super.active && Game.getSetting(SETTING_SUPER_SONIC_ABILITY) != 1) || (super.active & 0x80))
	{
		bool isHyperSonic = (super.active & 0x80)			// Hyper Sonic active
		bool performHyperDash = isHyperSonic
		u8 input = control.player1.state & CONTROL_DPAD		// Only directions

		if (Game.getSetting(SETTING_SUPER_SONIC_ABILITY) == 2)
		{
			performHyperDash = (super.active)				// This allows Super Sonic to use the dash as well
		}

		if (performHyperDash && Game.getSetting(SETTING_HYPER_DASH_CONTROLS) == 1)
		{
			// Hyper Dash requires also pressing D-pad in any direction
			//  -> To allow for Drop Dashing without activating the Hyper Dash before
			performHyperDash = (input != 0)
		}

		if (performHyperDash)
		{
			if (isHyperSonic)	// Super Sonic's dash does not cause a screen flash
			{
				Character.ClearEnemiesOnScreen()
			}

			camera.locktime.player1 = 0x2000
			ClearPositionBackup()

			char.double_jump_state = 1
		#if STANDALONE
			if (!isHyperSonic)
				u8[0xffffcbc0 + 0x20] = 1
			else
		#endif
				u8[0xffffcd7c + 0x20] = 1

			playSound(SFX_SPINDASH_RELEASE)

			if (input != 0 && input < 0x0b)		// Not left and right at the same time
			{
				// Perform Hyper Dash
				A1 = 0x011afa + input * 4
				char.velocity.x = s16[A1]
				char.velocity.y = s16[A1+2]
			}
			else
			{
				char.velocity.x = (char.flags & char.flag.FACING_LEFT) ? -0x800 : 0x800
				char.velocity.y = 0
			}

			if (!isHyperSonic)
			{
				// Reduce dash speed for Super Sonic
				char.velocity.x = (char.velocity.x > 0) ? (char.velocity.x - 0x200) : (char.velocity.x < 0) ? (char.velocity.x + 0x200) : 0
				char.velocity.y = (char.velocity.y > 0) ? (char.velocity.y - 0x200) : (char.velocity.y < 0) ? (char.velocity.y + 0x200) : 0
			}
		
			if (Game.getSetting(SETTING_DROPDASH) && (isHyperSonic || dd.hyper_dash == 2))
			{
				sonic.dropdash_counter = DROPDASH_FULLCHARGE
				char.state = char.state.SONIC_DROPDASH
				
				Audio.playAudio("hyper_dropdash_charge" , AudioContext.CONTEXT_SOUND)
			}
			
			char.groundspeed = char.velocity.x
		}
		else
		{
			char.double_jump_state = 1
		}
		return
	}
	
	base.SonicPressedJumpInMidAir()
}

//---------------------------------------//
// Remove Spindash Dust while in the air //
//---------------------------------------//

//# translated(0x011bde) end(0x011cf0)
//# translated(0x011d16) end(0x011da4)
//# translated(0x0151fc) end(0x01530c)
//# translated(0x015332) end(0x0153c0)
function bool Character.UpdateSpindash()
{

	if dd.no_air_dust && (char.spindash > 0)
		u8[A6 + 0x20] = (char.flags & char.flag.IN_AIR) ? 0x00 : 0x02
	
	return base.Character.UpdateSpindash()
}

//# address-hook(0x01164e) end(0x0116dc)
//# address-hook(0x014e78) end(0x014f06)
//# address-hook(0x017680) end(0x01770e)
function void Character.UpdateControlInAir()
{
	if dd.no_air_dust == 2 && (char.spindash > 0) && (char.flags & char.flag.IN_AIR)
	{
		char.hitbox_extends.x = char.hitbox.x.ROLLING
		char.hitbox_extends.y = char.hitbox.y.ROLLING
		char.state = char.state.ROLLING
		char.flags |= char.flag.ROLLING
		char.spindash = 0
		
		u32 baseAddress
		s8 dy = 5
		if (char.character != CHARACTER_TAILS)
		{
			baseAddress = (super.active) ? 0x011d04 : 0x011cf2
		}
		else
		{
			baseAddress = (super.active.tails) ? 0x015320 : 0x01530e
			dy = 1
		}

		D0 = u16(char.spindash_charge >> 8) * 2
		char.groundspeed = s16[baseAddress + D0]
		char.position.y.u16 += (global.inv_gravity) ? -dy : dy
		
		if (char.flags & char.flag.FACING_LEFT)
			char.groundspeed = -char.groundspeed

		u8[A6 + 0x20] = 0
		
	}

	base.Character.UpdateControlInAir()
}

//# address-hook(0x018c20) end(0x018c82)
function void fn018c20()
{
	if dd.no_air_dust && (u8[A2 + 0x2a] & char.flag.IN_AIR)
	{
		objA0.state = 0
	}
	base.fn018c20()
}

//-------------------------//
// Custom Sprite Rendering //
//-------------------------//

function bool Standalone.onWriteToSpriteTable(s16 px, s16 py, u16 renderQueue)
{
	u8 gameMode = global.game_mode & 0x7f
	
	// Water Splash
	bool prioFlag = (objA0.sprite_attributes & sprite_attribute.PRIORITY) != 0
	if (objA0.update_address == 0x251208)
	{
		u64 key
		
		if Mods.isModActive("Water+") || (dd.waterplus_palette > 0)
		{
			if (objA0.animation.sprite == 0)
				return true
			
			if (objA0.animation.sprite == 1 && !objA0.flags2e)
			{
				if (s16[0xffff0000 + objA0.dustcloud.character_address + 0x1a] >= 0x2ae || s16[0xffff0000 + objA0.dustcloud.character_address + 0x1a] < -0x600)
					objA0.flags2e = true
				else objA0.flags2e = false
			}
			
			key = stringformat((dd.waterplus_palette > 0) ? "custom_waterplus_splash1_%d" : "waterplus_splash1_%d", (objA0.animation.sprite / 2))
			if (objA0.flags2e == 1) && Mods.isModActive("Water+")
				key = stringformat((dd.waterplus_palette > 0) ? "custom_waterplus_splash2_%d" : "waterplus_splash2_%d", (objA0.animation.sprite / 2))
		}
		else
			key = stringformat("water_splash_%d", objA0.animation.sprite)
		
		u8 alpha = 0xff
		u8 atex = 0x00
		
		if (Mods.isModActive("No Transparency"))
			System.setGlobalVariableValueByName("renderTransparentPlz", true)
		
		Mods.isModActive("Moar Transparency")		
			if (System.getGlobalVariableValueByName("mt.watersurface"))
				alpha = 192
				
		if (dd.waterplus_palette > 0)
			atex = 0xa0 + dd.waterplus_palette * 0x10
		
		if (Renderer.hasCustomSprite(key))
			Renderer.drawSprite(key, px, py + 2, atex, (prioFlag ? SPRITE_FLAG_PRIO : 0), renderQueue - 0x80, 0, alpha)
			
		if (Mods.isModActive("No Transparency"))
			System.setGlobalVariableValueByName("renderTransparentPlz", false)

		return true
	}
	
	// Spindash Dust
	if ((dd.newgraphic || dd.underwater_dust) && (gameMode == 0x0c || gameMode == 0x08) && ((objA0.update_address == 0x018b3e && objA0.state == 0x02) || (objA0.update_address == 0x064c24)))
	{
		u8 renderFlags = (objA0.render_flags & (SPRITE_FLAG_FLIP_X | SPRITE_FLAG_FLIP_Y)) | ((objA0.sprite_attributes & sprite_attribute.PRIORITY) != 0 ? SPRITE_FLAG_PRIO : 0)
		Renderer.drawCustomSprite(stringformat(dd.newgraphic ? "spindash_dust_new_%d" : "spindash_dust_%d", objA0.animation.sprite - 10), px, py, 0x00, renderFlags, renderQueue)
		return true
	}
	
	// Skidding Dust
	if (dd.underwater_dust && (gameMode == 0x0c || gameMode == 0x08) && (objA0.update_address == 0x018b3e && objA0.state == 0x03 && objA0.animation.sprite > 0))
	{
		u8 renderFlags = ((objA0.sprite_attributes & sprite_attribute.PRIORITY) != 0 ? SPRITE_FLAG_PRIO : 0)
		Renderer.drawCustomSprite(stringformat("skid_dust_%d", objA0.animation.sprite - 17), px, py, 0x00, renderFlags, renderQueue)
		return true
	}
	
	// Dropdash Dust
	if (objA0.update_address == 0x251200)
	{
		u8 renderFlags = (objA0.render_flags & (SPRITE_FLAG_FLIP_X | SPRITE_FLAG_FLIP_Y)) | ((objA0.sprite_attributes & sprite_attribute.PRIORITY) != 0 ? SPRITE_FLAG_PRIO : 0)
		Renderer.drawCustomSprite(stringformat(dd.newgraphic ? "dropdash_dust_new_%d" : "dropdash_dust_%d", objA0.animation.sprite), px, py, 0x00, renderFlags, renderQueue)
		return true
	}
	
	return base.Standalone.onWriteToSpriteTable(px, py, renderQueue)
}

//---------------------//
// Dropdash Animation! //
//---------------------//

function u64 Standalone.getModdedAnimationSpriteKey(u8 character, u16 animationSpriteEx)
{

#if EXTRA_CHARACTER_FRAMEWORK_ACTIVE
	if getECFCharBufferName(A0)
		return base.Standalone.getModdedAnimationSpriteKey(character, animationSpriteEx)
#endif

	if (dd.dropdash_animation && char.state == char.state.SONIC_DROPDASH && character == CHARACTER_SONIC)
	{
		if (dd.dropdash_animation == 2)
			return stringformat("origins_dropdash_%d", level.framecounter & 0x0f)
		else
			return stringformat(super.active ? "super_sonic3_dropdash_%d" : "sonic3_dropdash_%d", (level.framecounter >> 1) & 7)
	}
	else
		return base.Standalone.getModdedAnimationSpriteKey(character, animationSpriteEx)
}

//---------------------//
// New Drop Dash Dust! //
//---------------------//

// The Object's update_address
//# address-hook(0x251200)
function void DD.Dust.Update()
{
	if (objA0.animation.timer > 0)
		objA0.animation.timer--
	
	if objA0.animation.timer == 0
	{
		objA0.animation.sprite++
		objA0.animation.timer = 1 + (objA0.animation.sprite) / 4
	}

	if (objA0.animation.sprite < 16)
		DrawObject()
	else
		UnloadObject()
	
	if !(objA0.render_flags & render_flag.VISIBLE)
		UnloadObject()
}

// Spawn Object
function void DD.SpawnDust()
{
	if (allocDynamicObjectStd())
	{
		objA1.update_address = 0x251200
		objA1.render_flags = objA0.render_flags
		objA1.sprite_attributes = objA0.sprite_attributes

		objA1.box_size.x = 0x20
		objA1.box_size.y = 0x20

		objA1.position.x.u16 = objA0.position.x.u16
		objA1.position.y.u16 = objA0.position.y.u16

		objA1.animation.sprite = 0
		objA1.animation.timer = 2
	}
}

#if STANDALONE
function void releaseDropDash()
{
	// Release drop dash!

	// Show dust cloud
	if (dd.dropdash_dust)
		DD.SpawnDust()
	else if (char.drown_countdown >= 12 && abs(s8(char.rotation)) < 0x1c)
	{
		u8[A6 + 0x20] = 0x02
		u16[A6 + 0x10] = char.position.x.u16
		u16[A6 + 0x14] = char.position.y.u16
		u8[A6 + 0x23] = 0x01
		u8[A6 + 0x2a] = char.flags & char.flag.FACING_LEFT
	}

	s16 dy = s8(14 - char.hitbox_extends.y)
	char.hitbox_extends.x = char.hitbox.x.ROLLING
	char.hitbox_extends.y = char.hitbox.y.ROLLING
	char.position.y.u16 += global.inv_gravity ? dy : -dy

	char.state = char.state.ROLLING
	char.flags |= char.flag.ROLLING
	char.spindash = 0

	sonic.dropdash_counter = 0
	if (control.player1.state & CONTROL_LEFT)
	{
		char.flags |= char.flag.FACING_LEFT
	}
	else if (control.player1.state & CONTROL_RIGHT)
	{
		char.flags &= ~char.flag.FACING_LEFT
	}

	// Camera delay
	if (A0 == 0xffffb000)
	{
		ClearPositionBackup()
		camera.locktime.player1 = max(camera.locktime.player1, dd.camera_delay ? 0x1400 : 0x0c00)
	}
	else
	{
		camera.locktime.player2 = max(camera.locktime.player2, dd.camera_delay ? 0x1400 : 0x0c00)
	}

	s16 baseSpeed = super.active ? 0x0c00 : 0x0800
	s16 maxSpeed  = super.active ? 0x0d00 : 0x0c00
	if ((char.flags & char.flag.FACING_LEFT) == 0)
	{
		if (char.velocity.x > 0)
		{
			char.groundspeed = min(baseSpeed + (char.groundspeed >> 2), maxSpeed)
		}
		else if (char.rotation != 0)
		{
			char.groundspeed = baseSpeed + (char.groundspeed >> 1)
		}
		else
		{
			char.groundspeed = baseSpeed
		}
	}
	else
	{
		baseSpeed = -baseSpeed
		if (char.velocity.x < 0)
		{
			char.groundspeed = max(baseSpeed + (char.groundspeed >> 2), -maxSpeed)
		}
		else if (char.rotation != 0)
		{
			char.groundspeed = baseSpeed + (char.groundspeed >> 1)
		}
		else
		{
			char.groundspeed = baseSpeed
		}
	}

	if (super.active)
	{
		// Using upper byte to signal the difference between Hyper Knuckles hitting the wall and Super/Hyper Sonic's drop dash
		camera.hyper_knux_shake = 0x0114

		if (dd.super_screenclear)
			Character.ClearEnemiesOnScreen()
			
		if (dd.super_release_sound)
			Audio.playAudio(dd.dropdash_sound ? "mania_super_dropdash_release" : "peelout_release", AudioContext.CONTEXT_SOUND)
		else
		{
			playSound(0x49)
			Audio.playAudio("dropdash_release", AudioContext.CONTEXT_SOUND)
		}
	}
	else
		Audio.playAudio("dropdash_release", AudioContext.CONTEXT_SOUND)

#if STANDALONE
	if (super.active)
		Input.setControllerRumbleByAddress(A0, 0.5f, 1.0f, 200)
	else
		Input.setControllerRumbleByAddress(A0, 0.0f, 1.0f, 150)
#endif
}
#endif

//------------------------//
// Mania Drop Dash Sounds //
//------------------------//

function void Audio.playAudio(u64 audioKey, u8 contextId)
{
	if dd.dropdash_sound && (audioKey == "dropdash_charge" || audioKey == "dropdash_release" || audioKey == "hyper_dropdash_charge")
	{
		audioKey = stringformat("mania_%s", audioKey)
	}

	base.Audio.playAudio(audioKey, contextId)
}

//-------------------//
// Drop Dash Disable //
//-------------------//

function void Character.updateJumpMoves()
{
#if EXTRA_CHARACTER_FRAMEWORK_ACTIVE
	if getECFCharBufferName(A0)
		base.Character.updateJumpMoves()
#endif

	if (!dd.dropdash_retry && char.character == CHARACTER_SONIC && global.xtrachar == 0)
	{
		if (char.double_jump_state == 0)
			dd.dropdash_used = 0

		if (dd.dropdash_used)
			return

		u8 dropdashState = char.state

		base.Character.updateJumpMoves()
		
		if (dropdashState == char.state.SONIC_DROPDASH && char.state != char.state.SONIC_DROPDASH)
			dd.dropdash_used = 1
	}
	else
		base.Character.updateJumpMoves()
		
}

//------------------//
// Underwater dust! //
//------------------//

// If drowning, make the rendering code think you are fine.
//# address-hook(0x018baa) end(0x018bba)
function void fn018baa()
{
	if (!dd.underwater_dust)
	{
		base.fn018baa()
		return
	}
	
	u8 drown_countdown_backup = u8[0xffff0000 + objA0.dustcloud.character_address + 0x2c]
	
	if (u8[0xffff0000 + objA0.dustcloud.character_address + 0x2c] < 12)
		u8[0xffff0000 + objA0.dustcloud.character_address + 0x2c] = 0xff
		
	base.fn018baa()
	
	u8[0xffff0000 + objA0.dustcloud.character_address + 0x2c] = drown_countdown_backup
}

// Prevent updating dust graphic if drown counter is not in use.
//# address-hook(0x018d6a) end(0x018d6a)
function void fn018d6a()
{
	if (!dd.underwater_dust)
	{
		base.fn018d6a()
		return
	}
	
	if u8[0xffff0000 + objA0.dustcloud.character_address + 0x2c] != 0xff
	{
		D6 = 0x18a604
		fn018d70()
	}
}

//# address-hook(0x016890) end(0x016c78)
//# translated(0x016f6c) end(0x016fa6)
function void UpdateKnucklesGlideCollision()
{
	if (!dd.underwater_dust)
	{
		base.UpdateKnucklesGlideCollision()
		return
	}
	
	u8 drown_countdown_backup = char.drown_countdown
	
	if (char.drown_countdown < 12)
		char.drown_countdown = 0xff
		
	base.UpdateKnucklesGlideCollision()
	
	char.drown_countdown = drown_countdown_backup
}

//# address-hook(0x0113f6) end(0x011480)
//# address-hook(0x014c20) end(0x014caa)
//# address-hook(0x017428) end(0x0174b2)
function void PressedLeftWhileUprightOnGround()
{
	if (!dd.underwater_dust)
	{
		base.PressedLeftWhileUprightOnGround()
		return
	}
	
	u8 drown_countdown_backup = char.drown_countdown
	
	if (char.drown_countdown < 12)
		char.drown_countdown = 0xff
		
	base.PressedLeftWhileUprightOnGround()
	
	char.drown_countdown = drown_countdown_backup
}

//# address-hook(0x011482) end(0x011506)
//# address-hook(0x014cac) end(0x014d30)
//# address-hook(0x0174b4) end(0x017538)
function void PressedRightWhileUprightOnGround()
{
	if (!dd.underwater_dust)
	{
		base.PressedRightWhileUprightOnGround()
		return
	}
	
	u8 drown_countdown_backup = char.drown_countdown
	
	if (char.drown_countdown < 12)
		char.drown_countdown = 0xff
		
	base.PressedRightWhileUprightOnGround()
	
	char.drown_countdown = drown_countdown_backup
}

//# address-hook(0x018c84) end(0x018c92)
//# translated(0x018caa) end(0x018cb0)
function void fn018c84()
{
	if (!dd.underwater_dust)
	{
		base.fn018c84()
		return
	}
	
	if (objA0.flags2a & 0x40)
	{
		objA0.state = 0
		return
	}

	fn018c94()
}

//# address-hook(0x018cb6) end(0x018d68)
function void fn018cb6()
{
	if (!dd.underwater_dust)
	{
		base.fn018cb6()
		return
	}
	
	A2 = 0xffff0000 + objA0.dustcloud.character_address
	D1 = 0x10
	if (u8[A2 + 0x20] != char.state.BRAKING)
	{
		bool b = true
		if (u8[A2 + 0x38] == CHARACTER_KNUCKLES)
		{
			D1 = 0x06
			b = (u8[A2 + 0x2f] != 3)
		}

		if (b)
		{
			objA0.base_state = 0x02
			u8[A0 + 0x36] = 0
			return
		}
	}

	--u8[A0 + 0x36]
	if (s8[A0 + 0x36] < 0)
	{
		u8[A0 + 0x36] = 3
		
		if (allocDynamicObjectStd())
		{
			// Spawn skidding dust
			objA1.update_address = objA0.update_address
			objA1.position.x.u16 = u16[A2 + 0x10]
			objA1.position.y.u16 = u16[A2 + 0x14]
			if (objA0.flags38 != 0)
			{
				D1.u16 -= 4
			}
			if (global.inv_gravity)
				D1.s16 = -D1.s16

			objA1.position.y.u16 += D1.u16
			objA1.render_flags = objA0.render_flags
			u8[A1 + 0x05] += 2
			objA1.box_size.x = 4
			objA1.sprite_priority = 0x80
			objA1.sprite_attributes = (objA0.sprite_attributes & ~sprite_attribute.PRIORITY) | (u16[A2 + 0x0a] & sprite_attribute.PRIORITY)
			objA1.mapping_offset = objA0.mapping_offset
			u8[A1 + 0x20] = 3
			u8[A1 + 0x2a] = 0
			objA1.dustcloud.character_address = objA0.dustcloud.character_address
		}
	}


	fn018d6a()
}

//---------------------//
// Custom Water Object //
//---------------------//

//# address-hook(0x018bc8) end(0x018be8)
function void fn018bc8()
{
	if (!dd.splash_object)
	{
		base.fn018bc8()
		return
	}
	
	if (allocDynamicObjectStd())
	{
		objA1.update_address = 0x251208
		objA1.render_flags = objA0.render_flags
		objA1.sprite_attributes = objA0.sprite_attributes

		objA1.box_size.x = 0x20
		objA1.box_size.y = 0x20

		objA1.position.x.u16 = u16[0xffff0000 + objA0.dustcloud.character_address + 0x10]
		objA1.position.y.u16 = u16[0xffff0000 + objA0.dustcloud.character_address + 0x14]
		
		objA1.animation.timer = 5
		
		objA1.dustcloud.character_address = objA0.dustcloud.character_address
		
		objA1.flags2e = false
	}
	
	objA0.state = 0
}

//# address-hook(0x251208)
function void DND.splashUpdate()
{
	objA0.position.y.u16 = water.height.current
	
	// 8 by 4
	objA0.animation.timer--
	
	if objA0.animation.timer == 0
	{
		objA0.animation.sprite++
		objA0.animation.timer = 4
	}
	
	if objA0.animation.sprite < 9
		DrawObject()
	else
		UnloadObject()
}

// HCZ1 Boss Splashes
//# address-hook(0x06a4f4) end(0x06a502)
function void fn06a4f4()
{
	if (!dd.splash_object)
	{
		base.fn06a4f4()
		return
	}
	
	if (allocDynamicObjectStd())
	{
		objA1.update_address = 0x251208
		objA1.render_flags = objA0.render_flags
		objA1.sprite_attributes = objA0.sprite_attributes

		objA1.box_size.x = 0x20
		objA1.box_size.y = 0x20

		objA1.position.x.u16 = objA0.position.x.u16
		objA1.position.y.u16 = objA0.position.y.u16
		
		objA1.animation.timer = 5
		
		objA1.flags2e = true
	}
	
	objA0.countdown_callback = 0x08522c
}

// Water Plus Bonus Compat!

constant array<u16> SPLASH_PALETTES = {0xeee, 0xecc, 0xee2, 0xea4, 0xe64, 0xeee, 0xecc, 0xee2, 0xec4, 0xea4, 0xeee, 0xecc, 0xec0, 0xea0, 0xc80, 0xeee, 0xecc, 0xc60, 0xc22, 0xa20, 0xeee, 0xecc, 0xc80, 0xa20, 0x620, 0xeee, 0xecc, 0xea0, 0xe64, 0xe42, 0xeee, 0xecc, 0xec0, 0xe60, 0xc22}

function void DND.LoadWaterPlusPalette(bool afterTitle)
{
	u16 offset = 3 * 0x40 + dd.waterplus_palette * 0x20
	
	u32 TargetAD = (afterTitle ? 0x802002 : 0x802182) + offset
	u32 TargetUAD = (afterTitle ? 0x802002 : 0x802482) + offset
	
	u8 palOffset = 0x1e
	
	if (global.zone_act == 0x0000)
		palOffset = 0x0
	else if (global.zone_act == 0x0001)
		palOffset = 0x05
	else if (global.zone == 0x01)
		palOffset = 0x0a
	else if (global.zone_act == 0x0301)
		palOffset = 0x0f
	else if (global.zone_act == 0x0501)
		palOffset = 0x14
	else if (global.zone_act == 0x0601)
		palOffset = 0x19

	u16[TargetAD + 2*0x0a] = SPLASH_PALETTES[palOffset]
	u16[TargetAD + 2*0x0b] = SPLASH_PALETTES[palOffset+1]
	u16[TargetAD + 2*0x0c] = SPLASH_PALETTES[palOffset+2]
	u16[TargetAD + 2*0x0d] = SPLASH_PALETTES[palOffset+3]
	u16[TargetAD + 2*0x0e] = SPLASH_PALETTES[palOffset+4]
	
	u16[TargetUAD + 2*0x0a] = SPLASH_PALETTES[palOffset]
	u16[TargetUAD + 2*0x0b] = SPLASH_PALETTES[palOffset+1]
	u16[TargetUAD + 2*0x0c] = SPLASH_PALETTES[palOffset+2]
	u16[TargetUAD + 2*0x0d] = SPLASH_PALETTES[palOffset+3]
	u16[TargetUAD + 2*0x0e] = SPLASH_PALETTES[palOffset+4]
}

// Load Custom Palettes
//# address-hook(0x02d856) end(0x02d8dc)
function void TitleCard.Show()
{
	base.TitleCard.Show()
	
	if (dd.waterplus_palette > 0)
	{
		if (objA0.countdown_value == 0)
			DND.LoadWaterPlusPalette(true)
		else
			DND.LoadWaterPlusPalette(false)
	}
}

// AIZ1 Transition
//# address-hook(0x0500d6) end(0x0500d6)
function void fn0500d6()
{
	base.fn0500d6()
	
	if (dd.waterplus_palette > 0)
		DND.LoadWaterPlusPalette(true)
}