// Fix CNZ Cylinder Rolling
//# address-hook(0x0338c4) end(0x033abe)
function void fn0338c4()
{
	u8 bit = (1 << D6.u8)

	if (u8[A1 + 0x2a] & char.flag.ROLLING) && ((objA0.flags2a & bit) != 0) && (u8[A2 + 0x01] == 0) && (debug_mode.state == 0 && abs(objA1.groundspeed) >= 0x300) && !(u8[A1 + 0x2a] & char.flag.IN_AIR)
	{
		u8[A1 + 0x2a] &= ~char.flag.ROLLING
		objA1.hitbox_extends.x = char.hitbox.x.UPRIGHT
		objA1.hitbox_extends.y = char.hitbox.y.UPRIGHT
		objA1.state.both = char.state.RUNNING2
	}
	
	base.fn0338c4()
}

// AIZ Hollow Tree Running
function void fn01f7ce()
{
#if STANDALONE
	if (debug_mode.state)
		return
#endif

	u8 bit = (1 << D6.u8)

	base.fn01f7ce()

	if ((objA0.flags2a & bit) != 0)
	{
		objA1.flags2a &= ~(char.flag.ROLLING | char.flag.FACING_LEFT)
	}
}

// Running in FBZ static cylinder.
//# address-hook(0x03a314) end(0x03a466)
function void fn03a314()
{
	base.fn03a314()
	objA1.flags2a &= ~char.flag.ROLLING
}

// ICZ Ice platform collision fix... Didn't have anywhere else to put this...
//# address-hook(0x089f38) end(0x089f64)
function void fn089f38()
{
	D0 = objA0.base_state
	D1.u16 = u16[0x089f6a + D0.u16]
	u16 backupPosition = objA0.position.x.u16

	// Targets:
	//  - 0x089f7e	-> D0.u16 = 0x00
	//  - 0x089fb6	-> D0.u16 = 0x02
	//  - 0x089fd6	-> D0.u16 = 0x04
	//  - 0x089ff2	-> D0.u16 = 0x08
	//  - 0x08a036	-> D0.u16 = 0x0a
	//  - 0x08a11c	-> D0.u16 = 0x0c
	//  - 0x08a176	-> D0.u16 = 0x0e
	//  - 0x08a178	-> D0.u16 = 0x10
	//  - 0x08a192	-> D0.u16 = 0x12
	//  - 0x08a1ae	-> D0.u16 = 0x14
	call 0x089f6a + D1.u16

	D1 = 0x2b
	D2 = 0x11
	D3 = 0x14
	D4.u16 = backupPosition
	if ((objA0.flags2a & 0x80) == 0)
	{
		fn01dc56()
		fn08a3c4()
	}

	DrawOrUnloadObject()
}

// DEZ Wind Tunnle
//# address-hook(0x04964a) end(0x049764)
function void fn04964a()
{
	u16 dx = objA1.position.x.u16 - objA0.position.x.u16
	u16 dy = objA1.position.y.u16 - objA0.position.y.u16 + 0x0140
	if (u8[A2] == 0)
	{
		if (dx < 0x0500 && dy < 0x0280 && debug_mode.state == 0)
		{
			objA1.state = char.state.RUNNING
			u8[A1 + 0x27] = 0x01
			objA1.flags2a &= ~char.flag.CONTROL_LOCK
			objA1.flags2a |= char.flag.IN_AIR
			u8[A1 + 0x2e] = control_flag.DISABLE_UPDATE
			u8[A1 + 0x30] = 0xff		// "char.rotation.x.count"
			u8[A1 + 0x31] = 0x04		// "char.rotation.x.speed"

			u8[A1 + 0x40] = 0
			u8[A2] = 1
		}
	}
	else
	{
		if (dx < 0x0500 && debug_mode.state == 0)
		{
			objA1.velocity.x += 0x38
			D6.u16 = 0x0600
			D5.u16 = 0x18
			D0.u16 = objA1.velocity.y

			if (D4 & 0x0100)		// CONTROL_UP held
			{
				D0.u16 -= D5.u16
				D1.s16 = -D6.s16
				if (D0.s16 <= D1.s16)
				{
					D0.u16 += D5.u16
					if (D0.s16 > D1.s16)
					{
						D0.u16 = D1.u16
					}
				}
			}

			if (D4 & 0x0200)		// CONTROL_DOWN held
			{
				D0.u16 += D5.u16
				if (D0.s16 >= D6.s16)
				{
					D0.u16 -= D5.u16
					if (D0.s16 < D6.s16)
					{
						D0.u16 = D6.u16
					}
				}
			}

			objA1.velocity.y = D0.u16
			D0.u16 = objA1.velocity.y
			D1.s16 = D0.s16 >> 5
			if (D1.u16 != 0)
			{
				if (D1.s16 >= 0)
				{
					D0.u16 -= D1.u16
					if (D0.s16 < 0)
						D0.u16 = 0
					objA1.velocity.y = D0.u16
				}
				else
				{
					D0.u16 -= D1.u16
					if (D0.s16 > 0)
						D0.u16 = 0
					objA1.velocity.y = D0.u16
				}
			}

			u8 anim = u8[A1 + 0x27]

			pushAll()
			A0 = A1
			UpdateMovementStraightSimple()
			Character.UpdateRotationInAir()
			Character.CheckCollision()
			popAll()

			if !(objA1.flags2a & char.flag.IN_AIR)
			{
				
				u8[A1 + 0x27] = anim
				objA1.flags2a &= ~char.flag.CONTROL_LOCK
				objA1.flags2a |= char.flag.IN_AIR
				u8[A1 + 0x2e] = control_flag.DISABLE_UPDATE
				u8[A1 + 0x30] = 0xff		// "char.rotation.x.count"
				u8[A1 + 0x31] = 0x04		// "char.rotation.x.speed"

				u8[A1 + 0x40] = 0
				s16[A1 + 0x1c] = 0
				
				u8[A2] = 1
			}

			objA1.flags2a |= char.flag.IN_AIR
			if ((level.framecounter.low & 0x0f) == 0)
			{
				playSound(0xd4)
			}
		}
		else
		{
			u8[A1 + 0x2e] = 0
			u8[A2] = 0
		}
	}
}

//# address-hook(0x0497c2) end(0x0497fe)
function void fn0497c2()
{
	if global.zone_act != 0xb00 || !((camera.position.x.u16 >= 0x2480 && camera.position.x.u16 <= 0x2880) && (camera.position.y.u16 >= 0x0680 && camera.position.y.u16 <= 0x0a80))
	{
		base.fn0497c2()
		return
	}
	
	u8 anim1 = u8[char.ADDRESS_P1 + 0x27]
	u8 anim2 = u8[char.ADDRESS_P2 + 0x27]
	
	base.fn0497c2()
	
	u32 backupA1 = A1
	A1 = char.ADDRESS_P1
	
	if !(objA1.flags2a & char.flag.IN_AIR)
	{
		
		u8[A1 + 0x27] = anim1
		objA1.flags2a &= ~char.flag.CONTROL_LOCK
		objA1.flags2a |= char.flag.IN_AIR
		u8[A1 + 0x2e] = control_flag.DISABLE_UPDATE
		u8[A1 + 0x30] = 0xff		// "char.rotation.x.count"
		u8[A1 + 0x31] = 0x04		// "char.rotation.x.speed"

		u8[A1 + 0x40] = 0
		s16[A1 + 0x1c] = 0
	}
	
	A1 = char.ADDRESS_P2
	
	if !(objA1.flags2a & char.flag.IN_AIR)
	{
		
		u8[A1 + 0x27] = anim2
		objA1.flags2a &= ~char.flag.CONTROL_LOCK
		objA1.flags2a |= char.flag.IN_AIR
		u8[A1 + 0x2e] = control_flag.DISABLE_UPDATE
		u8[A1 + 0x30] = 0xff		// "char.rotation.x.count"
		u8[A1 + 0x31] = 0x04		// "char.rotation.x.speed"

		u8[A1 + 0x40] = 0
		s16[A1 + 0x1c] = 0
	}
	
	A1 = backupA1
}

