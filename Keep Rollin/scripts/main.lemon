global bool kr.deztube
global bool kr.vertical_roll
global bool kr.sticky_collision

define u32 char.ADDRESS_P1 = 0xffffb000
define u32 char.ADDRESS_P2 = 0xffffb04a

//--------
// Rolling
//--------

function void yieldExecution()
{
	if (global.zone_act == 0x0001)
		System.loadExternalRawData("AIZ2_Cliff_Collision", 0x020e9e)

	keepRollin(char.ADDRESS_P1)
	keepRollin(char.ADDRESS_P2)

	base.yieldExecution()
}

function void keepRollin(u32 AX)
{
	
	if ((global.game_mode & 0x7f) == 0x0c)
	{
		u32 backupA0 = A0
		A0 = AX
		
		if (char.state == char.state.ROLLING) && (char.look_up_down_timer > 0)
			char.look_up_down_timer--
		
		if (char.jumping > 0) || (!kr.vertical_roll && char.velocity.x == 0 && char.state == char.state.ROLLING)
			char.look_up_down_timer = 0
		else if (char.state == char.state.ROLLING) && !(char.flags & char.flag.IN_AIR)
		{
			// This logic here is to check for corkfloors in ICZ2
			// because they act fucking strange.

			bool icz2test = 0
			
			if kr.sticky_collision && (global.zone_act == 0x0501)
			{
				u32 AT = 0xffffb0de
				s8 count = 0x59
				while (count >= 0)
				{
					AT += 0x4a
					if (u32[AT] == 0x02a6d4)
					{
						icz2test = 1
					}
					--count
				}
			}
			
			char.look_up_down_timer = kr.sticky_collision ? (icz2test ? 0x0a : 0x02) : 0x08
		}
		
		if kr.sticky_collision && (char.jumping == 0) && (char.state == char.state.ROLLING) && (char.flags & char.flag.IN_AIR) && (char.look_up_down_timer > 0)
		{
			char.position.y.u16 += global.inv_gravity ? -4 : 4
			Character.CheckCollision()
			char.position.y.u16 -= global.inv_gravity ? -4 : 4
		}
			
		A0 = backupA0
	}
}

//# address-hook(0x012172) end(0x012178)
//# address-hook(0x01560c) end(0x01569a)
function void Character.LandingOnGround()
{
	if (char.state == char.state.ROLLING) && (char.look_up_down_timer > 0)
		Character.LandingOnGroundResetState()
	else
		base.Character.LandingOnGround()
}

//# address-hook(0x01217e) end(0x012230)
//# address-hook(0x015618)
//# address-hook(0x017b24) end(0x017bb4)
function void Character.LandingOnGroundNoSpindash()
{
	if (char.state == char.state.ROLLING) && (char.look_up_down_timer > 0)
		Character.LandingOnGroundResetState()
	else
		base.Character.LandingOnGroundNoSpindash()
}

// Keep rolling on LBZ Spring Launcher
//# address-hook(0x0261f2) end(0x026296)
function void fn0261f2()
{
	base.fn0261f2()

	if (objA1.state != char.state.ROLLING) && (u8[A1 + 0x39] > 0)
	{
		u8[A1 + 0x2a] |= char.flag.ROLLING
		objA1.hitbox_extends.x = char.hitbox.x.ROLLING
		objA1.hitbox_extends.y = char.hitbox.y.ROLLING
		objA1.state = char.state.ROLLING
		s8 dy = (u8[A1 + 0x38] == CHARACTER_TAILS) ? 1 : 5
		objA1.position.y.u16 += (global.inv_gravity) ? -dy : dy
	}
}

// Prevent camera issues in LBZ Booster Tubes

//# address-hook(0x029620) end(0x0296d2)
function void fn029620()
{
	if !kr.sticky_collision
	{
		base.fn029620()
		return
	}
	
	if (debug_mode.state != 0)
		return

	u16 dx = objA1.position.x.u16 - objA0.position.x.u16 + 0x10
	u16 dy = objA1.position.y.u16 - objA0.position.y.u16 + 0x18
	if (dx < 0x20 && dy < 0x28 && u8[A1 + 0x2e] == 0)
	{
		u8[A1 + 0x39] = 0
	}
	
	base.fn029620()
}

// Prevent Rolling in FBZ Vertical Cylinder
//# address-hook(0x03a0d6) end(0x03a21a)
function void fn03a0d6()
{
#if STANDALONE
	if (debug_mode.state)
		return
#endif

	u8 bit = (1 << D6.u8)

	if ((objA0.flags2a & bit) == 0)
	{
		D0.u16 = objA1.position.x.u16 - objA0.position.x.u16 + 0x80
		if (D0.u16 >= 0x0100)
			return

		D1.u16 = objA1.position.y.u16 - objA0.position.y.u16 + D4.u16
		if (D1.u16 >= D5.u16)
			return

		if (u8[A1 + 0x05] >= base_state.DIED || debug_mode.state != 0 || s8[A1 + 0x2e] < 0)
			return

		if (D0.u16 >= 0x20 && D0.u16 < 0xe0)
			return
	}

	base.fn03a0d6()

	objA1.flags2a |= char.flag.IN_AIR
}

// Fix for standing after rolling in FBZ Horizontal Cylinder
//# address-hook(0x039f7e) end(0x03a0ae)
function void fn039f7e()
{
#if STANDALONE
	if (debug_mode.state)
		return
#endif

	bool isInside = (objA0.flags2a >> D6.u8) & 1

	base.fn039f7e()

	if (isInside)
	{
		if ((u8[A1 + 0x2a] & char.flag.IN_AIR) == 0)
		{
			D0.u16 = objA1.position.x.u16 - objA0.position.x.u16 + D4.u16
			if (D0.u16 < D5.u16) && !((u8[A1 + 0x2a] & char.flag.ON_OBJECT) == 0)
			{
				if (objA1.state != char.state.ROLLING)
				{
					u8[A1 + 0x2d] = 0x80
					objA1.state.both = char.state.RUNNING2
				}
			}
		}
	}
}

// Prevent rolling when in corckscrew animations.
// Option for DEZ to prevent rolling in DEZ Tubes.

//# address-hook(0x01174a) end(0x0117d8)
//# address-hook(0x014f74) end(0x015000)
function void Character.CheckForStartRolling()
{
	if kr.deztube || global.zone != 0x0b
		if (char.animation.sprite >= 0x69 && char.animation.sprite <= 0x77) || (char.animation.sprite >= 0x49 && char.animation.sprite <= 0x54)
			return
	else if kr.deztube && global.zone == 0x0b
		if (char.animation.sprite >= 0x31 && char.animation.sprite <= 0x3c)
			return


	base.Character.CheckForStartRolling()
}

// Fix DEZ Tubes crashing with Debug.
//# address-hook(0x048f12) end(0x048f8e)
function void fn048f12()
{
#if STANDALONE
	if (debug_mode.state)
		return
#endif

	D0.u16 = objA1.position.x.u16 - objA0.position.x.u16 + D4.u16
	D1.u16 = objA1.position.y.u16 - objA0.position.y.u16 + objA0.value32
	if (D0.u16 < D5.u16 && D1.u16 < objA0.value32 * 2)
	{
		if (u8[A1 + 0x2a] & char.flag.ROLLING) && (u8[A1 + 0x05] < base_state.DIED && debug_mode.state == 0)
		{
			u8[A1 + 0x2a] &= ~char.flag.ROLLING
			objA1.animation.sprite = 0x31
		}
	}
	
	base.fn048f12()
}

