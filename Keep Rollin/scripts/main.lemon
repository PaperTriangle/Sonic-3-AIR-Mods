	}

	base.fn03260a()
}

// Fix for FBZ Cylinder

//# address-hook(0x03a314) end(0x03a466)
function void fn03a314()
{
	base.fn03a314()
	
	if (objA1.state == char.state.RUNNING)
	{
		if (A1 == 0xffffb000)
		{
			kr.backup_flags = 0
			kr.backup_flags2 = 0
			kr.wasRolling = 0
			kr.wasRolling2 = 0
		}
		else if (A1 == 0xffffb04a)
		{
			kr.backup_flags_p2 = 0
			kr.backup_flags2_p2 = 0
			kr.wasRolling_p2 = 0
			kr.wasRolling2_p2 = 0
		}
	}
}

//# address-hook(0x039f7e) end(0x03a0ae)
function void fn039f7e()
{
	base.fn039f7e()
	
	if (objA1.state == char.state.RUNNING)
	{
		objA1.flags2a &= ~char.flag.ROLLING
		objA1.state = char.state.RUNNING

		if (A1 == 0xffffb000)
		{
			kr.backup_flags = 0
			kr.backup_flags2 = 0
			kr.wasRolling = 0
			kr.wasRolling2 = 0
		}
		else if (A1 == 0xffffb04a)
		{

			kr.backup_flags_p2 = 0
			kr.backup_flags2_p2 = 0
			kr.wasRolling_p2 = 0
			kr.wasRolling2_p2 = 0
		}
	}
}

//# address-hook(0x03a0d6) end(0x03a21a)
function void fn03a0d6()
{

	D1.u16 = objA1.position.y.u16 - objA0.position.y.u16 + D4.u16
	if !(D1.u16 >= D5.u16) && ((u8[A1 + 0x2a] & char.flag.ON_OBJECT) != 0)
	{
			objA1.state = char.state.RUNNING
			objA1.flags2a &= ~char.flag.ROLLING
			
			if objA1.flags2a & char.flag.IN_AIR
			{
				objA1.flags2a &= ~char.flag.IN_AIR
			}
	}

	base.fn03a0d6()
}

