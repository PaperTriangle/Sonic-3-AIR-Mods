//----------
// Dragonfly
//----------

//# address-hook(0x08de26) end(0x08de34)
function void fn08de26()
{
	if (!bb.dragonfly)
	{
		base.fn08de26()
		return
	}
	
	// Targets:
	//  - 0x08de44	-> objA0.base_state = 0x00
	//  - 0x08de74	-> objA0.base_state = 0x02
	//  - 0x08de8a	-> objA0.base_state = 0x04
	//  - 0x08deb6	-> objA0.base_state = 0x06
	//  - 0x08def4	-> objA0.base_state = 0x08
	call tableLookupAddress(0x08de3a, objA0.base_state)

	BB.BreakDragonfly()
}

function void BB.BreakDragonfly()
{
	A1 = 0xffff0000 + u16[A0 + 0x46]
	if (u8[A1 + 0x2a] & 0x80)
	{
		if (objA0.subtype2c != 0x0c)
			BB.SpawnPart((System.rand() & 1) ? System.rand() % 0x100 + 0x200 : System.rand() % 0x100 * -1 - 0x200, System.rand() % 0x100 * -1 - 0x200, 0x06, (objA0.render_flags & render_flag.FLIP_Y) ? 1 : 0)
		else
			BB.SpawnPart((System.rand() & 1) ? System.rand() % 0x100 + 0x200 : System.rand() % 0x100 * -1 - 0x200, System.rand() % 0x100 * -1 - 0x200, 0x07, (objA0.render_flags & render_flag.FLIP_Y) ? 1 : 0)
		
		Object.TriggerUnloading()
	}
	else
	{
		AddAsDynamicObject()			
		DrawObject()
	}
}

//------------
// Monkey Dude
//------------

//# address-hook(0x0871da) end(0x087246)
function void fn0871da()
{
	if (!bb.monkeysmooth)
	{
		base.fn0871da()
		return
	}
	
	Object.AnimationProgressByLocalA1.DistinctTimer()

	bool goto087218 = false
	if (objA0.flags38 & 0x04)
	{
		if (objA0.animation.sprite != 2)
			return

		--objA0.value39
		if (objA0.value39 != 0)
		{
			objA0.position.y.u16 -= 1				// Divided by 8.
			return
		}
		goto087218 = true
	}

	if (objA0.animation.sprite == 0)
	{
		objA0.position.y.u16 += 1					// Divided by 8.
		--objA0.value39
		goto087218 = (objA0.value39 == 1)
	}

	if (goto087218)
	{
		objA0.base_state = 0x02
		objA0.value39 = objA0.subtype2c * 8			// I made it move 8 times less so it needs to be 8 times.
		objA0.flags38 ^= 0x04
		objA0.countdown_value = 0x3b
		u32[A0 + 0x30] = 0x0876b4
		objA0.animation.sprite = 0
		objA0.animation.frame = 0
		objA0.animation.timer = 0
	}

}

//# address-hook(0x087172) end(0x0871b8)
function void fn087172()
{
	base.fn087172()

	if (bb.monkeysmooth)
		objA0.value39 *= 8 			// I made it move 8 times less so it needs to be 8 times.

}

//------------
// Fire Breath
//------------

//# address-hook(0x068a46) end(0x068a68)
function void fn068a46()
{
	if (!bb.firebreath)
	{
		base.fn068a46()
		return
	}
	
	setupObjectAttributesFull(0x068ffe)
	boss.remaining_hits = 6
	level.boss_encounter = 1

	requestLoadingPatterns(0x5a)		// Boss sprites
	loadPaletteLine1(0x06917c)

#if STANDALONE
	// Move to the right, so that there is no dead corner where character is behind him
	objA0.position.x.u16 += getScreenExtend() 			// This was in the 3 A.I.R. code already but with an extra offset.
#endif
}

//# address-hook(0x068b92) end(0x068bb8)
function void fn068b92()
{
	if (!bb.firebreath)
	{
		base.fn068b92()
		return
	}
	
	objA0.base_state = 0x0e
	objA0.value39 = 0x04
	objA0.countdown_callback = 0x068bdc
	objA0.flags38 ^= 0x08		// Flip horizontal movement direction
	
	// Adjust he velocity to ensure the boss moves consistently across the stage, keeping the same pace as the original fight.
	objA0.velocity.x = (objA0.flags38 & 0x08) ? -0x100 - getScreenExtend() * 2 - getScreenExtend() * 2 / 14 : 0x100 + getScreenExtend() * 2 + getScreenExtend() * 2 / 14
	fn0685e2()
}

//# address-hook(0x068508) end(0x068526)
function void fn068508()
{
	setupObjectAttributesFull(0x068ffe)

	u8[A0 + 0x29] = 0x60
	screenmover_target.right = move_area.right
	level.boss_encounter = 1

	requestLoadingPatterns(0x5a)		// Boss sprites
	
#if STANDALONE
	// Move to the right for widescreen
	objA0.position.x.u16 += getScreenExtend() * bb.cutsceneadjust			// 0x02 is the conifg option for closer to wall.
#endif
}

// Add some more offset to the explosions for widescreen
//# address-hook(0x068ee4)
function void fn068ee4()
{
	if (!bb.cutsceneadjust2 || global.zone_act != 0x0000)
	{
		base.fn068ee4()
		return
	}
	
	D0.u16 >>= 1
	D1.u8 = u8[A1 + 0x39] + 4
	u8[A1 + 0x39] = D1.u8
	D1.u16 &= 0x0c
	D0.u16 += D1.u16

	if (objA1.render_flags & render_flag.FLIP_X)
	{
		A2 = 0x068f3e
		A3 = 0x068f58
	}
	else
	{
		A2 = 0x068f2e
		A3 = 0x068f4e
	}

	// Determine where the rocket comes down
	//  -> Note that this is used for both the transition cutscene and the boss fight (where rockets appear only for Knuckles)
	D0.u8 = u8[A2 + D0.u16]
	u16 offset = u16[A3 + D0.u16 * 2]
#if STANDALONE
	offset = u32(offset) * getScreenWidth() / (320 - getScreenExtend()*2)
#endif
	objA0.position.x.u16 = camera.position.x.u16 + offset
	objA0.velocity.y = 0x400
}

// Make explosions appear over more of screen width
//# address-hook(0x083e90)
function void fn083e90()
{
	if (!bb.cutsceneadjust2 || global.zone_act != 0x0000)
	{
		base.fn083e90()
		return
	}

	GetRandomNumber()
	D1 = objA0.value3a + Math.roundToInt( (D0 % 10) / 10.0f * getScreenExtend())
	D2 = D1.u16 * 2 - 1
	D0.u16 = (D0.u16 & D2.u16) - D1.u16
	objA1.position.x.u16 += D0.u16 

	D0 = (D0 << 16) + (D0 >> 16)
	D1 = objA0.value3b
	D2.u16 = D1.u16 * 2 - 1
	D0.u16 = (D0.u16 & D2.u16) - D1.u16
	objA1.position.y.u16 += D0.u16
}

// Fix bug where signpost can appear behind trees in AIZ1.
//# address-hook(0x0837b2) end(0x0837c8)
function void SignPost.BaseUpdate()
{
	if (global.zone == 0x00)
	{
		objA0.sprite_priority = 0x300
		objA0.sprite_attributes |= sprite_attribute.PRIORITY
	}
	
	base.SignPost.BaseUpdate()
}

//-------------
// Twin Hammers
//-------------

// Adjust the boss position for Knuckles

//# address-hook(0x08cf80) end(0x08cfac)
function void fn08cf80()
{
	if (!bb.twinhammer)
	{
		base.fn08cf80()
		return
	}
	
	A1 = 0x08cf70
	if (InitBoss(0x08cf8a))
		return

	level.vertical_wrap = u16[(A1+=2)-2]
	move_area.bottom.current = u16[A1]
	move_area.bottom.target = u16[(A1+=2)-2]
	move_area.left = u16[(A1+=2)-2]
	move_area.right = u16[(A1+=2)-2]
	fn08d0ea()

	objA0.position.y.u16 += 0x50					// Move the boss down
	u8[0xffff8c41] = 0xc1							// Change the tile to wall
	u8[0xffff8ce1] = 0xdb							// Change the tile to open boxess
	// "spawnChildObjects(0x08d26c)" replaced by:
	spawnChildObject(0x08d046, 0x00, -32, 0)
	spawnChildObject(0x08d046, 0x02, 32, 0)

	objA0.update_address = 0x08cfb2
	fn08cfb2()
}

// Stop doing the strange thing to the tile...
// Not sure exactly how this works but this is what fixed the issue.
// There must be a similar function messing with the box graphics themselves.
//# address-hook(0x054146) end(0x054162)
function void fn054146()
{
	if (!bb.twinhammer)
	{
		base.fn054146()
		return
	}
}

// Fix the messed up tile in the Sonic & Tails route.
//# address-hook(0x08cb9e) end(0x08cbec)
function void fn08cb9e()
{
	if (bb.twinhammer)
	{
		u8[0xffff8600] = 0x45
	}
	
	
	base.fn08cb9e()
}

// Add Bits on death
//# address-hook(0x085694) end(0x0856b0)
function void fn085694()
{
	if !(bb.twinhammer_breaks && level.boss_encounter == 1 && global.zone_act == 0x0600)
	{
		base.fn085694()
		return
	}

	--objA0.countdown_value
	if (objA0.countdown_value >= 0)
	{
		DrawObject()
	}
	else
	{
		objA0.render_flags &= ~render_flag.VISIBLE
		objA0.countdown_value = 119
		
		// Spawn boss giblets
			
		// Inside
		u8 flags = objA0.animation.sprite > 0 ? 2 | (objA0.animation.sprite < 2 ? 4 : 0) : 0  //(level.framecounter.low & 0x01 ? 0 : 2) | (level.framecounter.low & 0x02 ? 0 : 4)

		//System.writeDisplayLine(stringformat("Values: 0x%02x, 0x%02x",objA0.animation.sprite, flags))
		
		BB.SpawnPart(-0x100, -0x180, 10, flags, -12, 0)
		BB.SpawnPart(0x100, -0x180, 10, flags | 1, 12, 0)
		
		// Outside
		BB.SpawnPart(-0x200, -0x250, 8, 0, -12, -12)
		BB.SpawnPart(0x200, -0x250, 8, 1, 12, -12)
		BB.SpawnPart(-0x250, -0x100, 9, 0, -12, 12)
		BB.SpawnPart(0x250, -0x100, 9, 1, 12, 12)

		A1 = objA0.countdown_callback
		call A1
	}
}

// Make Arms Flash
//# address-hook(0x07279e) end(0x0727aa)
function void fn07279e()
{
	UpdateMovementSimple()
	Object.CountdownAndTrigger()
	if !bb.twinhammer_breaks || (level.framecounter.low & 0x01)
		DrawObject()
}

//-----------------
// LBZ Wall Trigger
//-----------------

//# address-hook(0x025d2c) end(0x025d52)
function void fn025d2c()
{
	if (!bb.lbztriggers)
	{
		base.fn025d2c()
		return
	}
	
	if (u8[A1 + 0x20] == char.state.ROLLING || BB.canBreak(u8[A1 + 0x20]))
	{
		objA1.velocity.x = -objA1.velocity.x
		objA1.velocity.y = -objA1.velocity.y
		u8[A3] ^= (1 << D3.u8)
		objA0.update_address = addressof(SmallExplosion.BaseUpdate)
		objA0.base_state = 0x02
		u8[A0 + 0x28] = 0
		u8[A0 + 0x29] = 0
	}
}

function bool BB.canBreak(u8 state.in)
{
#if AMY_GALORE_ACTIVE
	if (global.characters == CHARACTER_AMY || global.characters == CHARACTER_AMY_TAILS) && u8[A1 + 0x38] == CHARACTER_SONIC
		return (state.in == char.state.ROLLING) || (state.in == char.state.HAMMERJUMP) || (state.in == char.state.HAMMERSWING) || (state.in == char.state.HAMMERGLIDE) || (state.in == char.state.NOROLLJUMP && AmyMISC.NoRollDmg == 0x01)
#endif
	return (u8[A1 + 0x38] == CHARACTER_SONIC && state.in == char.state.SONIC_DROPDASH) || (u8[A1 + 0x38] == CHARACTER_TAILS && s16(objA0.position.y.u16) < s16(objA1.position.y.u16)) && (state.in == char.state.TAILS_FLYDOWN || state.in == char.state.TAILS_FLYUP || state.in == char.state.TAILS_CARRYDOWN || state.in == char.state.TAILS_CARRYUP) || (u8[A1 + 0x38] == CHARACTER_KNUCKLES && (u8[A1 + 0x2f] == 1 || u8[A0 + 0x2f] == 3))
}


//# address-hook(0x01050c) end(0x01059a)
function void fn01050c()
{
	if (!bb.hyper)
	{
		base.fn01050c()
		return
	}

	if ((objA1.render_flags & render_flag.VISIBLE) == 0)
		return
	
	D0.u8 &= collision_attributes.flags
	if (D0.u8 == 0 || objA1.update_address == 0x087f5c || objA1.update_address == 0x088282 || objA1.update_address == 0x08833c || objA1.update_address == 0x08eda6)
	{
		if (u8[A1 + 0x29] == 0 || objA1.update_address == 0x087f5c || objA1.update_address == 0x088282 || objA1.update_address == 0x08833c || objA1.update_address == 0x08eda6)
		{
			if (u32[0xffff0000 + char.object_standing_on] == 0x08faec || u32[0xffff0000 + char.object_standing_on] == 0x08eda6) //make the character in the air after destroying rockn or iwamodoki if they standin' on 'em
			{
				u8[A0 + 0x2a] |= char.flag.IN_AIR
				u8[A0 + 0x2a] &= ~char.flag.ON_OBJECT
			}
			fn01052e()
		}
	}
	else if (D0.u8 == collision.flag.SPECIAL)
	{
		fn01059c()
	}
	else if ((D0.u8 & collision.flag.THREAT) && (u8[A1 + 0x2b] & char.bonus.DEFLECTABLE))
	{
		deflectProjectile()
	}
}

function void Character.clearEnemiesOnScreen(u16 minY)
{
	if (!bb.hyper)
	{
		base.Character.clearEnemiesOnScreen(minY)
		return
	}

	push(A4)
	push(A3)
	push(A2)

	// Go through all the badniks to destroy
	D6.u16 = global.dynamic_objects.size
	A4 = addressof(global.dynamic_objects.size) + 2		// Resulting address: 0xffffe382
	while (D6.u16 != 0)
	{
		// Get address of dynamic object
		A1 = 0xffff0000 + u16[A4]
		A4 += 2

		D0 = objA1.collision_attributes
		if (D0.u8 != 0 || objA1.update_address == 0x08faec || objA1.update_address == 0x087f5c || objA1.update_address == 0x088282 || objA1.update_address == 0x08833c || objA1.update_address == 0x08eda6)
		{
		#if STANDALONE
			// Assuming minY is only set for lightning shield touching water
			if (minY > 0)
			{
				if (objA1.position.y.u16 >= minY)
				{
					fn01050c()
				}
			}
			else
		#endif
			{
				fn01050c()
			}
		}
		D6.u16 -= 2
	}

	A2 = pop()
	A3 = pop()
	A4 = pop()
}

//# address-hook(0x08faec) end(0x08fb36)
//# alias(fn08faec) deprecated
function void Iwamodoki.BaseUpdate()
{
	if (!bb.hyper)
	{
		base.Iwamodoki.BaseUpdate()
		return
	}

	// Targets:
	//  - 0x08fb42	-> objA0.base_state = 0x00
	//  - 0x08fb4c	-> objA0.base_state = 0x02
	//  - 0x08fb70	-> objA0.base_state = 0x04
	call tableLookupAddress(0x08fb3c, objA0.base_state)

	D0.u16 = (objA0.position.x.u16 & 0xff80) - level.despawn_position.x
	if (D0.u16 <= 0x0280)
	{
		if (objA0.flags2a & 0x80)
		{
			fn08594e()
			return
		}

		D1 = 0x17
		D2 = 0x0c
		D3 = 0x0b
		D4.u16 = objA0.position.x.u16
		fn01dc56()

		AddAsDynamicObject()
		DrawObject()
	}
	else
	{
		fn08594e()
		Enemy.UnloadDelayed()
	}
}