//----------------
// Generic Methods
//----------------

// Spawn Object
function void BB.SpawnPart(s16 speed.x, s16 speed.y, u8 part, u8 index)
{
	if (allocDynamicObjectStd())										// Get a memory address (or don't do anything if there is none available)
	{
		objA1.update_address = 0x251000									// Set an update address.
		objA1.render_flags = (render_flag.WORLD | render_flag.VISIBLE)	// Make sure the object renders correctly.

		objA1.box_size.x = 0x40											// Set its draw distance (how far off-screen can it go).
		objA1.box_size.y = 0x40
		
		objA1.velocity.x = speed.x										// Set its speed (part of the function parameters). Also at some of randomness.
		objA1.velocity.y = speed.y
		
		objA1.position.x.u16 = objA0.position.x.u16						// Same position as the object we spawn from.
		objA1.position.y.u16 = objA0.position.y.u16

		objA1.state = part												// What badnik part?
		objA1.animation.sprite = index									// What sprite index? Use 0 if not needed.
		objA1.flags38 = 2												// We will use this for flashing

	}
}

// Spawn Object with Offset
function void BB.SpawnPart(s16 speed.x, s16 speed.y, u8 part, u8 index, s16 offst.x, s16 offst.y)
{
	if (allocDynamicObjectStd())										// Get a memory address (or don't do anything if there is none available)
	{
		objA1.update_address = 0x251000									// Set an update address.
		objA1.render_flags = (render_flag.WORLD | render_flag.VISIBLE)	// Make sure the object renders correctly.

		objA1.box_size.x = 0x40											// Set its draw distance (how far off-screen can it go).
		objA1.box_size.y = 0x40
		
		objA1.velocity.x = speed.x										// Set its speed (part of the function parameters). Also at some of randomness.
		objA1.velocity.y = speed.y
		
		objA1.position.x.u16 = objA0.position.x.u16 + offst.x			// Offset position from the object we spawn from.
		objA1.position.y.u16 = objA0.position.y.u16 + offst.y

		objA1.state = part												// What badnik part?
		objA1.animation.sprite = index									// What sprite index? Use 0 if not needed.
		objA1.flags38 = 2												// We will use this for flashing

	}
}

// Update Object
//# address-hook(0x251000)
function void BB.Particle.Update()
{
	UpdateMovementStraightSimple()					// Movement function, uses objA0.velocity.x and y.
	
	objA0.velocity.y += 0x060						// Simulate gravity.
	
	objA0.flags38 += 0x01
	
	if !(objA0.flags38 & 0x01)			// Don't always render the object, to give it that breaking feeling.
		DrawObject()

	
	if !(objA0.render_flags & render_flag.VISIBLE)	// Off-screen?
	{
		UnloadObject()								// Then unload. Make sure to do this at the end of the object's update function!
	}
}

function bool BB.customBadniks()
{
	return Mods.isModActive("Badniks Customizer")
}

// Render Object
function bool Standalone.onWriteToSpriteTable(s16 px, s16 py, u16 renderQueue)
{
	
	if (objA0.update_address == 0x251000)															// It's our object.
	{
		u64 key
		u8 flags = 0 																				// No sprite flags in most cases
		u16 rq = 0x9fff
		
		
		if (objA0.state == 1)																		// Spikebonker
		{
			flags |=  SPRITE_FLAG_PRIO
			if BB.customBadniks()
				key = stringformat("spikebonder_spike_%d", objA0.animation.sprite - 1)
			else
				key = stringformat("bonker_%d", objA0.animation.sprite)
		}
		else if (objA0.state == 2)																	// Ribot
		{
			if BB.customBadniks()
				key =  objA0.animation.sprite ? "ribot_bigchain" : "ribot_smallchain"
			else
				key = stringformat("ribot_chain_%d", objA0.animation.sprite)
		}
		else if (objA0.state == 3)																	// Skorp Tail
		{
			key = BB.customBadniks() ? "skorp_circle_0" : "skorp_tail"
		}
		else if (objA0.state == 4)																	// Skorp Tail Spike
		{
			key = BB.customBadniks() ? "skorp_circle_1" : "skorp_stinger"
			if (objA0.animation.sprite == 1)
				flags |=  SPRITE_FLAG_FLIP_X
		}
		else if (objA0.state == 5)																	// Turbospiker
		{
			key = BB.customBadniks() ? "turbo_spiker_rocket" : "turbospiker_rocket"
			flags |=  SPRITE_FLAG_PRIO
			if (objA0.animation.sprite == (BB.customBadniks() ? 1 : 0))
				flags |= SPRITE_FLAG_FLIP_X
		}
		else if (objA0.state == 6)																	// Dragonfly Tail
		{
			key = BB.customBadniks() ? "dragonfly_spikes_0" : "dragonfly_tail"
			flags |=  SPRITE_FLAG_PRIO																// We give it priority for Origins parity
			if (objA0.animation.sprite == 1)
				flags |=  SPRITE_FLAG_FLIP_Y
		}
		else if (objA0.state == 7)																	// Dragonfly Tail Tip
		{
			key = BB.customBadniks() ? "dragonfly_spikes_1" : "dragonfly_tip"
			flags |=  SPRITE_FLAG_PRIO																// We give it priority for Origins parity
			if (objA0.animation.sprite == 1)
				flags |=  SPRITE_FLAG_FLIP_Y
		}
		else if (objA0.state == 8)																	// Twin Hammer Top
		{
			key = "twinhammer_top_left"
			flags |=  SPRITE_FLAG_PRIO
			if (objA0.animation.sprite == 1)
				flags |=  SPRITE_FLAG_FLIP_X
		}
		else if (objA0.state == 9)																	// Twin Hammer Bottom
		{
			key = "twinhammer_bottom_left"
			flags |=  SPRITE_FLAG_PRIO
			if (objA0.animation.sprite == 1)
				flags |=  SPRITE_FLAG_FLIP_X
		}
		else if (objA0.state == 10)																	// Twin Hammer inside
		{
			key = (objA0.animation.sprite & 2) ? "twinhammer_inside_left_2" : "twinhammer_inside_left_1"
			rq -= 15
			flags |=  SPRITE_FLAG_PRIO
			
			if (objA0.animation.sprite & 4)
			{
				if (objA0.animation.sprite & 1 == 1)
					flags |=  SPRITE_FLAG_FLIP_X
				else
					flags |=  SPRITE_FLAG_FLIP_Y					
			}
			else if (objA0.animation.sprite & 1)
			{
				flags |=  SPRITE_FLAG_FLIP_X
				flags |=  SPRITE_FLAG_FLIP_Y
			}
		}
		else if (objA0.state == 11)																	// Emerald Claw
		{
			key = objA0.animation.sprite ? "emerald_claw_1" : "emerald_claw_2"
			if !(objA0.animation.sprite)
				rq = 0x4000
				
			if objA0.animation.frame < 1
			{
				objA0.animation.frame++
				return true
			}
		}
		else if (objA0.state == 12)																	// Madmole
		{
			key = BB.customBadniks() ? "turbo_spiker_rocket" : "madmole_mushroom"
			flags |=  SPRITE_FLAG_PRIO
			if (objA0.animation.sprite == (BB.customBadniks() ? 1 : 0))
				flags |= SPRITE_FLAG_FLIP_X
			
			objA0.animation.frame += 0x20
		}
		else if (objA0.state == 13)																	// Monkeydude
		{
			key = BB.customBadniks() ? "turbo_spiker_rocket" : "monkeydude_coconut"
			flags |=  SPRITE_FLAG_PRIO
		}
		else
		{
			return true
		}
		
		Renderer.drawCustomSprite(key, px, py, 0x00, flags, rq, objA0.state == 12 ? objA0.animation.frame - 0x20 : 0x00, 0xff)						// High priority and renderQueue, to appear above most other things.
		return true																					// Make sure to return after!
	}
	else if BB.customBadniks() && (objA0.update_address == 0x204300)
	{
		if (objA0.subtype2c == 0x01)
		{
			Renderer.drawCustomSprite("star_pointer_ice_0", px, py, 0x00, objA0.render_flags, renderQueue)
			return true
		}
		else if (objA0.subtype2c == 0x05)
		{
			Renderer.drawCustomSprite("orbinaut_spike", px, py, 0x00, objA0.render_flags, renderQueue)
			return true
		}
	}
	
	return base.Standalone.onWriteToSpriteTable(px, py, renderQueue)								// And then return the base.
}

//------------
// Spikebonker
//------------

//# address-hook(0x091aec) end(0x091b38)
function void fn091aec()
{
	if (!bb.spikebonker)
	{
		base.fn091aec()
		return
	}
	
	MoveAndFlipWithParent()
	A1 = 0xffff0000 + u16[A0 + 0x44]

	D0 = u8[A1 + 0x3c]
	if (D0.u8 == 0)
	{
		A2 = 0xffff0000 + u16[A0 + 0x46]
		if (u8[A2 + 0x38] & 0x08)
		{
			objA0.update_address = 0x091b3e
			objA0.velocity.x = (objA0.render_flags & render_flag.FLIP_X) ? 4 : -4
			objA0.countdown_value = 0x1f
			objA0.countdown_callback = 0x091b68
			BB.BreakBall()
			return
		}
	}

	D0.u8 -= 8
	u8[A1 + 0x3c] = D0.u8
	BB.BreakBall()
}


//# address-hook(0x091b3e) end(0x091b50)
function void fn091b3e()
{
	if (!bb.spikebonker)
	{
		base.fn091b3e()
		return
	}
	
	D0.u16 = objA0.position.x.u16 + objA0.velocity.x
	objA0.position.x.u16 = D0.u16
	Object.CountdownAndTrigger()
	BB.BreakBall()
}

//# address-hook(0x091b70) end(0x091ba2)
function void fn091b70()
{
	if (!bb.spikebonker)
	{
		base.fn091b70()
		return
	}
	
	A1 = 0xffff0000 + u16[A0 + 0x44]
	D0.u8 = u8[A1 + 0x3c]
	if (D0.u8 != 0x80)
	{
		D0.u8 -= 8
		u8[A1 + 0x3c] = D0.u8
	}
	else
	{
		objA0.update_address = 0x091b3e
		objA0.velocity.x = -objA0.velocity.x
		objA0.countdown_value = 0x1f
		objA0.countdown_callback = 0x091b56
	}

	BB.BreakBall()
}

function void BB.BreakBall()
{
	A1 = 0xffff0000 + u16[A0 + 0x46]
	if (u8[A1 + 0x2a] & 0x80)
	{
		// Adds velocity randomly if the mob has not thrown the ball. Looks acceptable.
		if (objA0.velocity.x == 0)
			objA0.velocity.x = (System.rand() & 1) ? 4 : -4

		BB.SpawnPart(objA0.velocity.x * 0x140, 0, 0x01, u8[0xffff0000 + u16[A0 + 0x44] + 0x22])
		Object.TriggerUnloading()
	}
}

//-------
// Ribbit
//-------

// Variant: Swinging its weight in a circle around him

//# address-hook(0x08c370) end(0x08c388)
function void fn08c370()
{
	if (!bb.ribit)
	{
		base.fn08c370()
		return
	}
	
	A1 = 0xffff0000 + u16[A0 + 0x46]
	D2 = u8[A1 + 0x2c]

	// Targets:
	//  - 0x08c396	-> objA0.base_state = 0x00
	//  - 0x08c3bc	-> objA0.base_state = 0x02
	//  - 0x08c428	-> objA0.base_state = 0x04
	//  - 0x08c48e	-> objA0.base_state = 0x06
	//  - 0x08c4ba	-> objA0.base_state = 0x08
	call tableLookupAddress(0x08c38c, objA0.base_state)

	BB.BreakFrog(true)
}

//# address-hook(0x08c502) end(0x08c51e)
function void fn08c502()
{
	if (!bb.ribit)
	{
		base.fn08c502()
		return
	}
	
	setupObjectAttributesBasic(0x08c5dc)
	objA0.update_address = 0x08c522
	objA0.value3e = objA0.position.x.u16
	u16[A0 + 0x40] = objA0.position.y.u16
	BB.BreakFrog(false)
}


//# address-hook(0x08c522) end(0x08c544)
function void fn08c522()
{
	if (!bb.ribit)
	{
		base.fn08c522()
		return
	}
	
	A1 = 0xffff0000 + u16[A0 + 0x46]
	D2.u16 = objA1.position.x.u16 - objA0.value3e
	D3.u16 = objA1.position.y.u16 - u16[A0 + 0x40]

	// Targets:
	//  - 0x08c54e	-> objA0.subtype2c = 0x00
	//  - 0x08c568	-> objA0.subtype2c = 0x02
	//  - 0x08c57e	-> objA0.subtype2c = 0x04
	call tableLookupAddress(0x08c548, objA0.subtype2c)
	BB.BreakFrog(false)
}

function void BB.BreakFrog(bool dyn)
{
	A1 = 0xffff0000 + u16[A0 + 0x46]
	if (u8[A1 + 0x2a] & 0x80)
	{
		BB.SpawnPart((objA0.position.x.u16 - objA0.value3e != 0) ? (objA0.position.x.u16 - objA0.value3e) * 0x14 : (objA0.update_address == 0x08c370 ? -1 : 1) * ((objA0.subtype2c == 0) ? System.rand() % 0x200 + 0xa0 : -0xa0 - System.rand() % 0x300), (objA0.position.y.u16 - u16[A0 + 0x40] != 0 || objA0.update_address == 0x08c370) ? (objA0.position.y.u16 - u16[A0 + 0x40]) * 0x14 : -0x40 - System.rand() % 0x80, 0x02, objA0.update_address == 0x08c370 ? 1 : 0)
		
		// Old Method
		//BB.SpawnPart((System.rand() & 1) ? System.rand() % 0x100 + 0x80 + 0x80 * (objA0.update_address == 0x08c370 ? 1 : 2) : System.rand() % 0x100 * -1 - 0x80 - 0x80 * (objA0.update_address == 0x08c370 ? 1 : 2), System.rand() % 0x100 * -1 - 0x100 * (objA0.update_address == 0x08c370 ? 1 : 2), 0x02, objA0.update_address == 0x08c370 ? 1 : 0)
		
		Object.TriggerUnloading()
	}
	else
	{
		if (dyn)
			AddAsDynamicObject()
			
		DrawObject()
	}
}

//------
// Skorp
//------

//# address-hook(0x08e744) end(0x08e772)
function void fn08e744()
{
	if (!bb.skorp)
	{
		base.fn08e744()
		return
	}
	
	// I had to do this call here before the table lookup,
	// otherwise the direction is not considered when idle.
	A1 = 0xffff0000 + u16[A0 + 0x44]
	if !((u8[A1 + 0x2a] & 0x80) == 0)
	{
		
		s16 dirFlag = (objA0.render_flags & render_flag.FLIP_X) ? 1 : -1
		s16 xSpeed = objA0.subtype2c - 0x05
		
		if (objA0.subtype2c != 0x0a)
			BB.SpawnPart(dirFlag * xSpeed * (System.rand() % 0x100 + 0x080), System.rand() % 0x200 * -1 - 0x200, 0x03, 0)
		else
			BB.SpawnPart(dirFlag * xSpeed * (System.rand() % 0x100 + 0x080), System.rand() % 0x200 * -1 - 0x200, 0x04, (objA0.render_flags & render_flag.FLIP_X) ? 1 : 0) 
		
		Object.TriggerUnloading()
		return
	}
	
	// Targets:
	//  - 0x08e78c	-> objA0.base_state = 0x00
	//  - 0x08e7d4	-> objA0.base_state = 0x02
	//  - 0x08e828	-> objA0.base_state = 0x04
	//  - 0x08e868	-> objA0.base_state = 0x06
	//  - 0x08e88c	-> objA0.base_state = 0x08
	//  - 0x08e8c4	-> objA0.base_state = 0x0a
	//  - 0x08e8be	-> objA0.base_state = 0x0c
	//  - 0x08e8be	-> objA0.base_state = 0x0e
	//  - 0x08e918	-> objA0.base_state = 0x10
	//  - 0x08e958	-> objA0.base_state = 0x12
	call tableLookupAddress(0x08e778, objA0.base_state)

	A1 = 0xffff0000 + u16[A0 + 0x44]
	if ((u8[A1 + 0x2a] & 0x80) == 0)
	{
		if (objA0.subtype2c == 0x0a)
		{
			AddAsDynamicObject()
		}
		DrawObject()
	}
	else
	{
		Object.TriggerUnloading()
	}
}

//------------
// Turbospiker
//------------

//# address-hook(0x087d5e) end(0x087da0)
function void fn087d5e()
{
	if (!bb.turbospiker)
	{
		base.fn087d5e()
		return
	}
	
	A1 = 0xffff0000 + u16[A0 + 0x46]
	if (u8[A1 + 0x2a] & 0x80)
	{
		BB.SpawnPart((System.rand() & 1) ? System.rand() % 0x100 + 0x200 : System.rand() % 0x100 * -1 - 0x200, System.rand() % 0x200 * -1 - 0x300, 0x05, (objA0.render_flags & render_flag.FLIP_X) ? 1 : 0)
		Object.TriggerUnloading()
	}
	
	base.fn087d5e()
}

//----------
// Dragonfly
//----------

//# address-hook(0x08de26) end(0x08de34)
function void fn08de26()
{
	if (!bb.dragonfly)
	{
		base.fn08de26()
		return
	}
	
	// Targets:
	//  - 0x08de44	-> objA0.base_state = 0x00
	//  - 0x08de74	-> objA0.base_state = 0x02
	//  - 0x08de8a	-> objA0.base_state = 0x04
	//  - 0x08deb6	-> objA0.base_state = 0x06
	//  - 0x08def4	-> objA0.base_state = 0x08
	call tableLookupAddress(0x08de3a, objA0.base_state)

	BB.BreakDragonfly()
}

function void BB.BreakDragonfly()
{
	A1 = 0xffff0000 + u16[A0 + 0x46]
	if (u8[A1 + 0x2a] & 0x80)
	{
		if (objA0.subtype2c != 0x0c)
			BB.SpawnPart((System.rand() & 1) ? System.rand() % 0x100 + 0x200 : System.rand() % 0x100 * -1 - 0x200, System.rand() % 0x100 * -1 - 0x200, 0x06, (objA0.render_flags & render_flag.FLIP_Y) ? 1 : 0)
		else
			BB.SpawnPart((System.rand() & 1) ? System.rand() % 0x100 + 0x200 : System.rand() % 0x100 * -1 - 0x200, System.rand() % 0x100 * -1 - 0x200, 0x07, (objA0.render_flags & render_flag.FLIP_Y) ? 1 : 0)
		
		Object.TriggerUnloading()
	}
	else
	{
		AddAsDynamicObject()			
		DrawObject()
	}
}

//----------//
// Mad Mole //
//----------//

//# address-hook(0x00ffd4) end(0x010214)
function void Character.OnCollisionWithDynamicObject()
{
	if (!bb.madmole || global.zone != 0x07)
	{
		base.Character.OnCollisionWithDynamicObject()
		return
	}
	
	bool mole_flags
	u32 mole_address
	if (objA1.update_address == addressof(Madmole.BaseUpdate) && (objA1.base_state & 0x06 && u32[A1 + 0x30] != 0x08d9dd))
	{
		mole_address = objA1.update_address
		mole_flags = objA1.render_flags & render_flag.FLIP_X
	}
	
	base.Character.OnCollisionWithDynamicObject()
	
	if mole_address
	{
		if (objA1.update_address == addressof(SmallExplosion.BaseUpdate))
		{
			u32 A1_backup = A1
			u32 A0_backup = A0
			BB.SpawnPart(mole_flags ? System.rand() % 0x100 * -1 - 0x200 : System.rand() % 0x100 + 0x200 , System.rand() % 0x200 * -1 - 0x300, 0x0c, mole_flags ? 1 : 0, mole_flags ? -14 : 14, -12)
			A1 = A1_backup
			A0 = A0_backup
		}
			
		mole_address = 0
	}
}


//------------
// Monkey Dude
//------------

// Broken Bit

//# address-hook(0x08744c) end(0x08745e)
function void fn08744c()
{
	if (!bb.monkeydude)
	{
		base.fn08744c()
		return
	}
	
	fn087518()

#if STANDALONE
	// Fix for the coconut palette before it's thrown, #contributed by Legobouwer
	objA0.sprite_attributes = 0x0548
	if (objA0.animation.sprite != 6)
		objA0.sprite_attributes |= sprite_attribute.PALETTE.LINE1
#endif

	// Targets:
	//  - 0x087468	-> objA0.base_state = 0x00
	//  - 0x087472	-> objA0.base_state = 0x02
	call tableLookupAddress(0x087462, objA0.base_state)

	BB.BreakMonkeydude()
}

function void BB.BreakMonkeydude()
{
	A1 = 0xffff0000 + u16[A0 + 0x46]
	if (u8[A1 + 0x2a] & 0x80)
	{
		if (objA0.animation.sprite == 6)
			BB.SpawnPart(System.rand() & 1 ? System.rand() % 0x180 * -1 - 0x80 : System.rand() % 0x180 + 0x80 , System.rand() % 0x100 * -1 - 0x200, 0x0d, 0)
		
		Object.TriggerUnloading()
	}
	else
	{
		DrawObject()
	}
}

// Movement

//# address-hook(0x0871da) end(0x087246)
function void fn0871da()
{
	if (!bb.monkeysmooth)
	{
		base.fn0871da()
		return
	}
	
	Object.AnimationProgressByLocalA1.DistinctTimer()

	bool goto087218 = false
	if (objA0.flags38 & 0x04)
	{
		if (objA0.animation.sprite != 2)
			return

		--objA0.value39
		if (objA0.value39 != 0)
		{
			objA0.position.y.u16 -= 1				// Divided by 8.
			return
		}
		goto087218 = true
	}

	if (objA0.animation.sprite == 0)
	{
		objA0.position.y.u16 += 1					// Divided by 8.
		--objA0.value39
		goto087218 = (objA0.value39 == 1)
	}

	if (goto087218)
	{
		objA0.base_state = 0x02
		objA0.value39 = objA0.subtype2c * 8			// I made it move 8 times less so it needs to be 8 times.
		objA0.flags38 ^= 0x04
		objA0.countdown_value = 0x3b
		u32[A0 + 0x30] = 0x0876b4
		objA0.animation.sprite = 0
		objA0.animation.frame = 0
		objA0.animation.timer = 0
	}

}

