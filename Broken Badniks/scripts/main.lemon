//------------
// Fire Breath
//------------

//# address-hook(0x068a46) end(0x068a68)
function void fn068a46()
{
	if (!bb.firebreath)
	{
		base.fn068a46()
		return
	}
	
	setupObjectAttributesFull(0x068ffe)
	boss.remaining_hits = 6
	level.boss_encounter = 1

	requestLoadingPatterns(0x5a)		// Boss sprites
	loadPaletteLine1(0x06917c)

#if STANDALONE
	// Move to the right, so that there is no dead corner where character is behind him
	objA0.position.x.u16 += getScreenExtend() 			// This was in the 3 A.I.R. code already but with an extra offset.
#endif
}

//# address-hook(0x068b92) end(0x068bb8)
function void fn068b92()
{
	if (!bb.firebreath)
	{
		base.fn068b92()
		return
	}
	
	objA0.base_state = 0x0e
	objA0.value39 = 0x04
	objA0.countdown_callback = 0x068bdc
	objA0.flags38 ^= 0x08		// Flip horizontal movement direction
	
	// Adjust he velocity to ensure the boss moves consistently across the stage, keeping the same pace as the original fight.
	objA0.velocity.x = (objA0.flags38 & 0x08) ? -0x100 - getScreenExtend() * 2 - getScreenExtend() * 2 / 14 : 0x100 + getScreenExtend() * 2 + getScreenExtend() * 2 / 14
	fn0685e2()
}

//# address-hook(0x068508) end(0x068526)
function void fn068508()
{
	setupObjectAttributesFull(0x068ffe)

	u8[A0 + 0x29] = 0x60
	screenmover_target.right = move_area.right
	level.boss_encounter = 1

	requestLoadingPatterns(0x5a)		// Boss sprites
	
#if STANDALONE
	// Move to the right for widescreen
	objA0.position.x.u16 += getScreenExtend() * bb.cutsceneadjust			// 0x02 is the conifg option for closer to wall.
#endif
}

// Add some more offset to the explosions for widescreen
//# address-hook(0x068ee4)
function void fn068ee4()
{
	if (!bb.cutsceneadjust2 || global.zone_act != 0x0000)
	{
		base.fn068ee4()
		return
	}
	
	D0.u16 >>= 1
	D1.u8 = u8[A1 + 0x39] + 4
	u8[A1 + 0x39] = D1.u8
	D1.u16 &= 0x0c
	D0.u16 += D1.u16

	if (objA1.render_flags & render_flag.FLIP_X)
	{
		A2 = 0x068f3e
		A3 = 0x068f58
	}
	else
	{
		A2 = 0x068f2e
		A3 = 0x068f4e
	}

	// Determine where the rocket comes down
	//  -> Note that this is used for both the transition cutscene and the boss fight (where rockets appear only for Knuckles)
	D0.u8 = u8[A2 + D0.u16]
	u16 offset = u16[A3 + D0.u16 * 2]
#if STANDALONE
	offset = u32(offset) * getScreenWidth() / (320 - getScreenExtend())
#endif
	objA0.position.x.u16 = camera.position.x.u16 + offset
	objA0.velocity.y = 0x400
}

// Fix bug where signpost can appear behind trees in AIZ1.
