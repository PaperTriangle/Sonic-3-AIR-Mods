define u8 global.xtrachar	= u8[0xffffe654]
global bool sdmd.ignore_ground
global bool sdmd.ignore_ground_p2
global u8 balloonjump

define u32 char.ADDRESS_P1 = 0xffffb000
define u32 char.ADDRESS_P2 = 0xffffb04a

#define SDMD_ACTIVE

//---------------------
// Mod Compat Functions
//---------------------

function bool SDMD.canBounce(u32 AX)
{
	bool ecfActyve = 0
#if EXTRA_CHARACTER_FRAMEWORK_ACTIVE
	ecfActyve = getECFCharBufferName(AX) ? 1 : 0
	
	if (getECFCharBufferName(AX) == "JUWL-Amy" && (u8[AX + 0x20] == 0x20 || u8[AX + 0x20] == 0x21))
		return true
#endif

	return (u8[AX + 0x20] == char.state.ROLLING) || (!ecfActyve && u8[AX + 0x38] == CHARACTER_SONIC && u8[AX + 0x20] == char.state.SONIC_DROPDASH) || (global.xtrachar == 3 && AX == char.ADDRESS_P1 && System.getGlobalVariableValueByName("Amy_HammerSpinAttacking"))
}

function bool SDMD.canSmash(u32 AX)
{
#if EXTRA_CHARACTER_FRAMEWORK_ACTIVE
	if (getECFCharBufferName(AX) == "JUWL-Mighty" && u8[AX + 0x20] == 0x20)
		return true
#endif

	return (global.xtrachar == 1 && u8[AX + 0x0d] & 0x02) || (global.xtrachar == 3 && System.getGlobalVariableValueByName("Amy_HammerSpinAttacking") && u8[AX + 0x2f] == 0) || (global.xtrachar == 5 && System.getGlobalVariableValueByName("shadow.DropDown"))
}

function bool SDMD.destroyObjectExternally()
{
	return false
}

//------------------
// Generic Functions
//------------------

function u8 SDMD.breakCheck()
{
	if (global.xtrachar == 5 && System.getGlobalVariableValueByName("shadow.WallLatch") > 0)
		return false
	
	return SDMD.canBounce(char.ADDRESS_P1) | (SDMD.canSmash(char.ADDRESS_P1) << 1) | (SDMD.canBounce(char.ADDRESS_P2) << 2) | (SDMD.canSmash(char.ADDRESS_P2) << 3)
}

function void SDMD.dropPlayers()
{
	if (objA0.flags2a & object.flag.P1_ON_OBJECT)
	{
		u8[char.ADDRESS_P1 + 0x2a] |= char.flag.IN_AIR
		u8[char.ADDRESS_P1 + 0x2a] &= ~char.flag.ON_OBJECT
		u8[char.ADDRESS_P1 + 0x05] = base_state.NORMAL
	}
	else if (objA0.flags2a & object.flag.P1_PUSHING)
	{
		u8[char.ADDRESS_P1 + 0x2a] &= ~char.flag.PUSHING
		u8[char.ADDRESS_P1 + 0x05] = base_state.NORMAL
	}
	
	if (objA0.flags2a & object.flag.P2_ON_OBJECT)
	{
		u8[char.ADDRESS_P2 + 0x2a] |= char.flag.IN_AIR
		u8[char.ADDRESS_P2 + 0x2a] &= ~char.flag.ON_OBJECT
		u8[char.ADDRESS_P2 + 0x05] = base_state.NORMAL
	}
	else if (objA0.flags2a & object.flag.P2_PUSHING)
	{
		u8[char.ADDRESS_P2 + 0x2a] &= ~char.flag.PUSHING
		u8[char.ADDRESS_P2 + 0x05] = base_state.NORMAL
	}
}

function void SDMD.bouncePlayer(bool willBounce, bool willSmash)
{
	u8[A1 + 0x2a] |= char.flag.IN_AIR
	u8[A1 + 0x2a] &= ~char.flag.ON_OBJECT

	if (willSmash)
		return
	else if (willBounce)
		objA1.velocity.y = -0x300
	else
		u8[A1 + 0x05] = base_state.NORMAL
}

function bool SDMD.willItBreak(u8 collisionFlags, u8 shouldBreak)
{
	if (collisionFlags != 0) && (shouldBreak)
	{
		if (collisionFlags == (object.flag.P1_ON_OBJECT | object.flag.P2_ON_OBJECT))
		{
			A1 = char.ADDRESS_P1
			SDMD.bouncePlayer(shouldBreak & 1, shouldBreak & 2)
			
			A1 = char.ADDRESS_P2
			SDMD.bouncePlayer(shouldBreak & 4, shouldBreak & 8)
			
			return true
		}
		else if (collisionFlags & object.flag.P1_ON_OBJECT) && (shouldBreak & 3)
		{
			A1 = char.ADDRESS_P1
			SDMD.bouncePlayer(shouldBreak & 1, shouldBreak & 2)
			
			return true
		}
		else if (collisionFlags & object.flag.P2_ON_OBJECT) && (shouldBreak & 12)
		{
			A1 = char.ADDRESS_P2
			SDMD.bouncePlayer(shouldBreak & 4, shouldBreak & 8)
			
			return true
		}
	}
	
	return false
}

//----------------
// Collision Check
//----------------

//# address-hook(0x01dc56) end(0x01dcb4)
function void fn01dc56()
{
	// Check player 1
	A1 = char.ADDRESS_P1
	D6 = 3		// object.flag.P1_ON_OBJECT
#if STANDALONE
	if (debug_mode.state == 0)
#endif
	{
		u32 backupD1 = D1
		u32 backupD2 = D2
		u32 backupD3 = D3
		u32 backupD4 = D4

		fn01dc74()

		D1 = backupD1
		D2 = backupD2
		D3 = backupD3
		D4 = backupD4
	}

	// Check player 2
	A1 = char.ADDRESS_P2
	if (objA1.render_flags & render_flag.VISIBLE)
	{
		++D6.u8		// object.flag.P2_ON_OBJECT, do not simply set to 4, as upper bits should be preserved
		
		u32 backupD1 = D1
		u32 backupD2 = D2
		u32 backupD3 = D3
		u32 backupD4 = D4

		fn01dc74()

		D1 = backupD1
		D2 = backupD2
		D3 = backupD3
		D4 = backupD4
	}
}

// Dont land on ground if can Smash.
//# address-hook(0x01e490)
function void LetSonicClimbOnObject()
{
	if (!sdmd.ignore_ground && A1 == char.ADDRESS_P1) || (!sdmd.ignore_ground_p2 && A1 == char.ADDRESS_P2)
	{
		base.LetSonicClimbOnObject()
		return
	}
	
	u8 bit = (1 << D6.u8)
	
	// Already on another object?
	if (objA1.flags2a & char.flag.ON_OBJECT)
	{
		// Unregister there
		A3 = 0xffff0000 + u16[A1 + 0x42]
		u8[A3 + 0x2a] &= ~bit
	}
	
	// Standing on this object now
	u16[A1 + 0x42] = A0.u16
	u8[A1 + 0x26] = 0
	objA0.flags2a |= bit
}

//------------------------------------
// Cork Floor (destroyable from above)
//------------------------------------

//# address-hook(0x02a502) end(0x02a586)
function void fn02a502()
{
	u16[A0 + 0x38] = score.bonus_counter
	u8[A0 + 0x34] = u8[char.ADDRESS_P1 + 0x20]
	u8[A0 + 0x36] = u8[char.ADDRESS_P2 + 0x20]
	
	D1 = objA0.box_size.x + 11
	D2 = objA0.box_size.y
	D3.u16 = D2.u16 + 1
	D4.u16 = objA0.position.x.u16

	u8 shouldBreak = SDMD.breakCheck()
	
	if (shouldBreak & 3)
		sdmd.ignore_ground = true
		
	if (shouldBreak & 12)
		sdmd.ignore_ground_p2 = true

	fn01dc56() 							// Collision check was moved into this method!

	sdmd.ignore_ground = false
	sdmd.ignore_ground_p2 = false

	if (SDMD.destroyObjectExternally())
	{
		SDMD.dropPlayers()
		
		fn02a5d8()
		return
	}
	
	u8 collisionFlags = objA0.flags2a & (object.flag.P1_ON_OBJECT | object.flag.P2_ON_OBJECT)
	if (SDMD.willItBreak(collisionFlags, shouldBreak))
	{
		fn02a5d8()
		return
	}
	
	DrawOrUnloadObject()
}

//----------
// AIZ Rocks
//----------

//# address-hook(0x01faf2) end(0x01fb4a)
function void Rocks.Update()
{
	
	u16[A0 + 0x38] = score.bonus_counter
	u8[A0 + 0x32] = u8[char.ADDRESS_P1 + 0x20]
	u8[A0 + 0x33] = u8[char.ADDRESS_P2 + 0x20]
	objA0.value3a = u8[char.ADDRESS_P1 + 0x2a]
	objA0.value3b = u8[char.ADDRESS_P2 + 0x2a]

	D1 = objA0.box_size.x + 11
	D2 = objA0.box_size.y
	D3.u16 = D2.u16 + 1
	D4.u16 = objA0.position.x.u16
	
	u8 shouldBreak = SDMD.breakCheck()
	
	if (shouldBreak & 3) && (objA0.subtype2c & 0x01)
		sdmd.ignore_ground = true
		
	if (shouldBreak & 12) && (objA0.subtype2c & 0x01)
		sdmd.ignore_ground_p2 = true

	fn01dc56() 							// Collision check was moved into this method!

	sdmd.ignore_ground = false
	sdmd.ignore_ground_p2 = false

	if (objA0.subtype2c & 0x02)
	{
		fn0200a2()
	}

	if (objA0.subtype2c & 0x01)
	{
		if (SDMD.destroyObjectExternally())
		{
			SDMD.dropPlayers()
			
			fn01fbf8()
			return
		}
		
		u8 collisionFlags = objA0.flags2a & (object.flag.P1_ON_OBJECT | object.flag.P2_ON_OBJECT)
		if (SDMD.willItBreak(collisionFlags, shouldBreak))
		{
			fn01fbf8()
			return
		}
	}

	fn01fb4c()
}

//------------------------------
// Knuckles Specific AIZ Rock...
//------------------------------

//# address-hook(0x020002) end(0x020052)
function void fn020002()
{
	u16[A0 + 0x38] = score.bonus_counter
	D1 = objA0.box_size.x + 11
	D2 = objA0.box_size.y
	D3.u16 = D2.u16 + 1
	D4.u16 = objA0.position.x.u16

	if (u8[char.ADDRESS_P1 + 0x38] == CHARACTER_KNUCKLES)
		sdmd.ignore_ground = true

	fn01dc56() 							// Collision check was moved into this method!

	sdmd.ignore_ground = false

	D0.u8 = objA0.flags2a & object.flag.P1_ON_OBJECT
	if (D0.u8 == 0)
	{
		DrawOrUnloadObject()
		return
	}

	A1 = char.ADDRESS_P1
	if (u8[A1 + 0x38] != CHARACTER_KNUCKLES)
	{
		DrawOrUnloadObject()
		return
	}
	
	objA1.velocity.y = -0x300
	
	if objA1.state != char.state.ROLLING
	{
		u8[A1 + 0x2a] |= char.flag.ROLLING
		objA1.hitbox_extends.x = char.hitbox.x.ROLLING
		objA1.hitbox_extends.y = char.hitbox.y.ROLLING
		objA1.state = char.state.ROLLING
	}

	if (objA0.flags2a & object.flag.P2_ON_OBJECT)
	{
		A1 = char.ADDRESS_P2
		u8[A1 + 0x05] = base_state.NORMAL
		u8[A1 + 0x2a] |= char.flag.IN_AIR
		u8[A1 + 0x2a] &= ~char.flag.ON_OBJECT
	}

	fn020088()
}

//----------------
// Dwayne the Rock
//----------------

//# address-hook(0x2042f0)
function void ExtraChar.AmyObjects()
{
	if (objA0.subtype2c == 0x04) // Dwayne the rock
	{		
		if (objA0.render_flags & render_flag.VISIBLE)
		{
			u16[A0 + 0x38] = score.bonus_counter
			u8[A0 + 0x32] = u8[0xffffb000 + 0x20]
			u8[A0 + 0x33] = u8[0xffffb04a + 0x20]
			objA0.value3a = u8[0xffffb000 + 0x2a]
			objA0.value3b = u8[0xffffb04a + 0x2a]
		
			u16 width = 0x1c
			u16 height = 0x08
			A1 = 0xffffb000
			D1.u16 = width
			D2.u16 = height - 1
			D3.u16 = height
			D4.u16 = objA0.position.x.u16

			u8 shouldBreak = SDMD.breakCheck()
			
			if (shouldBreak & 3)
				sdmd.ignore_ground = true
				
			if (shouldBreak & 12)
				sdmd.ignore_ground_p2 = true

			fn01dc56() 							// Collision check was moved into this method!

			sdmd.ignore_ground = false
			sdmd.ignore_ground_p2 = false

			if (SDMD.destroyObjectExternally())
			{
				SDMD.dropPlayers()
				
				ExtraChar.DwayneRockBreak()
				return
			}
			
			u8 collisionFlags = objA0.flags2a & (object.flag.P1_ON_OBJECT | object.flag.P2_ON_OBJECT)
			if (SDMD.willItBreak(collisionFlags, shouldBreak))
			{
				ExtraChar.DwayneRockBreak()
				return
			}
		}
		
		if (global.zone_act == 0x0000)
			DrawObject()
		else
			DrawOrUnloadObject()
	}
	else
		base.ExtraChar.AmyObjects()
}

function void ExtraChar.DwayneRockBreak()
{
	base.ExtraChar.DwayneRockBreak()
}

//-----------
// MGZ Spiker
//-----------


//# address-hook(0x088c38) end(0x088c6c)
function void fn088c38()
{
	System.writeDisplayLine(stringformat("0x%02x, 0x%02x", u8[0xffffb000 + 0x40]))
	
	Object.AnimationProgress.DistinctTimer(0x088e4a)
	if (D2.u16 != 0 && objA0.animation.frame == 4)
	{
		A1 = 0xffff0000 + u16[A0 + 0x44]
		u8[A1 + 0x05] = base_state.NORMAL
		objA1.velocity.y = -0x600
		objA1.flags2a |= char.flag.IN_AIR
		u8[A1 + 0x2a] &= ~char.flag.ON_OBJECT

		if (u8[A1 + 0x40] == 1)
			balloonjump |= (A1 == char.ADDRESS_P2) ? 2 : 1				// This flag forces vertical velocity
	}
}

//# address-hook(0x088da6) end(0x088dcc)
function void fn088da6()
{
	u8[A1 + 0x05] = base_state.NORMAL
	objA1.position.y.u16 += 6
	objA1.velocity.y = 0
	objA1.flags2a |= char.flag.IN_AIR
	objA1.flags2a &= ~char.flag.CONTROL_LOCK

	playSound(SFX_SPRING)
}

//-------------
// CNZ Balloons
//-------------

//# address-hook(0x0317ae) end(0x03181c)
function void fn0317ae()
{
	
	// This is not handled via the specific mods, adding here for consistency
	if (!SDMD.canSmash(A1))
		objA1.velocity.y = -0x700
	objA1.flags2a |= char.flag.IN_AIR
	objA1.flags2a &= ~(char.flag.CONTROL_LOCK | char.flag.PUSHING)


	u8[A1 + 0x2e] = 0
	if (u8[A1 + 0x40] == 1)
		balloonjump |= (A1 == char.ADDRESS_P2) ? 2 : 1				// This flag forces vertical velocity

	objA0.state |= 0x01
	if (s8[A0 + 0x2c] < 0)
	{
		// This is not handled via the specific mods, adding here for consistency
		if (!SDMD.canSmash(A1))
			objA1.velocity.y = -0x380
		
		if (level.water_present != 0 && u8[A0 + 0x34] == 0)
		{
			A2 = 0x03185a
			fn03181e()
			fn03181e()
			fn03181e()
			fn03181e()
			objA1.position.x.u16 = objA0.position.x.u16
			objA1.position.y.u16 = objA0.position.y.u16
		}
	}

	if (u8[A0 + 0x34] == 0)
	{
		playSound(0x77)
		u8[A0 + 0x34] = 0x01
	}
}

//------------
// CNZ Bumpers
//------------

//# address-hook(0x032f56) end(0x032fee)
function void fn032f56()
{
	D1.u16 = objA0.position.x.u16 - objA1.position.x.u16
	D2.u16 = objA0.position.y.u16 - objA1.position.y.u16
	LookupAngleByVector()

	D1.u16 = u8[0xfffffe04] & 0x03
	D0.u16 += D1.u16
	LookupSinCos()

	D1.s32 = s32(D1.s16) * -0x700
	D1.s32 >>= 8
	objA1.velocity.x = D1.u16

	D0.s32 = s32(D0.s16) * -0x700
	D0.s32 >>= 8
	objA1.velocity.y = D0.u16

	objA1.flags2a |= char.flag.IN_AIR
	objA1.flags2a &= ~(char.flag.CONTROL_LOCK | char.flag.PUSHING)
	
	if (u8[A1 + 0x40] == 1)
		balloonjump |= (A1 == char.ADDRESS_P2) ? 2 : 1				// This flag forces vertical velocity
	
	objA0.state = 0x01

	playSound(0xaa)

	D0.u16 = objA0.respawn_entry
	if (D0.u16 != 0)
	{
		A2 = 0xffff0000 + D0.u16
		if (u8[A2] >= 0x8a)
			return

		++u8[A2]
	}

	A3 = 0xffff0000 + A1.u16
	addScore(1)

	if (allocDynamicObjectStd())
	{
		// Spawn floating points display
		objA1.update_address = addressof(FloatingPoints.Init)
		objA1.position.x.u16 = objA0.position.x.u16
		objA1.position.y.u16 = objA0.position.y.u16
		objA1.animation.sprite = 0x04
	}
}

//------------------
// CNZ Helper Method
//------------------

// Force vertical velocity
function void Character.updateJumpMoves()
{
	bool glideBackup = knuckles.glideclimbstate
	
	s16 balloon_vel = char.velocity.y
	if (balloon_vel >= 0)
		balloonjump &= ~((A0 == char.ADDRESS_P2) ? 2 : 1)
	
	if ((A0 == char.ADDRESS_P1 && !(balloonjump & 1)) || (A0 == char.ADDRESS_P2 && !(balloonjump & 2)))
	{
		base.Character.updateJumpMoves()
		return
	}

	char.velocity.y = 0 											// Velocity was set to 0 here otherwise secondary jump actions would not work.
	//u8 backupjumpstate = char.double_jump_state 
	base.Character.updateJumpMoves()
	
	if (u8[A0 + 0x38] == CHARACTER_KNUCKLES) && glideBackup != knuckles.glideclimbstate
	{
		balloonjump &= ~((A0 == char.ADDRESS_P2) ? 2 : 1)
		return
	}
	
	if (!SDMD.canSmash(A0))
		char.velocity.y = balloon_vel
}

//-----------
// OPG Compat
//-----------

// part 2
function void P2Balloons()
{
    objA1.velocity.y = -0x700
	objA1.flags2a |= char.flag.IN_AIR
	objA1.flags2a &= ~(char.flag.CONTROL_LOCK | char.flag.PUSHING)


	u8[A1 + 0x2e] = 0
	if (u8[A1 + 0x40] == 1)
		balloonjump |= (A1 == char.ADDRESS_P2) ? 2 : 1				// This flag forces vertical velocity
		
	if (s8[A0 + 0x2c] < 0)
	{
		objA1.velocity.y = -0x380
	}

    if (!objA0.value3a) // Only play the sound once when bouncing off the balloon
    {
        playSound(0x7b)
        ++objA0.value3a
    }
}

//--------------
// ICZ Ice Block
//--------------

// Remove collision check from here for ESU support.
//# address-hook(0x08b384) end(0x08b3a4)
function void fn08b384()
{
	objA0.value3a = u8[char.ADDRESS_P1 + 0x20]
	objA0.value3b = u8[char.ADDRESS_P2 + 0x20]

	D1 = 0x23
	D2 = 0x10
	D3 = 0x10
	D4.u16 = objA0.position.x.u16

	fn08b3aa()
	DrawOrUnloadObject()
}

//# address-hook(0x08b3aa) end(0x08b430)
function void fn08b3aa()
{
	u8 shouldBreak = SDMD.breakCheck()
	
	if (shouldBreak & 3)
		sdmd.ignore_ground = true
		
	if (shouldBreak & 12)
		sdmd.ignore_ground_p2 = true

	fn01dc56() 							// Collision check was moved into this method!

	sdmd.ignore_ground = false
	sdmd.ignore_ground_p2 = false

	if (SDMD.destroyObjectExternally())
	{
		SDMD.dropPlayers()
		
		SDMD.breakIce()
	}
	
	u8 collisionFlags = objA0.flags2a & (object.flag.P1_ON_OBJECT | object.flag.P2_ON_OBJECT)
	if (SDMD.willItBreak(collisionFlags, shouldBreak))
	{
		SDMD.breakIce()
	}
}

function void SDMD.breakIce()
{
	// Spawn broken ice block chunks
	// "spawnChildObjects(0x08b480)" replaced by:
	spawnChildObject(0x08b432, 0x00, 0, -8)
	spawnChildObject(0x08b432, 0x02, 0, 8)
	spawnChildObject(0x08b432, 0x04, -16, -8)
	spawnChildObject(0x08b432, 0x06, 16, -8)
	spawnChildObject(0x08b432, 0x08, -16, 8)
	spawnChildObject(0x08b432, 0x0a, 16, 8)
	spawnChildObject(0x08b432, 0x0c, 0, 0)
	spawnChildObject(0x08b432, 0x0e, 0, 0)
	spawnChildObject(0x08b432, 0x10, 0, 0)
	spawnChildObject(0x08b432, 0x12, 0, 0)
	spawnChildObject(0x08b432, 0x14, 0, 0)
	spawnChildObject(0x08b432, 0x16, 0, 0)

	playSound(0x6e)
	Object.TriggerUnloading()
}

