//# address-hook(0x04172e) end(0x0417a4)
function void fn04172e()
{	
	u8[A0 + 0x30] = u8[char.ADDRESS_P1 + 0x20]
	u8[A0 + 0x31] = u8[char.ADDRESS_P2 + 0x20]
	
	D1.u16 = 0x23
	D2.u16 = 0x10
	D3.u16 = 0x11
	D4.u16 = objA0.position.x.u16
	
	u8 shouldBreak = SDMD.breakCheck()
	
	if (shouldBreak & 3)
		sdmd.ignore_ground = true
		
	if (shouldBreak & 12)
		sdmd.ignore_ground_p2 = true

	fn01dc56() 							// Collision check was moved into this method!

	sdmd.ignore_ground = false
	sdmd.ignore_ground_p2 = false

	if (SDMD.destroyObjectExternally())
	{
		SDMD.dropPlayers()
		
		fn0417f6()
		return
	}
	
	u8 collisionFlags = objA0.flags2a & (object.flag.P1_ON_OBJECT | object.flag.P2_ON_OBJECT)
	if (SDMD.willItBreak(collisionFlags, shouldBreak))
	{
		fn0417f6()
		return
	}

	DrawOrUnloadObject()
}


//-----------------
// DEZ2 Boss Bumper
//-----------------

//# address-hook(0x07fa7e) end(0x07faca)
function void fn07fa7e()
{
	fn085870()
	if (!_equal())
	{
		D0.u8 = u8[A0 + 0x3c]
		D1.s8 = (global.framecounter.low & 0x03) - 2
		D0.u16 += D1.s8
		LookupSinCos()
		D0.u16 <<= 3
		D1.u16 <<= 3
		objA1.velocity.x = D0.u16
		objA1.velocity.y = D1.u16
		objA1.flags2a |= char.flag.IN_AIR
		objA1.flags2a &= ~(char.flag.CONTROL_LOCK | char.flag.PUSHING)

		if (u8[A1 + 0x40] == 1)
			balloonjump |= (A1 == char.ADDRESS_P2) ? 2 : 1				// This flag forces vertical velocity

		objA0.state = 0x01
		playSound(0xaa)
	}
}

//---------------------------
// Super then Hyper Compat...
//---------------------------

// I had to add this function because this mod also forced
// the velocity limit for some reason where it did not need to.

function void SuperThenHyperfunc()
{
	u8 input_state     = (char.character == CHARACTER_TAILS) ? control.tails.state   : control.player1.state
	u8 input_pressed   = (char.character == CHARACTER_TAILS) ? control.tails.pressed : control.player1.pressed
	bool isSuperActive = (char.character == CHARACTER_TAILS) ? super.active.tails    : super.active

	if (char.jumping)
	{
		if (char.double_jump_state == 0)
		{
			#if STANDALONE
				if (Input.buttonPressed(BUTTON_Y) && !System.getGlobalVariableValueByName("original_mode"))
				{
					if ((super.active == 0xff || super.active.tails == 0xff) == 0 && char.invuln.countdown == 0)	// Check invulnerability to prevent spamming of super activate + cancel
					{
						if (global.chaos_emeralds >= 7 && global.traded_emeralds == 0 && (super.active == 1 || super.active.tails == 1))
						{
							char.jumping = 0
							return
						}
						if (Character.performSuperTransformation())
						{
							char.jumping = 0
							return
						}
					}
				}
			#endif
		}
	}
}