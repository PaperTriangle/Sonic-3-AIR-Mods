global bool dsmg.extra_frames
global u8 dsmg.frame

define u8 global.xtrachar	= u8[0xffffe654]

// This function is here only for script mods that want to change or extend the character sprites
function u64 Standalone.getModdedAnimationSpriteKey(u8 character, u16 animationSpriteEx)
{
	if dsmg.extra_frames && (character == CHARACTER_KNUCKLES) && (global.xtrachar == 0)
	{
		u64 key = base.Standalone.getModdedAnimationSpriteKey(character, animationSpriteEx)
		bool glidin = char.animation.sprite == 0xc0
		bool fallin = char.animation.sprite == 0x8c

		if (glidin && dsmg.frame > 15) || (fallin && dsmg.frame > 19)
			dsmg.frame = 0
		
		if (glidin && dsmg.frame > 7)
			key = DSMG.GlideFrame()
		else if (fallin && dsmg.frame > 9)
			key = DSMG.FallingPanicFrame()
		
		return key
	}
	
	return base.Standalone.getModdedAnimationSpriteKey(character, animationSpriteEx)
}

// Adjust the moded frame counter.
function void DSMG.FrameCount(u32 AX)
{
	bool glidin = u8[AX + 0x22] == 0xc0
	bool fallin = u8[AX + 0x22] == 0x8c
	
	if (glidin || fallin)
		dsmg.frame++
	else
		dsmg.frame = 0
}

// Increase modded animation frame counter here.
//# address-hook(0x017d30) end(0x017ef0)
function void UpdateKnucklesAnimation()
{
	if dsmg.extra_frames && (A0 == 0xffffb000)
		DSMG.FrameCount(A0)
	
	base.UpdateKnucklesAnimation()
}

// Remove the programmed LBZ2 falling animation.
//# address-hook(0x074952) end(0x0749a8)
function void fn074952()
{
	if !dsmg.extra_frames
	{
		base.fn074952()
		return
	}
	MoveWithGravity20()
	A1 = 0xffffb000
	objA1.position.x.u16 = objA0.position.x.u16
	objA1.position.y.u16 = objA0.position.y.u16

	char.state = char.state.FALLING_PANIC
	dsmg.frame++

	UpdatePlayer1SpritePatterns()

	if (u16[0xffffb000 + 0x14] < level.bossarea.top + 0x0200 + (getScreenHeight() - 224))
		return

	TriggerNextZone(0x0700)		// Mushroom Hill Zone
	UnloadObject()
}

// Reset the counter in HPZ fight.
//# address-hook(0x0640dc) end(0x064100)
function void fn0640dc()
{
	if dsmg.extra_frames
		dsmg.frame = 0
	
	base.fn0640dc()
}

// Move the framecounter in HPZ fight.
//# address-hook(0x064090) end(0x0640c8)
function void fn064090()
{
	if dsmg.extra_frames
		DSMG.FrameCount(A0)

	base.fn064090()
}

// Render the extra glide frame for boss Knuckles.
function bool Standalone.onWriteToSpriteTable(s16 px, s16 py, u16 renderQueue)
{
	if dsmg.extra_frames && (objA0.update_address == 0x063de0) && objA0.animation.sprite == 0xc0
	{
		if (dsmg.frame > 15)
			dsmg.frame = 0
		
		if (dsmg.frame > 7)
		{
			Renderer.drawCustomSprite(DSMG.GlideFrame(), px, py, 0x80, (objA0.render_flags & render_flag.FLIP_X) | SPRITE_FLAG_PRIO, renderQueue)
			return true
		}
	}
	
	return base.Standalone.onWriteToSpriteTable(px, py, renderQueue)
}

// Reset counter in SSZ cutscene.
//# address-hook(0x07cc3a) end(0x07cc62)
function void fn07cc3a()
{
	if dsmg.extra_frames
		dsmg.frame = 0
	
	base.fn07cc3a()
}

// Move the framecounter in SSZ cutscene.
//# address-hook(0x07cc68) end(0x07ccaa)
function void fn07cc68()
{
	base.fn07cc68()
	
	if dsmg.extra_frames
		DSMG.FrameCount(A1)
}

// Function for Gliding frame, can be used to add extra modded logic.
function u64 DSMG.GlideFrame()
{
	return stringformat("knuckles_glide_extra_frame_%d", (Mods.isModActive("Slightly Better Knuckles") || Mods.isModActive("Slightly Better Knuckles [Original Palette]")) ? 1 : 0)
}

// Function for Falling Panic frame, can be used to add extra modded logic.
function u64 DSMG.FallingPanicFrame()
{
	return stringformat("knuckles_panic_extra_frame_%d", (Mods.isModActive("Slightly Better Knuckles") || Mods.isModActive("Slightly Better Knuckles [Original Palette]")) ? 1 : 0)
}