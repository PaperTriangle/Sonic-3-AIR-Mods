function void fn0324c0()
{
#if STANDALONE
	if (debug_mode.state)
		return
#endif
	if (dsmg.slide_setting && dsmg.slide_setting && A1 == 0xffffb000)
	{
		u8 bit = (1 << D6.u8)

		D0.u8 = u8[A2]
		if (D0.u8 == 0)
		{
			if (objA0.flags2a & bit)
			{
				dsmg.knux_slide = 0
				dsmg.knux_fall = 0
				u8[0xffffb000 + 0x2f] = 0
				dsmg.backup_state = 0
			}
		}
	}
	
	base.fn0324c0()
}
			

