// Fix for MGZ Tar
//----------------

//# address-hook(0x032aae) end(0x032b8a)
function void fn032aae()
{
	if (dsmg.slide_setting && debug_mode.state == 0)
	{
		if ((objA0.flags2a & object.flag.P1_ON_OBJECT) != 0)
		{
			dsmg.knux_slide = 0
			dsmg.knux_fall = 0
			u8[0xffffb000 + 0x2f] = 0
			dsmg.backup_state = 0
			if (u8[0xffffb000 + 0x20] == char.state.KNUX_STANDUP2) // Remove horizontal lock
				u16[0xffffb000 + 0x32] = 0

		}
	}

	base.fn032aae()
}

