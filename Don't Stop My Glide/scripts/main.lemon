function void fn03fd4e()
{
	u8 bit = (1 << D6.u8)

	if (dsmg.slide_setting && A1 == 0xffffb000 && (objA0.flags2a & bit) != 0 && u8[0xffffb000 + 0x2f] != 3)
	{
		dsmg.knux_slide = 0
