// Fix for LBZ Cylinder	
//---------------------

//# address-hook(0x02c3e8) end(0x02c516)
function void fn02c3e8()
{
	u8 bit = (1 << D6.u8)

	if (A1 == 0xffffb000 && (objA0.flags2a & bit) != 0)
	{
		dsmg.knux_slide = 0
		dsmg.knux_fall = 0
		u8[0xffffb000 + 0x2f] = 0
	}
	
	base.fn02c3e8()
}
