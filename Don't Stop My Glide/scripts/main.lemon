//------------------------
// Fix for camera position
//------------------------

//# address-hook(0x01c11e) end(0x01c236)
function void UpdateCameraPositionY()
{
	u8 flags_backup = char.flags
	
	if (dsmg.knux_slide || dsmg.backup_state == 3)
	{
		char.flags |= char.flag.IN_AIR
	}
	
	base.UpdateCameraPositionY()
	
	if (dsmg.knux_slide || dsmg.backup_state == 3)
	{
		char.flags = flags_backup
	}
}