//# address-hook(0x03fe70) end(0x03ff7e)
function void fn03fe70()
{
	u8 bit = (1 << D6.u8)

	if (u8[A2] != 0)
	{
		--u8[A2]
		return
	}

	if (A1 == 0xffffb000 && (objA0.flags2a & bit) != 0)
	{
		dsmg.knux_slide = 0
		dsmg.knux_fall = 0
		u8[0xffffb000 + 0x2f] = 0
	}
	
	base.fn03fe70()
}

