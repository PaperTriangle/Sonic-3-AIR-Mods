function void fn029d6a()
{
	if ((objA1.flags2a & char.flag.ON_OBJECT) && (u8[0xffffb000 + 0x2e] != 0))
	{
		dsmg.knux_slide = 0
		dsmg.knux_fall = 0
	}
	
	base.fn029d6a()
}

